generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EventCollection {
  FESTAS_SHOWS
  TEATROS_ESPETACULOS
  STAND_UP_COMEDY
  ESPORTES
  PASSEIOS_TOURS
  CONGRESSOS
  INFANTIL
  GASTRONOMIA
}

enum EventOccupancyMode {
  GENERAL_ADMISSION
  RESERVED_SEATING
  RESERVED_TABLE
  MIXED
}

enum SeatMapObjectType {
  SEAT
  ACCESSIBLE_SEAT
  COMPANION_SEAT
  TABLE
  BOOTH
  COUNTER
  AREA
  STAGE
  SCREEN
  AISLE
  BLOCKED_SPACE
}

model Organizer {
  id        String  @id @default(uuid())
  tradeName String
  legalName String?
  document  String? @unique
  email     String?
  phone     String?
  status    String  @default("ACTIVE")

  slug         String? @unique
  bio          String?
  websiteUrl   String?
  instagramUrl String?
  facebookUrl  String?
  youtubeUrl   String?
  whatsapp     String?
  logoUrl      String?
  bannerUrl    String?
  city         String?
  state        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events         Event[]
  supportThreads SupportThread[]
}

model Event {
  id          String @id @default(uuid())
  organizerId String

  name        String
  description String?
  eventDate   DateTime
  capacity    Int
  status      String   @default("DRAFT")

  slug             String?          @unique
  shortDescription String?
  category         EventCollection?
  visibility       String           @default("PUBLIC")
  timezone         String           @default("America/Sao_Paulo")
  startDate        DateTime?
  endDate          DateTime?
  saleStartAt      DateTime?
  saleEndAt        DateTime?
  featured         Boolean          @default(false)
  highlightTag     String?
  checkoutTitle    String?
  checkoutSubtitle String?

  occupancyMode EventOccupancyMode @default(GENERAL_ADMISSION)
  multiSession  Boolean            @default(false)
  allowSeatMap  Boolean            @default(false)
  allowTableMap Boolean            @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizer      Organizer       @relation(fields: [organizerId], references: [id])
  ticketTypes    TicketType[]
  orders         Order[]
  supportThreads SupportThread[]

  content  EventContent?
  location EventLocation?
  media    EventMedia?
  policy   EventPolicy?

  sessions     EventSession[]
  sectors      VenueSector[]
  venueLayouts VenueLayout[]
  seatHolds    SeatHold[]
}

model EventContent {
  id      String @id @default(uuid())
  eventId String @unique

  headline             String?
  summary              String?
  fullDescription      String?
  attractions          String?
  schedule             String?
  sectorDetails        String?
  importantInfo        String?
  faq                  String?
  producerDescription  String?
  purchaseInstructions String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model EventLocation {
  id      String @id @default(uuid())
  eventId String @unique

  mode         String   @default("PRESENTIAL")
  venueName    String?
  addressLine1 String?
  addressLine2 String?
  neighborhood String?
  city         String?
  state        String?
  zipCode      String?
  reference    String?
  mapUrl       String?
  instructions String?
  latitude     Decimal? @db.Decimal(10, 7)
  longitude    Decimal? @db.Decimal(10, 7)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([city, state])
}

model EventMedia {
  id      String @id @default(uuid())
  eventId String @unique

  coverImageUrl     String?
  bannerImageUrl    String?
  thumbnailUrl      String?
  mobileBannerUrl   String?
  sectorMapImageUrl String?
  gallery           Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model EventPolicy {
  id      String @id @default(uuid())
  eventId String @unique

  ageRating       String?
  refundPolicy    String?
  halfEntryPolicy String?
  transferPolicy  String?
  termsNotes      String?
  entryRules      String?
  documentRules   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model EventSession {
  id      String @id @default(uuid())
  eventId String

  name         String
  description  String?
  startsAt     DateTime
  endsAt       DateTime?
  capacity     Int?
  status       String    @default("ACTIVE")
  displayOrder Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketTypes TicketType[]
  orders      Order[]
  tickets     Ticket[]
  seatHolds   SeatHold[]

  @@index([eventId])
  @@index([startsAt])
  @@index([status])
  @@index([displayOrder])
}

model VenueSector {
  id      String @id @default(uuid())
  eventId String

  name          String
  description   String?
  type          String?
  occupancyMode EventOccupancyMode @default(GENERAL_ADMISSION)
  capacity      Int?
  displayOrder  Int                @default(0)
  color         String?
  gateName      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event       Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketTypes TicketType[]
  mapObjects  SeatMapObject[]
  tickets     Ticket[]
  seatHolds   SeatHold[]

  @@index([eventId])
  @@index([occupancyMode])
  @@index([displayOrder])
}

model VenueLayout {
  id      String @id @default(uuid())
  eventId String

  name          String
  occupancyMode EventOccupancyMode @default(GENERAL_ADMISSION)
  width         Int?
  height        Int?
  mapData       Json?
  isDefault     Boolean            @default(false)
  status        String             @default("ACTIVE")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event      Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  mapObjects SeatMapObject[]

  @@index([eventId])
  @@index([occupancyMode])
  @@index([isDefault])
  @@index([status])
}

model SeatMapObject {
  id       String @id @default(uuid())
  layoutId String

  venueSectorId String?

  code     String
  label    String?
  type     SeatMapObjectType
  row      String?
  number   String?
  capacity Int               @default(1)

  x        Decimal? @db.Decimal(10, 2)
  y        Decimal? @db.Decimal(10, 2)
  width    Decimal? @db.Decimal(10, 2)
  height   Decimal? @db.Decimal(10, 2)
  rotation Decimal? @db.Decimal(10, 2)

  status   String @default("AVAILABLE")
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  layout      VenueLayout  @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  venueSector VenueSector? @relation(fields: [venueSectorId], references: [id], onDelete: SetNull)
  tickets     Ticket[]
  seatHolds   SeatHold[]

  @@unique([layoutId, code])
  @@index([layoutId])
  @@index([venueSectorId])
  @@index([type])
  @@index([status])
}

model SeatHold {
  id      String @id @default(uuid())
  eventId String

  eventSessionId  String?
  venueSectorId   String?
  seatMapObjectId String?
  ticketTypeId    String?
  userId          String?

  token     String
  quantity  Int      @default(1)
  status    String   @default("ACTIVE")
  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventSession  EventSession?  @relation(fields: [eventSessionId], references: [id], onDelete: Cascade)
  venueSector   VenueSector?   @relation(fields: [venueSectorId], references: [id], onDelete: SetNull)
  seatMapObject SeatMapObject? @relation(fields: [seatMapObjectId], references: [id], onDelete: SetNull)
  ticketType    TicketType?    @relation(fields: [ticketTypeId], references: [id], onDelete: SetNull)
  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@index([eventSessionId])
  @@index([venueSectorId])
  @@index([seatMapObjectId])
  @@index([ticketTypeId])
  @@index([userId])
  @@index([token])
  @@index([status])
  @@index([expiresAt])
}

model TicketType {
  id             String  @id @default(uuid())
  eventId        String
  eventSessionId String?
  venueSectorId  String?
  name           String
  description    String?
  price          Decimal @db.Decimal(10, 2)
  quantity       Int
  status         String  @default("ACTIVE")

  lotLabel           String?
  salesStartAt       DateTime?
  salesEndAt         DateTime?
  minPerOrder        Int                @default(1)
  maxPerOrder        Int?
  displayOrder       Int                @default(0)
  feeAmount          Decimal?           @db.Decimal(10, 2)
  feeDescription     String?
  benefitDescription String?
  isHidden           Boolean            @default(false)
  occupancyMode      EventOccupancyMode @default(GENERAL_ADMISSION)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event        Event         @relation(fields: [eventId], references: [id])
  eventSession EventSession? @relation(fields: [eventSessionId], references: [id], onDelete: SetNull)
  venueSector  VenueSector?  @relation(fields: [venueSectorId], references: [id], onDelete: SetNull)
  orderItems   OrderItem[]
  seatHolds    SeatHold[]

  @@index([eventId])
  @@index([eventSessionId])
  @@index([venueSectorId])
  @@index([status])
  @@index([displayOrder])
  @@index([occupancyMode])
}

model Order {
  id             String    @id @default(uuid())
  eventId        String
  eventSessionId String?
  customerUserId String?
  customerName   String
  customerEmail  String
  customerCpf    String?
  status         String    @default("PENDING")
  totalAmount    Decimal   @db.Decimal(10, 2)
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  event            Event                   @relation(fields: [eventId], references: [id])
  eventSession     EventSession?           @relation(fields: [eventSessionId], references: [id], onDelete: SetNull)
  customerUser     User?                   @relation("OrderCustomerUser", fields: [customerUserId], references: [id])
  items            OrderItem[]
  payments         Payment[]
  cancellations    TicketCancellation[]
  supportThreads   SupportThread[]
  transferRequests TicketTransferRequest[]

  @@index([eventId])
  @@index([eventSessionId])
  @@index([customerUserId])
  @@index([customerEmail])
  @@index([customerCpf])
  @@index([status])
  @@index([expiresAt])
}

model OrderItem {
  id           String   @id @default(uuid())
  orderId      String
  ticketTypeId String
  quantity     Int
  unitPrice    Decimal  @db.Decimal(10, 2)
  totalPrice   Decimal  @db.Decimal(10, 2)
  createdAt    DateTime @default(now())

  order      Order      @relation(fields: [orderId], references: [id])
  ticketType TicketType @relation(fields: [ticketTypeId], references: [id])
  tickets    Ticket[]

  @@index([orderId])
  @@index([ticketTypeId])
}

model Ticket {
  id                           String    @id @default(uuid())
  orderItemId                  String
  eventSessionId               String?
  venueSectorId                String?
  seatMapObjectId              String?
  currentOwnerUserId           String?
  receivedViaTransferRequestId String?
  receivedViaTransferLocked    Boolean   @default(false)
  code                         String    @unique
  status                       String    @default("AVAILABLE")
  holderName                   String?
  holderEmail                  String?
  holderCpf                    String?
  usedAt                       DateTime?
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  orderItem        OrderItem               @relation(fields: [orderItemId], references: [id])
  eventSession     EventSession?           @relation(fields: [eventSessionId], references: [id], onDelete: SetNull)
  venueSector      VenueSector?            @relation(fields: [venueSectorId], references: [id], onDelete: SetNull)
  seatMapObject    SeatMapObject?          @relation(fields: [seatMapObjectId], references: [id], onDelete: SetNull)
  currentOwnerUser User?                   @relation("TicketCurrentOwner", fields: [currentOwnerUserId], references: [id])
  checkins         Checkin[]
  cancellations    TicketCancellation[]
  transferRequests TicketTransferRequest[]

  @@index([orderItemId])
  @@index([eventSessionId])
  @@index([venueSectorId])
  @@index([seatMapObjectId])
  @@index([currentOwnerUserId])
  @@index([holderEmail])
  @@index([holderCpf])
  @@index([receivedViaTransferRequestId])
  @@index([receivedViaTransferLocked])
}

model TicketTransferRequest {
  id                        String  @id @default(uuid())
  ticketId                  String
  orderId                   String
  requestedByUserId         String
  fromUserId                String
  toUserId                  String
  mode                      String  @default("FORWARD")
  returnOfTransferRequestId String?

  requestedByName  String?
  requestedByEmail String?
  requestedByCpf   String?
  fromName         String?
  fromEmail        String?
  fromCpf          String?
  toName           String?
  toEmail          String?
  toCpf            String?

  status         String    @default("PENDING_PAYMENT")
  responseReason String?
  requestedAt    DateTime  @default(now())
  respondedAt    DateTime?
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  ticket          Ticket @relation(fields: [ticketId], references: [id])
  order           Order  @relation(fields: [orderId], references: [id])
  requestedByUser User   @relation("TicketTransferRequestedByUser", fields: [requestedByUserId], references: [id])
  fromUser        User   @relation("TicketTransferFromUser", fields: [fromUserId], references: [id])
  toUser          User   @relation("TicketTransferToUser", fields: [toUserId], references: [id])

  @@index([ticketId])
  @@index([orderId])
  @@index([requestedByUserId])
  @@index([fromUserId])
  @@index([toUserId])
  @@index([status])
  @@index([requestedAt])
  @@index([respondedAt])
  @@index([mode])
  @@index([returnOfTransferRequestId])
  @@index([expiresAt])
}

model Checkin {
  id           String   @id @default(uuid())
  ticketId     String
  checkedAt    DateTime @default(now())
  gate         String?
  operatorName String?
  createdAt    DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id])

  @@index([ticketId])
}

model Payment {
  id        String    @id @default(uuid())
  orderId   String
  amount    Decimal   @db.Decimal(10, 2)
  method    String
  status    String    @default("PENDING")
  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
}

model User {
  id              String    @id @default(uuid())
  name            String
  email           String    @unique
  passwordHash    String?
  cpf             String?
  cpfNormalized   String?   @unique
  googleId        String?   @unique
  avatarUrl       String?
  authProvider    String    @default("PASSWORD")
  role            String    @default("ADMIN")
  status          String    @default("ACTIVE")
  emailVerifiedAt DateTime?
  cpfVerifiedAt   DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  orders                   Order[]         @relation("OrderCustomerUser")
  ownedTickets             Ticket[]        @relation("TicketCurrentOwner")
  supportThreadsAsCustomer SupportThread[] @relation("SupportThreadCustomerUser")

  requestedTicketTransfers TicketTransferRequest[] @relation("TicketTransferRequestedByUser")
  outgoingTicketTransfers  TicketTransferRequest[] @relation("TicketTransferFromUser")
  incomingTicketTransfers  TicketTransferRequest[] @relation("TicketTransferToUser")

  walletTransactions  WalletTransaction[]
  ticketCancellations TicketCancellation[]
  seatHolds           SeatHold[]

  sentMessages    SupportMessage[] @relation("SupportMessageSender")
  assignedThreads SupportThread[]  @relation("SupportThreadAssignedUser")

  @@index([role])
  @@index([status])
  @@index([authProvider])
  @@index([cpf])
}

model WalletTransaction {
  id          String   @id @default(uuid())
  userId      String
  type        String
  source      String
  sourceId    String?
  amount      Decimal  @db.Decimal(10, 2)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([source])
}

model TicketCancellation {
  id             String   @id @default(uuid())
  ticketId       String
  orderId        String
  userId         String
  mode           String
  originalAmount Decimal  @db.Decimal(10, 2)
  returnedAmount Decimal  @db.Decimal(10, 2)
  status         String   @default("COMPLETED")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  ticket Ticket @relation(fields: [ticketId], references: [id])
  order  Order  @relation(fields: [orderId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([ticketId])
  @@index([orderId])
  @@index([userId])
}

model SupportThread {
  id             String   @id @default(uuid())
  organizerId    String
  eventId        String
  orderId        String?
  customerUserId String?
  customerEmail  String
  customerName   String?
  customerCpf    String?
  subject        String
  status         String   @default("OPEN")
  lastMessageAt  DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  assignedUserId String?

  organizer    Organizer        @relation(fields: [organizerId], references: [id])
  event        Event            @relation(fields: [eventId], references: [id])
  order        Order?           @relation(fields: [orderId], references: [id])
  customerUser User?            @relation("SupportThreadCustomerUser", fields: [customerUserId], references: [id])
  assignedUser User?            @relation("SupportThreadAssignedUser", fields: [assignedUserId], references: [id])
  messages     SupportMessage[]

  @@index([organizerId])
  @@index([eventId])
  @@index([orderId])
  @@index([customerUserId])
  @@index([customerEmail])
  @@index([customerCpf])
  @@index([status])
  @@index([lastMessageAt])
  @@index([assignedUserId])
}

model SupportMessage {
  id           String   @id @default(uuid())
  threadId     String
  senderUserId String?
  senderName   String?
  senderEmail  String?
  senderType   String
  message      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  thread     SupportThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderUser User?         @relation("SupportMessageSender", fields: [senderUserId], references: [id])

  @@index([threadId])
  @@index([senderUserId])
  @@index([senderType])
  @@index([createdAt])
}

model AdminAccessRequest {
  id       String @id @default(uuid())
  protocol String @unique

  requesterUserId String
  requesterRole   String?
  requesterName   String?
  requesterEmail  String?
  requesterCpf    String?

  fullName         String
  email            String
  cpfCnpj          String
  phone            String
  producerName     String
  producerDocument String
  city             String
  state            String
  websiteOrSocial  String
  eventTypes       String

  firstEventDescription String
  estimatedEventDate    DateTime
  expectedAudience      String
  experience            String
  reason                String
  extraNotes            String?

  acceptedReviewTerm Boolean @default(false)
  acceptedTruthTerm  Boolean @default(false)

  status                     String   @default("PENDING_REVIEW")
  reviewDeadlineBusinessDays Int      @default(15)
  submittedAt                DateTime @default(now())

  moderatorUserId String?
  moderatorName   String?
  moderatorEmail  String?
  moderatorNote   String?
  reviewedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requesterUserId])
  @@index([requesterEmail])
  @@index([status])
  @@index([submittedAt])
  @@index([reviewedAt])
}

model PromotionBoostRequest {
  id       String @id @default(uuid())
  protocol String @unique

  requesterUserId String
  requesterRole   String?
  requesterName   String?
  requesterEmail  String?
  requesterCpf    String?

  eventId    String?
  eventTitle String
  eventDate  DateTime

  placement            String
  placementLabel       String
  placementDescription String?
  periodDays           Int
  unitPriceCents       Int
  cycles               Int
  totalAmountCents     Int

  startsAt DateTime
  endsAt   DateTime

  paymentStatus    String  @default("DECLARED_PAID")
  paymentMethod    String?
  paymentReference String?
  paymentProofText String?
  notes            String?

  status      String   @default("PAID_PENDING_REVIEW")
  submittedAt DateTime @default(now())

  moderatorUserId String?
  moderatorName   String?
  moderatorEmail  String?
  moderatorNote   String?
  reviewedAt      DateTime?
  approvedAt      DateTime?
  rejectedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requesterUserId])
  @@index([requesterEmail])
  @@index([status])
  @@index([placement])
  @@index([startsAt])
  @@index([endsAt])
}

model AdminSupportTicket {
  id       String @id @default(uuid())
  protocol String @unique

  requesterUserId String
  requesterRole   String?
  requesterName   String?
  requesterEmail  String?
  requesterCpf    String?

  eventId    String?
  eventTitle String

  subject  String
  message  String
  priority String @default("NORMAL")
  category String @default("EVENT_SUPPORT")
  status   String @default("OPEN")

  replyText       String?
  repliedAt       DateTime?
  moderatorUserId String?
  moderatorName   String?
  moderatorEmail  String?

  submittedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([requesterUserId])
  @@index([requesterEmail])
  @@index([eventId])
  @@index([status])
}

model OperatorAssignment {
  id       String @id @default(uuid())
  protocol String @unique

  adminUserId String
  adminName   String?
  adminEmail  String?

  operatorUserId        String
  operatorName          String?
  operatorEmail         String?
  operatorCpf           String?
  operatorCpfNormalized String?

  eventId    String?
  eventTitle String?
  eventDate  DateTime?

  status            String   @default("INVITED")
  invitationMessage String?
  permissions       Json?
  notes             String?
  invitedAt         DateTime @default(now())
  acceptedAt        DateTime?
  declinedAt        DateTime?
  assignedAt        DateTime?
  activatedAt       DateTime?
  revokedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([adminUserId])
  @@index([operatorUserId])
  @@index([operatorCpfNormalized])
  @@index([eventId])
  @@index([status])
  @@index([invitedAt])
  @@index([acceptedAt])
  @@index([assignedAt])
}
