import {
  BadRequestException,
  ForbiddenException,
  Injectable,
  NotFoundException,
} from '@nestjs/common';
import { PrismaService } from '../prisma/prisma.service';
import { CreateOperatorAssignmentDto } from './dto/create-operator-assignment.dto';

type AuthenticatedUser = {
  sub: string;
  email: string;
  role: string;
  name?: string;
  cpf?: string;
};

function clean(value: unknown) {
  if (value === null || value === undefined) return '';

  return String(value).trim();
}

function normalizeCpf(value: unknown) {
  return clean(value).replace(/\D/g, '');
}

function makeProtocol() {
  const now = new Date();
  const datePart = [
    now.getFullYear(),
    String(now.getMonth() + 1).padStart(2, '0'),
    String(now.getDate()).padStart(2, '0'),
  ].join('');

  const randomPart = Math.random().toString(36).slice(2, 8).toUpperCase();

  return `ASTRO-OP-${datePart}-${randomPart}`;
}

function isSuperAdmin(user: AuthenticatedUser) {
  return clean(user.role).toUpperCase() === 'SUPER_ADMIN';
}

function assertAdmin(user: AuthenticatedUser) {
  const role = clean(user.role).toUpperCase();

  if (!['ADMIN', 'SUPER_ADMIN'].includes(role)) {
    throw new ForbiddenException('Apenas administradores podem gerenciar operadores');
  }
}

function asNumber(value: unknown) {
  if (value === null || value === undefined) return 0;

  const parsed = Number(value);

  return Number.isFinite(parsed) ? parsed : 0;
}

@Injectable()
export class OperatorAssignmentsService {
  constructor(private readonly prisma: PrismaService) {}

  async invite(user: AuthenticatedUser, body: CreateOperatorAssignmentDto) {
    assertAdmin(user);

    const cpfNormalized = normalizeCpf(body.cpf);
    const eventId = clean(body.eventId);

    if (!cpfNormalized || cpfNormalized.length < 11) {
      throw new BadRequestException('Informe um CPF válido para convidar o operador');
    }

    if (!eventId) {
      throw new BadRequestException('Selecione o evento para atribuir o operador');
    }

    const targetUser = await this.prisma.user.findFirst({
      where: {
        OR: [
          {
            cpfNormalized,
          },
          {
            cpf: cpfNormalized,
          },
          {
            cpf: clean(body.cpf),
          },
        ],
      },
    });

    if (!targetUser) {
      throw new NotFoundException('Nenhuma conta encontrada com este CPF');
    }

    const targetRole = clean(targetUser.role).toUpperCase();

    if (['ADMIN', 'SUPER_ADMIN'].includes(targetRole)) {
      throw new BadRequestException('Esta conta já é administrativa e não deve virar operador');
    }

    const event = await this.prisma.event.findUnique({
      where: {
        id: eventId,
      },
      include: {
        organizer: true,
      },
    });

    if (!event) {
      throw new NotFoundException('Evento não encontrado');
    }

    const alreadyAssigned = await this.prisma.operatorAssignment.findFirst({
      where: {
        eventId,
        operatorUserId: targetUser.id,
        status: {
          in: ['INVITED', 'ACTIVE'],
        },
      },
    });

    const permissions = {
      canValidateTickets: body.canValidateTickets !== false,
      canAnswerSupport: body.canAnswerSupport !== false,
    };

    if (alreadyAssigned) {
      const updated = await this.prisma.operatorAssignment.update({
        where: {
          id: alreadyAssigned.id,
        },
        data: {
          status: 'ACTIVE',
          notes: clean(body.notes) || alreadyAssigned.notes,
          permissions,
          activatedAt: alreadyAssigned.activatedAt || new Date(),
        },
      });

      if (targetRole !== 'OPERATOR') {
        await this.prisma.user.update({
          where: {
            id: targetUser.id,
          },
          data: {
            role: 'OPERATOR',
          },
        });
      }

      return this.enrichAssignment(updated);
    }

    if (targetRole !== 'OPERATOR') {
      await this.prisma.user.update({
        where: {
          id: targetUser.id,
        },
        data: {
          role: 'OPERATOR',
        },
      });
    }

    const assignment = await this.prisma.operatorAssignment.create({
      data: {
        protocol: makeProtocol(),
        adminUserId: user.sub,
        adminName: clean(user.name) || 'Administrador',
        adminEmail: clean(user.email),
        operatorUserId: targetUser.id,
        operatorName: clean(targetUser.name),
        operatorEmail: clean(targetUser.email),
        operatorCpf: clean(targetUser.cpf) || cpfNormalized,
        operatorCpfNormalized: cpfNormalized,
        eventId: event.id,
        eventTitle: event.name,
        eventDate: event.eventDate,
        status: 'ACTIVE',
        notes: clean(body.notes) || null,
        permissions,
        invitedAt: new Date(),
        activatedAt: new Date(),
      },
    });

    return this.enrichAssignment(assignment);
  }

  async list(user: AuthenticatedUser) {
    assertAdmin(user);

    const assignments = await this.prisma.operatorAssignment.findMany({
      where: isSuperAdmin(user)
        ? {}
        : {
            adminUserId: user.sub,
          },
      orderBy: [
        {
          updatedAt: 'desc',
        },
        {
          invitedAt: 'desc',
        },
      ],
    });

    return Promise.all(assignments.map((assignment) => this.enrichAssignment(assignment)));
  }

  async report(id: string, user: AuthenticatedUser) {
    assertAdmin(user);

    const assignment = await this.prisma.operatorAssignment.findUnique({
      where: {
        id,
      },
    });

    if (!assignment) {
      throw new NotFoundException('Operador atribuído não encontrado');
    }

    if (!isSuperAdmin(user) && assignment.adminUserId !== user.sub) {
      throw new ForbiddenException('Você não pode ver o relatório deste operador');
    }

    const operator = await this.prisma.user.findUnique({
      where: {
        id: assignment.operatorUserId,
      },
    });

    const event = await this.prisma.event.findUnique({
      where: {
        id: assignment.eventId,
      },
      include: {
        organizer: true,
      },
    });

    const operatorName = clean(operator?.name) || clean(assignment.operatorName);

    const [ticketsTotal, ticketsUsed, checkins, supportThreads, paidOrders] =
      await Promise.all([
        this.prisma.ticket.count({
          where: {
            orderItem: {
              order: {
                eventId: assignment.eventId,
              },
            },
          },
        }),
        this.prisma.ticket.count({
          where: {
            orderItem: {
              order: {
                eventId: assignment.eventId,
              },
            },
            OR: [
              {
                usedAt: {
                  not: null,
                },
              },
              {
                status: {
                  in: ['USED', 'CHECKED_IN'],
                },
              },
            ],
          },
        }),
        this.prisma.checkin.findMany({
          where: {
            ticket: {
              orderItem: {
                order: {
                  eventId: assignment.eventId,
                },
              },
            },
            ...(operatorName
              ? {
                  operatorName: {
                    contains: operatorName,
                    mode: 'insensitive',
                  },
                }
              : {}),
          },
          orderBy: {
            checkedAt: 'desc',
          },
          include: {
            ticket: {
              include: {
                orderItem: {
                  include: {
                    order: true,
                    ticketType: true,
                  },
                },
              },
            },
          },
        }),
        this.prisma.supportThread.findMany({
          where: {
            eventId: assignment.eventId,
            assignedUserId: assignment.operatorUserId,
          },
          include: {
            messages: true,
          },
          orderBy: {
            updatedAt: 'desc',
          },
        }),
        this.prisma.order.aggregate({
          where: {
            eventId: assignment.eventId,
            status: 'PAID',
          },
          _count: {
            _all: true,
          },
          _sum: {
            totalAmount: true,
          },
        }),
      ]);

    const closedSupportThreads = supportThreads.filter((thread) =>
      ['ANSWERED', 'RESOLVED', 'CLOSED'].includes(clean(thread.status).toUpperCase()),
    );

    const supportMessages = supportThreads.reduce(
      (total, thread) => total + thread.messages.length,
      0,
    );

    const eventDate = assignment.eventDate || event?.eventDate || null;
    const eventHasPassed = eventDate ? new Date(eventDate).getTime() < Date.now() : false;

    return {
      assignment: await this.enrichAssignment(assignment),
      event: event
        ? {
            id: event.id,
            title: event.name,
            date: event.eventDate,
            status: event.status,
            organizerName: event.organizer?.tradeName || null,
          }
        : null,
      operator: operator
        ? {
            id: operator.id,
            name: operator.name,
            email: operator.email,
            cpf: operator.cpf,
            role: operator.role,
          }
        : {
            id: assignment.operatorUserId,
            name: assignment.operatorName,
            email: assignment.operatorEmail,
            cpf: assignment.operatorCpf,
            role: 'OPERATOR',
          },
      eventHasPassed,
      summary: {
        ticketsTotal,
        ticketsUsed,
        operatorCheckins: checkins.length,
        supportThreads: supportThreads.length,
        supportThreadsClosed: closedSupportThreads.length,
        supportMessages,
        paidOrders: paidOrders._count._all,
        paidRevenue: asNumber(paidOrders._sum.totalAmount),
      },
      checkins: checkins.slice(0, 100).map((checkin) => ({
        id: checkin.id,
        checkedAt: checkin.checkedAt,
        gate: checkin.gate,
        operatorName: checkin.operatorName,
        ticketCode: checkin.ticket.code,
        ticketStatus: checkin.ticket.status,
        holderName: checkin.ticket.holderName,
        holderCpf: checkin.ticket.holderCpf,
        orderId: checkin.ticket.orderItem.orderId,
        ticketTypeName: checkin.ticket.orderItem.ticketType.name,
      })),
      supportThreads: supportThreads.map((thread) => ({
        id: thread.id,
        subject: thread.subject,
        status: thread.status,
        customerName: thread.customerName,
        customerEmail: thread.customerEmail,
        customerCpf: thread.customerCpf,
        messagesCount: thread.messages.length,
        createdAt: thread.createdAt,
        updatedAt: thread.updatedAt,
        lastMessageAt: thread.lastMessageAt,
      })),
    };
  }

  private async enrichAssignment(assignment: any) {
    const [operator, event] = await Promise.all([
      this.prisma.user.findUnique({
        where: {
          id: assignment.operatorUserId,
        },
        select: {
          id: true,
          name: true,
          email: true,
          cpf: true,
          role: true,
          status: true,
        },
      }),
      this.prisma.event.findUnique({
        where: {
          id: assignment.eventId,
        },
        select: {
          id: true,
          name: true,
          eventDate: true,
          status: true,
        },
      }),
    ]);

    return {
      ...assignment,
      operator,
      event,
    };
  }
}
