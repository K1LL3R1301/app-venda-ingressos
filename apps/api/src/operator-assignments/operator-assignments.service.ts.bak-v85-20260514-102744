import {
  BadRequestException,
  ForbiddenException,
  Injectable,
  NotFoundException,
} from '@nestjs/common';
import { PrismaService } from '../prisma/prisma.service';
import { AssignOperatorToEventDto } from './dto/assign-operator-to-event.dto';
import { CreateOperatorInvitationDto } from './dto/create-operator-invitation.dto';
import { RespondOperatorWorkPlanDto } from './dto/respond-operator-work-plan.dto';

type AuthenticatedUser = {
  sub: string;
  email: string;
  role: string;
  name?: string;
  cpf?: string;
};

type WorkDate = {
  id: string;
  date: string;
  amount: number;
  functions: string;
  status: 'PENDING' | 'AVAILABLE' | 'UNAVAILABLE';
  available: boolean | null;
  responseNote?: string | null;
  respondedAt?: string | null;
};

function clean(value: unknown) {
  if (value === null || value === undefined) return '';

  return String(value).trim();
}

function normalizeCpf(value: unknown) {
  return clean(value).replace(/\D/g, '');
}

function parseMoney(value: unknown) {
  const raw = clean(value)
    .replace(/R\$/gi, '')
    .replace(/\s/g, '')
    .replace(/\./g, '')
    .replace(',', '.');

  const parsed = Number(raw);

  return Number.isFinite(parsed) && parsed >= 0 ? parsed : 0;
}

function makeProtocol() {
  const now = new Date();
  const datePart = [
    now.getFullYear(),
    String(now.getMonth() + 1).padStart(2, '0'),
    String(now.getDate()).padStart(2, '0'),
  ].join('');

  const randomPart = Math.random().toString(36).slice(2, 8).toUpperCase();

  return `ASTRO-OP-${datePart}-${randomPart}`;
}

function makeWorkDateId(index: number) {
  return `work-${Date.now()}-${index}-${Math.random().toString(36).slice(2, 7)}`;
}

function isSuperAdmin(user: AuthenticatedUser) {
  return clean(user.role).toUpperCase() === 'SUPER_ADMIN';
}

function assertAdmin(user: AuthenticatedUser) {
  const role = clean(user.role).toUpperCase();

  if (!['ADMIN', 'SUPER_ADMIN'].includes(role)) {
    throw new ForbiddenException('Apenas administradores podem gerenciar operadores');
  }
}

function normalizeWorkDates(value: unknown): WorkDate[] {
  if (!Array.isArray(value)) return [];

  return value.map((item: any, index) => {
    return {
      id: clean(item?.id) || makeWorkDateId(index),
      date: clean(item?.date),
      amount: parseMoney(item?.amount),
      functions: clean(item?.functions),
      status:
        item?.status === 'AVAILABLE' || item?.status === 'UNAVAILABLE'
          ? item.status
          : 'PENDING',
      available:
        typeof item?.available === 'boolean'
          ? item.available
          : item?.status === 'AVAILABLE'
            ? true
            : item?.status === 'UNAVAILABLE'
              ? false
              : null,
      responseNote: item?.responseNote ? clean(item.responseNote) : null,
      respondedAt: item?.respondedAt ? clean(item.respondedAt) : null,
    };
  });
}

function summarizeWorkDates(workDates: WorkDate[]) {
  const availableDates = workDates.filter((item) => item.available === true);
  const unavailableDates = workDates.filter((item) => item.available === false);
  const pendingDates = workDates.filter((item) => item.available === null);

  const proposedTotal = workDates.reduce((sum, item) => sum + item.amount, 0);
  const approvedTotal = availableDates.reduce((sum, item) => sum + item.amount, 0);

  return {
    proposedDays: workDates.length,
    availableDays: availableDates.length,
    unavailableDays: unavailableDates.length,
    pendingDays: pendingDates.length,
    proposedTotal,
    approvedTotal,
  };
}

@Injectable()
export class OperatorAssignmentsService {
  constructor(private readonly prisma: PrismaService) {}

  private async findUserByCpf(cpf: string) {
    const targetCpf = normalizeCpf(cpf);

    if (!targetCpf || targetCpf.length !== 11) {
      return null;
    }

    const users = await (this.prisma.user as any).findMany();

    return (
      users.find((user: any) => {
        return normalizeCpf(user?.cpf) === targetCpf || normalizeCpf(user?.cpfNormalized) === targetCpf;
      }) || null
    );
  }

  async invite(user: AuthenticatedUser, body: CreateOperatorInvitationDto) {
    assertAdmin(user);

    const cpfNormalized = normalizeCpf(body.cpf);

    if (!cpfNormalized || cpfNormalized.length !== 11) {
      throw new BadRequestException('Informe um CPF válido com 11 dígitos');
    }

    const targetUser = await this.findUserByCpf(cpfNormalized);

    if (!targetUser) {
      throw new NotFoundException(
        `Nenhuma conta encontrada com o CPF ${cpfNormalized}. Crie a conta primeiro ou confira o CPF digitado.`,
      );
    }

    const targetRole = clean(targetUser.role).toUpperCase();

    if (targetRole === 'SUPER_ADMIN') {
      throw new BadRequestException('Esta conta é SUPER ADMIN e não pode receber convite para virar operador.');
    }

    if (targetRole === 'ADMIN') {
      throw new BadRequestException('Esta conta já é ADMIN e não precisa virar operador.');
    }

    const existingForThisAdmin = await (this.prisma.operatorAssignment as any).findFirst({
      where: {
        adminUserId: user.sub,
        operatorUserId: targetUser.id,
        status: {
          in: ['INVITED', 'ACCEPTED', 'SCHEDULE_PENDING', 'ACTIVE'],
        },
      },
      orderBy: {
        createdAt: 'desc',
      },
    });

    if (existingForThisAdmin) {
      const message =
        targetRole === 'OPERATOR'
          ? 'Esta conta já é operador deste administrador. Nenhum novo convite foi enviado.'
          : 'Esta conta já possui convite ou vínculo com este administrador. Nenhum novo convite foi enviado.';

      throw new BadRequestException(message);
    }

    const existingAsOperatorElsewhere = await (this.prisma.operatorAssignment as any).findFirst({
      where: {
        operatorUserId: targetUser.id,
        status: {
          in: ['ACCEPTED', 'SCHEDULE_PENDING', 'ACTIVE'],
        },
        NOT: {
          adminUserId: user.sub,
        },
      },
      orderBy: {
        createdAt: 'desc',
      },
    });

    const messagePrefix =
      targetRole === 'OPERATOR' || existingAsOperatorElsewhere
        ? 'Você já é operador em outra equipe. Este é um novo convite para atuar também com este administrador.'
        : '';

    const finalMessage = [messagePrefix, clean(body.message)].filter(Boolean).join('\n\n');

    const assignment = await (this.prisma.operatorAssignment as any).create({
      data: {
        protocol: makeProtocol(),
        adminUserId: user.sub,
        adminName: clean(user.name) || 'Administrador',
        adminEmail: clean(user.email),
        operatorUserId: targetUser.id,
        operatorName: clean(targetUser.name),
        operatorEmail: clean(targetUser.email),
        operatorCpf: clean(targetUser.cpf) || cpfNormalized,
        operatorCpfNormalized: cpfNormalized,
        status: 'INVITED',
        workPlanStatus: 'NONE',
        paymentStatus: 'PENDING',
        invitationMessage: finalMessage || null,
        invitedAt: new Date(),
      },
    });

    return this.enrichAssignment(assignment);
  }

  async myInvitations(user: AuthenticatedUser) {
    const invitations = await (this.prisma.operatorAssignment as any).findMany({
      where: {
        operatorUserId: user.sub,
        status: {
          in: ['INVITED', 'ACCEPTED', 'SCHEDULE_PENDING', 'ACTIVE', 'DECLINED'],
        },
      },
      orderBy: [
        {
          updatedAt: 'desc',
        },
        {
          invitedAt: 'desc',
        },
      ],
    });

    return Promise.all(invitations.map((assignment: any) => this.enrichAssignment(assignment)));
  }

  async accept(id: string, user: AuthenticatedUser) {
    const assignment = await (this.prisma.operatorAssignment as any).findUnique({
      where: {
        id,
      },
    });

    if (!assignment) {
      throw new NotFoundException('Convite não encontrado');
    }

    if (assignment.operatorUserId !== user.sub) {
      throw new ForbiddenException('Este convite não pertence à sua conta');
    }

    const status = clean(assignment.status).toUpperCase();

    if (status === 'ACCEPTED' || status === 'SCHEDULE_PENDING' || status === 'ACTIVE') {
      return this.enrichAssignment(assignment);
    }

    if (status !== 'INVITED') {
      throw new BadRequestException('Este convite não pode mais ser aceito');
    }

    await (this.prisma.user as any).update({
      where: {
        id: user.sub,
      },
      data: {
        role: 'OPERATOR',
      },
    });

    const updated = await (this.prisma.operatorAssignment as any).update({
      where: {
        id,
      },
      data: {
        status: 'ACCEPTED',
        acceptedAt: new Date(),
      },
    });

    return this.enrichAssignment(updated);
  }

  async decline(id: string, user: AuthenticatedUser) {
    const assignment = await (this.prisma.operatorAssignment as any).findUnique({
      where: {
        id,
      },
    });

    if (!assignment) {
      throw new NotFoundException('Convite não encontrado');
    }

    if (assignment.operatorUserId !== user.sub) {
      throw new ForbiddenException('Este convite não pertence à sua conta');
    }

    if (clean(assignment.status).toUpperCase() !== 'INVITED') {
      throw new BadRequestException('Este convite não pode mais ser recusado');
    }

    const updated = await (this.prisma.operatorAssignment as any).update({
      where: {
        id,
      },
      data: {
        status: 'DECLINED',
        declinedAt: new Date(),
      },
    });

    return this.enrichAssignment(updated);
  }

  async list(user: AuthenticatedUser) {
    assertAdmin(user);

    const assignments = await (this.prisma.operatorAssignment as any).findMany({
      where: isSuperAdmin(user)
        ? {}
        : {
            adminUserId: user.sub,
          },
      orderBy: [
        {
          updatedAt: 'desc',
        },
        {
          invitedAt: 'desc',
        },
      ],
    });

    return Promise.all(assignments.map((assignment: any) => this.enrichAssignment(assignment)));
  }

  async assign(id: string, user: AuthenticatedUser, body: AssignOperatorToEventDto) {
    assertAdmin(user);

    const assignment = await (this.prisma.operatorAssignment as any).findUnique({
      where: {
        id,
      },
    });

    if (!assignment) {
      throw new NotFoundException('Convite/operador não encontrado');
    }

    if (!isSuperAdmin(user) && assignment.adminUserId !== user.sub) {
      throw new ForbiddenException('Você não pode atribuir este operador');
    }

    const status = clean(assignment.status).toUpperCase();

    if (!['ACCEPTED', 'SCHEDULE_PENDING', 'ACTIVE'].includes(status)) {
      throw new BadRequestException(
        'A pessoa precisa responder Sim no suporte antes de receber uma proposta de datas',
      );
    }

    const eventId = clean(body.eventId);

    if (!eventId) {
      throw new BadRequestException('Selecione o evento para atribuir o operador');
    }

    const proposedDates = normalizeWorkDates(
      body.workDates.map((item, index) => ({
        id: makeWorkDateId(index),
        date: item.date,
        amount: item.amount,
        functions: item.functions,
        status: 'PENDING',
        available: null,
      })),
    ).filter((item) => item.date && item.amount > 0 && item.functions);

    if (proposedDates.length === 0) {
      throw new BadRequestException(
        'Informe pelo menos uma data, valor por data e função do operador',
      );
    }

    const event = await (this.prisma.event as any).findUnique({
      where: {
        id: eventId,
      },
      include: {
        organizer: true,
      },
    });

    if (!event) {
      throw new NotFoundException('Evento não encontrado');
    }

    const permissions = {
      canValidateTickets: body.canValidateTickets !== false,
      canAnswerSupport: body.canAnswerSupport !== false,
    };

    const updated = await (this.prisma.operatorAssignment as any).update({
      where: {
        id,
      },
      data: {
        eventId: event.id,
        eventTitle: event.name,
        eventDate: event.eventDate,
        status: 'SCHEDULE_PENDING',
        workPlanStatus: 'PENDING_OPERATOR_RESPONSE',
        paymentStatus: 'PENDING',
        notes: clean(body.notes) || null,
        permissions,
        workDates: proposedDates,
        assignedAt: new Date(),
        workPlanSubmittedAt: new Date(),
      },
    });

    return this.enrichAssignment(updated);
  }

  async respondWorkPlan(id: string, user: AuthenticatedUser, body: RespondOperatorWorkPlanDto) {
    const assignment = await (this.prisma.operatorAssignment as any).findUnique({
      where: {
        id,
      },
    });

    if (!assignment) {
      throw new NotFoundException('Proposta de trabalho não encontrada');
    }

    if (assignment.operatorUserId !== user.sub) {
      throw new ForbiddenException('Esta proposta não pertence à sua conta');
    }

    if (!['SCHEDULE_PENDING', 'ACTIVE'].includes(clean(assignment.status).toUpperCase())) {
      throw new BadRequestException('Esta proposta não está aguardando resposta de disponibilidade');
    }

    const workDates = normalizeWorkDates(assignment.workDates);
    const responses = Array.isArray(body.responses) ? body.responses : [];

    if (workDates.length === 0) {
      throw new BadRequestException('Esta proposta não possui datas de trabalho');
    }

    const now = new Date().toISOString();

    const updatedDates: WorkDate[] = workDates.map((workDate): WorkDate => {
      const response = responses.find((item) => clean(item.id) === workDate.id);

      if (!response) {
        return workDate;
      }

      return {
        ...workDate,
        available: response.available === true,
        status: response.available === true ? 'AVAILABLE' : 'UNAVAILABLE',
        responseNote: clean(response.note) || null,
        respondedAt: now,
      };
    });

    const summary = summarizeWorkDates(updatedDates);
    const workPlanStatus =
      summary.availableDays === 0
        ? 'ALL_DECLINED'
        : summary.unavailableDays > 0 || summary.pendingDays > 0
          ? 'PARTIALLY_CONFIRMED'
          : 'CONFIRMED';

    const updated = await (this.prisma.operatorAssignment as any).update({
      where: {
        id,
      },
      data: {
        workDates: updatedDates,
        workPlanStatus,
        workPlanRespondedAt: new Date(),
        paymentCalculatedAt: new Date(),
        status: summary.availableDays > 0 ? 'ACTIVE' : 'ACCEPTED',
      },
    });

    return this.enrichAssignment(updated);
  }

  async report(id: string, user: AuthenticatedUser) {
    assertAdmin(user);

    const assignment = await (this.prisma.operatorAssignment as any).findUnique({
      where: {
        id,
      },
    });

    if (!assignment) {
      throw new NotFoundException('Operador atribuído não encontrado');
    }

    if (!isSuperAdmin(user) && assignment.adminUserId !== user.sub) {
      throw new ForbiddenException('Você não pode ver o relatório deste operador');
    }

    const workDates = normalizeWorkDates(assignment.workDates);
    const paymentSummary = summarizeWorkDates(workDates);

    return {
      assignment: await this.enrichAssignment(assignment),
      eventHasPassed: assignment.eventDate ? new Date(assignment.eventDate).getTime() < Date.now() : false,
      paymentSummary,
      workDates,
      summary: {
        ticketsTotal: 0,
        ticketsUsed: 0,
        operatorCheckins: 0,
        supportThreads: 0,
        supportThreadsClosed: 0,
        supportMessages: 0,
        paidOrders: 0,
        paidRevenue: 0,
        amountToPayOperator: paymentSummary.approvedTotal,
        payableDays: paymentSummary.availableDays,
      },
      checkins: [],
      supportThreads: [],
    };
  }

  private async enrichAssignment(assignment: any) {
    const workDates = normalizeWorkDates(assignment.workDates);
    const paymentSummary = summarizeWorkDates(workDates);

    const [operator, event] = await Promise.all([
      (this.prisma.user as any).findUnique({
        where: {
          id: assignment.operatorUserId,
        },
        select: {
          id: true,
          name: true,
          email: true,
          cpf: true,
          role: true,
          status: true,
        },
      }),
      assignment.eventId
        ? (this.prisma.event as any).findUnique({
            where: {
              id: assignment.eventId,
            },
            select: {
              id: true,
              name: true,
              eventDate: true,
              status: true,
            },
          })
        : Promise.resolve(null),
    ]);

    return {
      ...assignment,
      workDates,
      paymentSummary,
      operator,
      event,
    };
  }
}
