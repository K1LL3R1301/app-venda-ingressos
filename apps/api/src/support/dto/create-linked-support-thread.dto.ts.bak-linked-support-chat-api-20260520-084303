import { IsEmail, IsIn, IsOptional, IsString, MinLength } from 'class-validator';

export class CreateLinkedSupportThreadDto {
  @IsString()
  eventId: string;

  @IsOptional()
  @IsString()
  orderId?: string;

  @IsString()
  @MinLength(3)
  title: string;

  @IsString()
  @MinLength(3)
  message: string;

  @IsOptional()
  @IsString()
  category?: string;

  @IsOptional()
  @IsIn(['LOW', 'NORMAL', 'HIGH', 'URGENT'])
  priority?: string;

  @IsOptional()
  @IsIn(['PRODUCER', 'OPERATOR', 'SUPER_ADMIN'])
  currentOwnerType?: string;

  @IsOptional()
  @IsString()
  customerName?: string;

  @IsOptional()
  @IsEmail()
  customerEmail?: string;

  @IsOptional()
  @IsString()
  operatorUserId?: string;

  @IsOptional()
  @IsString()
  operatorName?: string;

  @IsOptional()
  @IsEmail()
  operatorEmail?: string;
}