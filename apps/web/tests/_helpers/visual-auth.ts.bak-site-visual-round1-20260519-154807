import type { Page } from "@playwright/test";
import fs from "node:fs/promises";
import path from "node:path";

export type VisualRole = "CUSTOMER" | "ADMIN" | "OPERATOR" | "SUPER_ADMIN";

export const VISUAL_TEST_EVENT_ID = "event-test-support-001";
export const VISUAL_TEST_EVENT_NAME = "Evento Teste Suporte";

export async function ensureDir(dir: string) {
  await fs.mkdir(dir, { recursive: true });
}

export function screenshotDir() {
  return path.join(process.cwd(), "test-results", "site-wide-visual");
}

export function safeName(value: string) {
  return value
    .replace(/^https?:\/\//, "")
    .replace(/[^\w.-]+/g, "-")
    .replace(/^-+|-+$/g, "")
    .slice(0, 120);
}

export async function saveVisualScreenshot(page: Page, name: string) {
  const dir = screenshotDir();

  await ensureDir(dir);

  await page.screenshot({
    path: path.join(dir, `${safeName(name)}.png`),
    fullPage: true,
  });
}

