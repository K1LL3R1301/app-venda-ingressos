export async function seedSession(page: Page, role: VisualRole) {
  const user = userForRole(role);

  await page.addInitScript((seededUser) => {
    sessionStorage.setItem("astro_session_token", `visual-token-${seededUser.role}`);
    sessionStorage.setItem("astro_session_user", JSON.stringify(seededUser));
    sessionStorage.setItem("token", `visual-token-${seededUser.role}`);
    sessionStorage.setItem("user", JSON.stringify(seededUser));
  }, user);
}

