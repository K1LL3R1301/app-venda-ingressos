import { expect, test } from "@playwright/test";
import {
  collectPageProblems,
  saveVisualScreenshot,
  seedSession,
  seedSupportTicket,
} from "./_helpers/visual-auth";

test.describe("visual: fluxos criticos fora do suporte", () => {
  test("admin wallet filtra eventos e mostra valor real do produtor", async ({ page }) => {
    const problems = await collectPageProblems(page);

    await seedSession(page, "ADMIN");
    await seedSupportTicket(page);

    await page.goto("/admin/wallet", { waitUntil: "domcontentloaded" });
    await page.waitForTimeout(900);

    await expect(page.getByText(/Valor real produtor/i).first()).toBeVisible();
    await expect(page.getByText(/Vendas pagas/i).first()).toBeVisible();
    await expect(page.getByText(/Equipe no fechamento/i).first()).toBeVisible();

    const select = page.locator("select").first();

    if (await select.count()) {
      await expect(select).toBeVisible();
    }

    await saveVisualScreenshot(page, "flow-admin-wallet-resumo");
    expect.soft(problems, "admin-wallet console/page errors").toEqual([]);
  });

  test("login aparece limpo sem sessão", async ({ page }) => {
    const problems = await collectPageProblems(page);

    await page.addInitScript(() => {
      sessionStorage.clear();
      localStorage.removeItem("token");
      localStorage.removeItem("user");
    });

    await page.goto("/login", { waitUntil: "domcontentloaded" });
    await page.waitForTimeout(700);

    const body = await page.locator("body").innerText();

    await expect(page.locator("body")).toBeVisible();
    expect.soft(body).toMatch(/login|entrar|cpf|senha/i);
    expect.soft(body).not.toMatch(/Application error|Unhandled Runtime Error|Hydration failed/i);

    await saveVisualScreenshot(page, "flow-login-limpo");
    expect.soft(problems, "login console/page errors").toEqual([]);
  });

  test("menu principal abre e mostra atalhos importantes", async ({ page }) => {
    const problems = await collectPageProblems(page);

    await seedSession(page, "ADMIN");
    await page.goto("/admin/wallet", { waitUntil: "domcontentloaded" });
    await page.waitForTimeout(700);

    const menuButton = page.getByRole("button", { name: /abrir menu/i }).first();

    if (await menuButton.count()) {
      await menuButton.click();
      await page.waitForTimeout(300);
      await expect(page.locator("body")).toContainText(/Dashboard|Painel|Suporte|Wallet|Eventos/i);
    } else {
      expect.soft(await page.locator("body").innerText()).toMatch(/Wallet|Admin|Painel/i);
    }

    await saveVisualScreenshot(page, "flow-menu-principal-admin");
    expect.soft(problems, "menu console/page errors").toEqual([]);
  });
});