// @ts-nocheck

export type SupportOwnerType = "PRODUCER" | "OPERATOR" | "SUPER_ADMIN";
export type SupportStatus =
  | "OPEN"
  | "IN_PROGRESS"
  | "FORWARDED_TO_SUPER_ADMIN"
  | "RETURNED_TO_PRODUCER"
  | "RETURNED_TO_OPERATOR"
  | "RESOLVED"
  | "CLOSED";

export type SupportTicket = {
  id: string;
  protocol: string;
  title: string;
  category: string;
  priority: "LOW" | "NORMAL" | "HIGH" | "URGENT";
  status: SupportStatus;
  currentOwnerType: SupportOwnerType;
  eventId?: string;
  eventName?: string;
  customerName?: string;
  customerEmail?: string;
  producerName?: string;
  producerEmail?: string;
  operatorName?: string;
  operatorEmail?: string;
  createdAt: string;
  updatedAt: string;
  messages: Array<{
    id: string;
    kind: "MESSAGE" | "FORWARD" | "RETURN" | "RESOLUTION" | "SYSTEM";
    authorRole: SupportOwnerType | "CUSTOMER";
    authorName: string;
    authorEmail?: string;
    text: string;
    createdAt: string;
    internal?: boolean;
  }>;
  history: Array<{
    id: string;
    action: string;
    from?: SupportOwnerType;
    to?: SupportOwnerType;
    byName: string;
    byEmail?: string;
    note?: string;
    createdAt: string;
  }>;
};

const STORAGE_KEY = "astro_linked_support_tickets_v1";

function nowIso() {
  return new Date().toISOString();
}

function uid(prefix = "SUP") {
  return `${prefix}-${Date.now().toString(36).toUpperCase()}-${Math.random()
    .toString(36)
    .slice(2, 8)
    .toUpperCase()}`;
}

function safeParse(raw: string | null) {
  try {
    return raw ? JSON.parse(raw) : [];
  } catch {
    return [];
  }
}

export function getSupportTickets(): SupportTicket[] {
  if (typeof window === "undefined") return [];
  const tickets = safeParse(window.localStorage.getItem(STORAGE_KEY));
  return Array.isArray(tickets) ? tickets : [];
}

export function saveSupportTickets(tickets: SupportTicket[]) {
  if (typeof window === "undefined") return;
  window.localStorage.setItem(STORAGE_KEY, JSON.stringify(tickets));
  window.dispatchEvent(new CustomEvent("astro-support-updated"));
}

export function supportStatusLabel(status?: string) {
  const map: Record<string, string> = {
    OPEN: "Aberto",
    IN_PROGRESS: "Em atendimento",
    FORWARDED_TO_SUPER_ADMIN: "Com Super Admin",
    RETURNED_TO_PRODUCER: "Devolvido ao produtor",
    RETURNED_TO_OPERATOR: "Devolvido ao operador",
    RESOLVED: "Resolvido",
    CLOSED: "Fechado",
  };
  return map[String(status || "OPEN")] || "Aberto";
}

export function supportOwnerLabel(owner?: string) {
  const map: Record<string, string> = {
    PRODUCER: "Produtor/Admin",
    OPERATOR: "Operador",
    SUPER_ADMIN: "Super Admin",
    CUSTOMER: "Cliente",
  };
  return map[String(owner || "")] || "Responsável";
}

export function supportPriorityLabel(priority?: string) {
  const map: Record<string, string> = {
    LOW: "Baixa",
    NORMAL: "Normal",
    HIGH: "Alta",
    URGENT: "Urgente",
  };
  return map[String(priority || "NORMAL")] || "Normal";
}

export function makeSupportProtocol() {
  const date = new Date();
  const stamp = `${date.getFullYear()}${String(date.getMonth() + 1).padStart(2, "0")}${String(
    date.getDate(),
  ).padStart(2, "0")}`;
  return `ASTRO-SUP-${stamp}-${Math.random().toString(36).slice(2, 7).toUpperCase()}`;
}

export function createSupportTicket(input: {
  title: string;
  message: string;
  category?: string;
  priority?: "LOW" | "NORMAL" | "HIGH" | "URGENT";
  currentOwnerType?: SupportOwnerType;
  eventId?: string;
  eventName?: string;
  customerName?: string;
  customerEmail?: string;
  producerName?: string;
  producerEmail?: string;
  operatorName?: string;
  operatorEmail?: string;
  createdByRole?: SupportOwnerType | "CUSTOMER";
  createdByName?: string;
  createdByEmail?: string;
}) {
  if (!String(input.title || "").trim() || !String(input.message || "").trim()) {
    throw new Error("Informe título e mensagem do chamado.");
  }

  const createdAt = nowIso();
  const owner = input.currentOwnerType || "PRODUCER";
  const authorRole = input.createdByRole || owner;

  const ticket: SupportTicket = {
    id: uid("SUPPORT"),
    protocol: makeSupportProtocol(),
    title: input.title.trim(),
    category: input.category || "Atendimento",
    priority: input.priority || "NORMAL",
    status: "OPEN",
    currentOwnerType: owner,
    eventId: input.eventId,
    eventName: input.eventName,
    customerName: input.customerName,
    customerEmail: input.customerEmail,
    producerName: input.producerName,
    producerEmail: input.producerEmail,
    operatorName: input.operatorName,
    operatorEmail: input.operatorEmail,
    createdAt,
    updatedAt: createdAt,
    messages: [
      {
        id: uid("MSG"),
        kind: "MESSAGE",
        authorRole,
        authorName: input.createdByName || "Sistema",
        authorEmail: input.createdByEmail,
        text: input.message.trim(),
        createdAt,
      },
    ],
    history: [
      {
        id: uid("HIS"),
        action: "Chamado criado",
        to: owner,
        byName: input.createdByName || "Sistema",
        byEmail: input.createdByEmail,
        createdAt,
      },
    ],
  };

  saveSupportTickets([ticket, ...getSupportTickets()]);
  return ticket;
}

export function updateSupportTicket(ticketId: string, updater: (ticket: SupportTicket) => SupportTicket) {
  let updated: SupportTicket | null = null;

  const next = getSupportTickets().map((ticket) => {
    if (ticket.id !== ticketId) return ticket;
    updated = { ...updater(ticket), updatedAt: nowIso() };
    return updated;
  });

  saveSupportTickets(next);
  return updated;
}

export function addSupportMessage(
  ticketId: string,
  actor: { role: SupportOwnerType | "CUSTOMER"; name: string; email?: string },
  text: string,
) {
  const value = String(text || "").trim();
  if (!value) throw new Error("Digite uma resposta antes de salvar.");

  return updateSupportTicket(ticketId, (ticket) => ({
    ...ticket,
    status: ticket.status === "OPEN" ? "IN_PROGRESS" : ticket.status,
    messages: [
      ...ticket.messages,
      {
        id: uid("MSG"),
        kind: "MESSAGE",
        authorRole: actor.role,
        authorName: actor.name,
        authorEmail: actor.email,
        text: value,
        createdAt: nowIso(),
      },
    ],
    history: [
      ...ticket.history,
      {
        id: uid("HIS"),
        action: "Resposta adicionada",
        byName: actor.name,
        byEmail: actor.email,
        createdAt: nowIso(),
      },
    ],
  }));
}

export function forwardSupportToSuperAdmin(
  ticketId: string,
  actor: { role: "PRODUCER" | "OPERATOR"; name: string; email?: string },
  reason: string,
) {
  const value = String(reason || "").trim();
  if (!value) throw new Error("Explique o motivo técnico do encaminhamento.");

  return updateSupportTicket(ticketId, (ticket) => ({
    ...ticket,
    status: "FORWARDED_TO_SUPER_ADMIN",
    currentOwnerType: "SUPER_ADMIN",
    messages: [
      ...ticket.messages,
      {
        id: uid("MSG"),
        kind: "FORWARD",
        authorRole: actor.role,
        authorName: actor.name,
        authorEmail: actor.email,
        text: value,
        createdAt: nowIso(),
        internal: true,
      },
    ],
    history: [
      ...ticket.history,
      {
        id: uid("HIS"),
        action: "Encaminhado ao Super Admin",
        from: actor.role,
        to: "SUPER_ADMIN",
        byName: actor.name,
        byEmail: actor.email,
        note: value,
        createdAt: nowIso(),
      },
    ],
  }));
}

export function returnSupportFromSuperAdmin(
  ticketId: string,
  target: "PRODUCER" | "OPERATOR",
  actor: { name: string; email?: string },
  response: string,
) {
  const value = String(response || "").trim();
  if (!value) throw new Error("Digite a orientação antes de devolver.");

  return updateSupportTicket(ticketId, (ticket) => ({
    ...ticket,
    status: target === "PRODUCER" ? "RETURNED_TO_PRODUCER" : "RETURNED_TO_OPERATOR",
    currentOwnerType: target,
    messages: [
      ...ticket.messages,
      {
        id: uid("MSG"),
        kind: "RETURN",
        authorRole: "SUPER_ADMIN",
        authorName: actor.name,
        authorEmail: actor.email,
        text: value,
        createdAt: nowIso(),
      },
    ],
    history: [
      ...ticket.history,
      {
        id: uid("HIS"),
        action: target === "PRODUCER" ? "Devolvido ao produtor" : "Devolvido ao operador",
        from: "SUPER_ADMIN",
        to: target,
        byName: actor.name,
        byEmail: actor.email,
        note: value,
        createdAt: nowIso(),
      },
    ],
  }));
}

export function resolveSupportTicket(
  ticketId: string,
  actor: { role: SupportOwnerType; name: string; email?: string },
  response: string,
) {
  const value = String(response || "").trim();
  if (!value) throw new Error("Digite a solução antes de resolver.");

  return updateSupportTicket(ticketId, (ticket) => ({
    ...ticket,
    status: "RESOLVED",
    currentOwnerType: actor.role,
    messages: [
      ...ticket.messages,
      {
        id: uid("MSG"),
        kind: "RESOLUTION",
        authorRole: actor.role,
        authorName: actor.name,
        authorEmail: actor.email,
        text: value,
        createdAt: nowIso(),
      },
    ],
    history: [
      ...ticket.history,
      {
        id: uid("HIS"),
        action: "Chamado resolvido",
        byName: actor.name,
        byEmail: actor.email,
        createdAt: nowIso(),
      },
    ],
  }));
}

export function getVisibleSupportTickets(params: {
  role: SupportOwnerType;
  userEmail?: string;
  eventId?: string | null;
}) {
  const email = String(params.userEmail || "").toLowerCase();

  return getSupportTickets().filter((ticket) => {
    if (params.eventId && ticket.eventId && ticket.eventId !== params.eventId) return false;

    if (params.role === "SUPER_ADMIN") {
      return ticket.currentOwnerType === "SUPER_ADMIN" || ticket.status === "FORWARDED_TO_SUPER_ADMIN";
    }

    if (params.role === "OPERATOR") {
      const operatorEmail = String(ticket.operatorEmail || "").toLowerCase();
      return ticket.currentOwnerType === "OPERATOR" || operatorEmail === email || ticket.status === "RETURNED_TO_OPERATOR";
    }

    const producerEmail = String(ticket.producerEmail || "").toLowerCase();
    return ticket.currentOwnerType === "PRODUCER" || producerEmail === email || ticket.status === "RETURNED_TO_PRODUCER";
  });
}

export function seedSupportTicketForEvent(input: {
  eventId?: string | null;
  eventName?: string | null;
  producerName?: string | null;
  producerEmail?: string | null;
  operatorName?: string | null;
  operatorEmail?: string | null;
}) {
  const eventId = String(input.eventId || "GLOBAL");
  const exists = getSupportTickets().some(
    (ticket) => ticket.eventId === eventId && ticket.title === "Atendimento operacional do evento",
  );

  if (exists) return null;

  return createSupportTicket({
    title: "Atendimento operacional do evento",
    category: "Operação",
    message:
      "Chamado criado para centralizar atendimentos deste evento. Responda aqui ou encaminhe ao Super Admin se for problema técnico do site.",
    priority: "NORMAL",
    currentOwnerType: "OPERATOR",
    eventId: input.eventId || undefined,
    eventName: input.eventName || "Evento não informado",
    producerName: input.producerName || "Produtor/Admin",
    producerEmail: input.producerEmail || undefined,
    operatorName: input.operatorName || "Operador",
    operatorEmail: input.operatorEmail || undefined,
    createdByRole: "PRODUCER",
    createdByName: input.producerName || "Produtor/Admin",
    createdByEmail: input.producerEmail || undefined,
  });
}
export function supportTargetLabel(target?: string | null) {
  const labels: Record<string, string> = {
    ALL: "Todos do chamado",
    CUSTOMER: "Cliente",
    PRODUCER: "Produtor/Admin",
    OPERATOR: "Operador",
    SUPER_ADMIN: "Super Admin",
  };

  return labels[String(target || "ALL").toUpperCase()] || "Todos do chamado";
}