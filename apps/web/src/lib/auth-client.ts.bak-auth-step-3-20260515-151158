export type StoredAuthUser = {
  id?: string;
  sub?: string;
  name?: string;
  email?: string;
  cpf?: string;
  role?: string;
  status?: string;
  authProvider?: string;
};

const COOKIE_MAX_AGE_SECONDS = 60 * 60 * 24 * 7;

function canUseBrowser() {
  return typeof window !== "undefined";
}

function writeCookie(name: string, value: string, maxAge = COOKIE_MAX_AGE_SECONDS) {
  if (!canUseBrowser()) return;

  document.cookie = `${name}=${encodeURIComponent(value)}; Max-Age=${maxAge}; Path=/; SameSite=Lax`;
}

function deleteCookie(name: string) {
  if (!canUseBrowser()) return;

  document.cookie = `${name}=; Max-Age=0; Path=/; SameSite=Lax`;
}

export function getStoredAuthUser<T extends StoredAuthUser = StoredAuthUser>(): T | null {
  if (!canUseBrowser()) return null;

  try {
    const rawUser = localStorage.getItem("user");
    return rawUser ? (JSON.parse(rawUser) as T) : null;
  } catch {
    return null;
  }
}

export function getStoredAuthToken() {
  if (!canUseBrowser()) return "";

  const token = localStorage.getItem("token") || "";
  return token === "undefined" ? "" : token;
}

export function setAuthSession(token: string, user?: StoredAuthUser | null) {
  if (!canUseBrowser()) return;

  localStorage.removeItem("token");
  localStorage.removeItem("user");

  localStorage.setItem("token", token);

  if (user) {
    localStorage.setItem("user", JSON.stringify(user));
  }

  writeCookie("astro_token", token);
  writeCookie("astro_user_role", String(user?.role || "").toUpperCase());
}

export function clearAuthSession() {
  if (!canUseBrowser()) return;

  localStorage.removeItem("token");
  localStorage.removeItem("refreshToken");
  localStorage.removeItem("user");

  deleteCookie("astro_token");
  deleteCookie("astro_user_role");
}