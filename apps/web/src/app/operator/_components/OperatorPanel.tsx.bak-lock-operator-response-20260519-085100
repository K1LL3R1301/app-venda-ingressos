                    <div>
                      <p className="text-[10px] font-black uppercase text-emerald-600">Horário</p>
                      <p className="mt-1 font-black">
                        {item.workDate.startTime || "--:--"} às {item.workDate.endTime || "--:--"}
                      </p>
                    </div>

                    <div>
                      <p className="font-black text-slate-950">{getEventName(item.assignment)}</p>
                      <p className="mt-1 text-sm font-semibold text-slate-600">
                        {item.producer.name} • {item.workDate.functions || "Função não informada"}
