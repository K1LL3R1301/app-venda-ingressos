  onOpenAssignment,
}: {
  items: AgendaItem[];
  onOpenAssignment: (producer: ProducerGroup, assignment: OperatorAssignment) => void;
}) {
  const grouped = groupAgendaByDate(items);

  return (
    <section className="space-y-5">
      <div className="rounded-[30px] border border-slate-200 bg-white p-6 shadow-sm">
        <p className="text-[11px] font-black uppercase tracking-[0.22em] text-orange-600">Agenda</p>
        <h2 className="mt-2 text-3xl font-black text-slate-950">Eventos aceitos</h2>
        <p className="mt-2 text-sm font-semibold text-slate-500">
          Tudo que você aceitar entra aqui baseado na data e horário da ficha.
        </p>
