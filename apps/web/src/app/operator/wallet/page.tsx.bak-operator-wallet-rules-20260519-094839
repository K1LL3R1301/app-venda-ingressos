      <div className="mx-auto flex h-[82px] max-w-[1180px] items-center gap-5 px-4">
        <a href="/dashboard" className="flex shrink-0 items-center" aria-label="Astro Ingressos">
          <img
            src="/astro-ingressos-logo.png"
            alt="Astro Ingressos"
