// @ts-nocheck
"use client";

import { FormEvent, useEffect, useMemo, useState } from "react";
import {
  clearAuthSession,
  getStoredAuthToken,
  getStoredAuthUser,
} from "../../../lib/auth-client";

const API_BASE_URL =
  process.env.NEXT_PUBLIC_API_URL?.replace(/\/$/, "") ||
  process.env.NEXT_PUBLIC_API_BASE_URL?.replace(/\/$/, "") ||
  "http://localhost:3001/v1";

type StoredUser = {
  id?: string;
  sub?: string;
  name?: string;
  email?: string;
  cpf?: string;
  role?: string;
};

type Assignment = {
  id: string;
  status?: string | null;
  eventId?: string | null;
  eventTitle?: string | null;
  eventName?: string | null;
  operatorUserId?: string | null;
  operatorEmail?: string | null;
  operatorCpf?: string | null;
  operatorCpfNormalized?: string | null;
  permissions?: {
    canValidateTickets?: boolean | null;
    canAnswerSupport?: boolean | null;
  } | null;
  canAnswerSupport?: boolean | null;
  workDates?: Array<{
    available?: boolean | null;
    status?: string | null;
  }> | null;
  event?: {
    id?: string | null;
    name?: string | null;
    title?: string | null;
    eventDate?: string | null;
  } | null;
};

type SupportReply = {
  id: string;
  message: string;
  createdAt: string;
  operatorName?: string;
};

type SupportTicket = {
  id: string;
  title: string;
  category: string;
  customerName: string;
  customerEmail?: string;
  message: string;
  status: "OPEN" | "ANSWERED" | "FORWARDED" | "CLOSED";
  createdAt: string;
  closedAt?: string | null;
  forwardedAt?: string | null;
  forwardedBy?: string | null;
  forwardedReason?: string | null;
  operatorName?: string;
  replies?: SupportReply[];
  raw?: unknown;
};

function normalizeText(value?: string | number | null) {
  return String(value ?? "")
    .trim()
    .toLowerCase()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "");
}

function onlyDigits(value?: string | null) {
  return String(value || "").replace(/\D/g, "");
}

function currentUserId(user?: StoredUser | null) {
  return String(user?.id || user?.sub || "");
}

function assignmentBelongsToUser(assignment: Assignment, user: StoredUser | null) {
  const userId = currentUserId(user);
  const userEmail = normalizeText(user?.email);
  const userCpf = onlyDigits(user?.cpf);

  const ids = [assignment.operatorUserId].map((value) => String(value || ""));
  const emails = [assignment.operatorEmail].map(normalizeText);
  const cpfs = [assignment.operatorCpf, assignment.operatorCpfNormalized].map(onlyDigits);

  if (userId && ids.includes(userId)) return true;
  if (userEmail && emails.includes(userEmail)) return true;
  if (userCpf && cpfs.includes(userCpf)) return true;

  return false;
}

function getAssignmentEventId(assignment?: Assignment | null) {
  return String(assignment?.eventId || assignment?.event?.id || "");
}

function getAssignmentEventName(assignment?: Assignment | null) {
  return (
    assignment?.event?.name ||
    assignment?.event?.title ||
    assignment?.eventTitle ||
    assignment?.eventName ||
    "Evento"
  );
}

function canSupport(assignment?: Assignment | null) {
  return (
    assignment?.permissions?.canAnswerSupport ??
    assignment?.canAnswerSupport ??
    true
  ) !== false;
}

function assignmentWasDeclined(assignment?: Assignment | null) {
  const currentStatus = String(assignment?.status || "").toUpperCase();

  if (["DECLINED", "REJECTED"].includes(currentStatus)) {
    return true;
  }

  const dates = Array.isArray(assignment?.workDates) ? assignment?.workDates || [] : [];

  if (dates.length === 0) {
    return false;
  }

  return dates.every((date) => {
    const status = String(date?.status || "").toUpperCase();

    return date?.available === false || ["UNAVAILABLE", "DECLINED", "REJECTED"].includes(status);
  });
}

function primaryLocalKey(assignmentId: string) {
  return `astro_operator_support_${assignmentId}`;
}

function legacyEventKeys(eventId: string) {
  return [
    `astro_event_support_${eventId}`,
    `astro_support_${eventId}`,
    `astro_support_requests_${eventId}`,
    `astro_support_tickets_${eventId}`,
    `astro_customer_support_${eventId}`,
  ];
}

function parseList(value: string | null) {
  if (!value) return [];

  try {
    const parsed = JSON.parse(value);

    if (Array.isArray(parsed)) return parsed;
    if (Array.isArray(parsed?.items)) return parsed.items;
    if (Array.isArray(parsed?.tickets)) return parsed.tickets;
    if (Array.isArray(parsed?.requests)) return parsed.requests;

    return [];
  } catch {
    return [];
  }
}

function normalizeTicket(item: any, index: number): SupportTicket {
  const replies = Array.isArray(item?.replies)
    ? item.replies
    : Array.isArray(item?.messages)
      ? item.messages
      : [];

  const normalizedStatus = String(item?.status || "OPEN").toUpperCase();
  const status =
    normalizedStatus === "FORWARDED"
      ? "FORWARDED"
      : normalizedStatus === "CLOSED" || normalizedStatus === "RESOLVED"
        ? "CLOSED"
        : normalizedStatus === "ANSWERED"
          ? "ANSWERED"
          : replies.length > 0
            ? "ANSWERED"
            : "OPEN";

  return {
    id: String(item?.id || item?.ticketId || item?.protocol || `support-${index}-${Date.now()}`),
    title: String(item?.title || item?.subject || item?.reason || "Atendimento sem título"),
    category: String(item?.category || item?.type || "Suporte"),
    customerName: String(item?.customerName || item?.customer?.name || item?.buyerName || item?.name || "Cliente"),
    customerEmail: item?.customerEmail || item?.customer?.email || item?.email || "",
    message: String(item?.message || item?.description || item?.body || item?.note || "Sem mensagem registrada."),
    status,
    createdAt: String(item?.createdAt || item?.created_at || new Date().toISOString()),
    closedAt: item?.closedAt || item?.resolvedAt || null,
    forwardedAt: item?.forwardedAt || null,
    forwardedBy: item?.forwardedBy || null,
    forwardedReason: item?.forwardedReason || null,
    operatorName: item?.operatorName || item?.operator?.name || "",
    replies: replies.map((reply: any, replyIndex: number) => ({
      id: String(reply?.id || `reply-${replyIndex}-${Date.now()}`),
      message: String(reply?.message || reply?.body || reply?.text || ""),
      createdAt: String(reply?.createdAt || reply?.created_at || new Date().toISOString()),
      operatorName: reply?.operatorName || reply?.operator?.name || "",
    })),
    raw: item,
  };
}

function dedupeTickets(tickets: SupportTicket[]) {
  const seen = new Set<string>();
  const result: SupportTicket[] = [];

  for (const ticket of tickets) {
    const key = ticket.id || `${ticket.title}-${ticket.createdAt}`;

    if (seen.has(key)) continue;

    seen.add(key);
    result.push(ticket);
  }

  return result;
}

function loadLocalTickets(assignmentId: string, eventId: string): SupportTicket[] {
  if (typeof window === "undefined") return [];

  const direct = parseList(localStorage.getItem(primaryLocalKey(assignmentId))).map(normalizeTicket);

  const legacy = legacyEventKeys(eventId).flatMap((key) =>
    parseList(localStorage.getItem(key)).map(normalizeTicket),
  );

  return dedupeTickets([...direct, ...legacy]).sort((first, second) =>
    String(second.createdAt || "").localeCompare(String(first.createdAt || "")),
  );
}

function saveLocalTickets(assignmentId: string, tickets: SupportTicket[]) {
  if (typeof window === "undefined") return;

  localStorage.setItem(primaryLocalKey(assignmentId), JSON.stringify(tickets));
}

function formatDate(value?: string | null) {
  if (!value) return "-";

  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return value;

  return date.toLocaleString("pt-BR", {
    day: "2-digit",
    month: "short",
    year: "numeric",
    hour: "2-digit",
    minute: "2-digit",
  });
}

function statusLabel(status: SupportTicket["status"]) {
  const labels: Record<SupportTicket["status"], string> = {
    OPEN: "Aberto",
    ANSWERED: "Respondido",
    FORWARDED: "Encaminhado",
    CLOSED: "Resolvido",
  };

  return labels[status] || status;
}

function Topbar({ user }: { user: StoredUser | null }) {
  const [open, setOpen] = useState(false);
  const source = String(user?.name || user?.email || "O").trim();
  const initials = source
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((part) => part[0])
    .join("")
    .toUpperCase();

  function logout() {
    clearAuthSession();
    window.location.assign("/login");
  }

  return (
    <header className="sticky top-0 z-[9999] border-b border-[#ea5f00] bg-[#ff6900] shadow-sm">
      <div className="mx-auto flex h-[82px] max-w-[1180px] items-center gap-5 px-4">
        <a href="/operator/dashboard" className="flex shrink-0 items-center" aria-label="Astro Ingressos">
          <img
            src="/astro-ingressos-logo.png"
            alt="Astro Ingressos"
            className="h-[56px] w-auto object-contain"
          />
        </a>

        <div className="flex-1" />

        <a href="/operator/dashboard" className="hidden px-3 py-2 text-sm font-black text-[#19002f] md:inline-flex">
          Operador
        </a>

        <div className="relative">
          <button
            type="button"
            onClick={() => setOpen((value) => !value)}
            className="flex h-11 items-center gap-2 rounded-full bg-white px-3 text-[#19002f] shadow-sm ring-1 ring-black/10"
          >
            <span className="text-xl leading-none">☰</span>
            <span className="flex h-8 w-8 items-center justify-center rounded-full bg-[#19002f] text-sm font-black text-white">
              {initials || "O"}
            </span>
          </button>

          {open ? (
            <div className="absolute right-0 z-[10000] mt-3 w-80 overflow-hidden rounded-2xl border border-neutral-200 bg-white shadow-xl">
              <div className="border-b border-neutral-100 px-4 py-4">
                <p className="truncate text-sm font-black text-neutral-950">{user?.name || "Operador"}</p>
                <p className="mt-1 break-all text-xs font-semibold text-neutral-500">
                  {user?.email || "sem e-mail"}
                </p>
              </div>

              <div className="p-2">
                <a
                  href="/operator/dashboard"
                  className="flex w-full rounded-xl bg-neutral-950 px-3 py-3 text-sm font-semibold text-white"
                >
                  Voltar ao operador
                </a>

                <button
                  type="button"
                  onClick={logout}
                  className="mt-1 flex w-full rounded-xl px-3 py-3 text-sm font-semibold text-red-600 hover:bg-red-50"
                >
                  Sair
                </button>
              </div>
            </div>
          ) : null}
        </div>
      </div>
    </header>
  );
}

export default function OperatorSupportPage() {
  const [query, setQuery] = useState({ assignmentId: "", eventId: "" });
  const [user, setUser] = useState<StoredUser | null>(null);
  const [assignment, setAssignment] = useState<Assignment | null>(null);
  const [tickets, setTickets] = useState<SupportTicket[]>([]);
  const [drafts, setDrafts] = useState<Record<string, string>>({});
  const [forwardReasons, setForwardReasons] = useState<Record<string, string>>({});
  const [filter, setFilter] = useState<"ALL" | "OPEN" | "ANSWERED" | "FORWARDED" | "CLOSED">("ALL");
  const [search, setSearch] = useState("");
  const [loading, setLoading] = useState(true);
  const [errorMessage, setErrorMessage] = useState("");

  useEffect(() => {
    const params = new URLSearchParams(window.location.search);

    setQuery({
      assignmentId: params.get("assignmentId") || "",
      eventId: params.get("eventId") || "",
    });
  }, []);

  async function load() {
    const token = getStoredAuthToken();

    if (!token || token === "undefined") {
      window.location.href = "/login";
      return;
    }

    if (!query.assignmentId) return;

    const storedUser = getStoredAuthUser<StoredUser>();
    setUser(storedUser);
    setLoading(true);
    setErrorMessage("");

    try {
      const assignmentsResponse = await fetch(`${API_BASE_URL}/operator-assignments/me/invitations`, {
        headers: {
          Authorization: `Bearer ${token}`,
        },
      });

      const assignmentsJson = await assignmentsResponse.json().catch(() => []);

      if (!assignmentsResponse.ok) {
        throw new Error(assignmentsJson?.message || "Erro ao carregar ficha do operador");
      }

      const list = Array.isArray(assignmentsJson)
        ? assignmentsJson
        : Array.isArray(assignmentsJson?.items)
          ? assignmentsJson.items
          : [];

      const found = list.find((item: Assignment) => item.id === query.assignmentId);

      if (!found || !assignmentBelongsToUser(found, storedUser)) {
        setErrorMessage("Esta ficha não pertence à sua conta.");
        return;
      }

      if (assignmentWasDeclined(found)) {
        setErrorMessage("Esta ficha foi recusada. O suporte deste evento não fica disponível para esta conta.");
        return;
      }

      if (!canSupport(found)) {
        setErrorMessage("O produtor não liberou suporte para esta ficha.");
        return;
      }

      const eventId = query.eventId || getAssignmentEventId(found);

      if (!eventId || eventId !== getAssignmentEventId(found)) {
        setErrorMessage("Evento inválido para esta ficha.");
        return;
      }

      setAssignment(found);
      setTickets(loadLocalTickets(found.id, eventId));
    } catch (error) {
      console.error(error);
      setErrorMessage("Não foi possível abrir o suporte. Confira se a API está ligada.");
    } finally {
      setLoading(false);
    }
  }

  useEffect(() => {
    load();
  }, [query.assignmentId, query.eventId]);

  const filtered = useMemo(() => {
    const term = normalizeText(search);

    return tickets.filter((ticket) => {
      if (filter !== "ALL" && ticket.status !== filter) return false;

      if (!term) return true;

      return normalizeText(
        `${ticket.title} ${ticket.category} ${ticket.customerName} ${ticket.customerEmail || ""} ${ticket.message}`,
      ).includes(term);
    });
  }, [tickets, filter, search]);

  function persistTickets(next: SupportTicket[]) {
    setTickets(next);

    if (assignment?.id) {
      saveLocalTickets(assignment.id, next);
    }
  }

  function answerTicket(event: FormEvent, ticketId: string) {
    event.preventDefault();

    if (!assignment) return;

    const message = String(drafts[ticketId] || "").trim();

    if (!message) {
      alert("Digite uma resposta antes de salvar.");
      return;
    }

    const reply: SupportReply = {
      id: `reply-${Date.now()}`,
      message,
      createdAt: new Date().toISOString(),
      operatorName: user?.name || user?.email || "Operador",
    };

    const next = tickets.map((ticket) =>
      ticket.id === ticketId
        ? {
            ...ticket,
            status: "ANSWERED" as const,
            replies: [reply, ...(ticket.replies || [])],
            operatorName: user?.name || user?.email || "Operador",
          }
        : ticket,
    );

    persistTickets(next);
    setDrafts((current) => ({ ...current, [ticketId]: "" }));
  }

  function forwardToSuperAdmin(ticketId: string) {
    if (!assignment) return;

    const reason = String(forwardReasons[ticketId] || "").trim();

    if (!reason) {
      alert("Informe o motivo do encaminhamento para o Super Admin.");
      return;
    }

    if (!confirm("Encaminhar este atendimento para o Super Admin?")) {
      return;
    }

    const next = tickets.map((ticket) =>
      ticket.id === ticketId
        ? {
            ...ticket,
            status: "FORWARDED" as const,
            forwardedAt: new Date().toISOString(),
            forwardedBy: user?.name || user?.email || "Operador",
            forwardedReason: reason,
          }
        : ticket,
    );

    persistTickets(next);
    setForwardReasons((current) => ({ ...current, [ticketId]: "" }));
  }

  function closeTicket(ticketId: string) {
    if (!assignment) return;

    if (!confirm("Marcar este atendimento como resolvido?")) {
      return;
    }

    const next = tickets.map((ticket) =>
      ticket.id === ticketId
        ? {
            ...ticket,
            status: "CLOSED" as const,
            closedAt: new Date().toISOString(),
          }
        : ticket,
    );

    persistTickets(next);
  }

  if (loading) {
    return (
      <main className="min-h-screen bg-slate-100 text-slate-950">
        <Topbar user={user} />
        <section className="mx-auto max-w-7xl px-4 py-8">
          <div className="rounded-[30px] border border-slate-200 bg-white p-8 shadow-sm">
            <p className="font-black text-slate-600">Carregando suporte do evento...</p>
          </div>
        </section>
      </main>
    );
  }

  if (errorMessage) {
    return (
      <main className="min-h-screen bg-slate-100 text-slate-950">
        <Topbar user={user} />
        <section className="mx-auto max-w-7xl px-4 py-8">
          <div className="rounded-[30px] border border-rose-200 bg-rose-50 p-8 shadow-sm">
            <p className="text-[11px] font-black uppercase tracking-[0.22em] text-rose-600">Acesso bloqueado</p>
            <h1 className="mt-3 text-3xl font-black text-rose-950">{errorMessage}</h1>
            <a
              href="/operator/dashboard"
              className="mt-6 inline-flex rounded-2xl bg-slate-950 px-5 py-3 text-sm font-black text-white"
            >
              Voltar ao operador
            </a>
          </div>
        </section>
      </main>
    );
  }

  const openCount = tickets.filter((ticket) => ticket.status === "OPEN").length;
  const answeredCount = tickets.filter((ticket) => ticket.status === "ANSWERED").length;
  const forwardedCount = tickets.filter((ticket) => ticket.status === "FORWARDED").length;
  const closedCount = tickets.filter((ticket) => ticket.status === "CLOSED").length;

  return (
    <main className="min-h-screen bg-slate-100 text-slate-950">
      <Topbar user={user} />

      <section className="mx-auto max-w-7xl space-y-6 px-4 py-8">
        <section className="rounded-[34px] bg-slate-950 p-8 text-white shadow-sm">
          <p className="text-[11px] font-black uppercase tracking-[0.34em] text-blue-300">
            Suporte do operador
          </p>
          <h1 className="mt-4 text-5xl font-black leading-tight">
            {getAssignmentEventName(assignment)}
          </h1>
          <p className="mt-4 max-w-3xl text-sm font-semibold leading-7 text-white/75">
            O operador responde atendimentos já existentes deste evento. Quando for problema interno
            do site, encaminhe para o Super Admin.
          </p>
        </section>

        <section className="grid gap-4 md:grid-cols-5">
          <Metric label="Chamados" value={String(tickets.length)} />
          <Metric label="Abertos" value={String(openCount)} />
          <Metric label="Respondidos" value={String(answeredCount)} />
          <Metric label="Super Admin" value={String(forwardedCount)} />
          <Metric label="Resolvidos" value={String(closedCount)} />
        </section>

        <section className="rounded-[30px] border border-slate-200 bg-white p-6 shadow-sm">
          <div className="flex flex-wrap items-center justify-between gap-3">
            <div>
              <p className="text-[11px] font-black uppercase tracking-[0.22em] text-orange-600">
                Chamados deste evento
              </p>
              <h2 className="mt-2 text-3xl font-black">Responder atendimentos</h2>
              <p className="mt-2 max-w-3xl text-sm font-semibold text-slate-500">
                Esta tela não cria atendimento novo. Ela só permite responder chamados já existentes
                ou encaminhar para o Super Admin quando for problema interno da plataforma.
              </p>
            </div>

            <a
              href="/operator/dashboard"
              className="rounded-2xl border border-slate-200 px-4 py-3 text-sm font-black hover:bg-slate-50"
            >
              Voltar para a ficha
            </a>
          </div>

          <div className="mt-5 grid gap-3 lg:grid-cols-[1fr_240px]">
            <input
              value={search}
              onChange={(event) => setSearch(event.target.value)}
              placeholder="Buscar por cliente, título, categoria ou mensagem..."
              className="h-12 rounded-2xl border border-slate-200 bg-slate-50 px-4 text-sm font-bold outline-none focus:border-blue-500"
            />

            <select
              value={filter}
              onChange={(event) => setFilter(event.target.value as any)}
              className="h-12 rounded-2xl border border-slate-200 bg-white px-4 text-sm font-black"
            >
              <option value="ALL">Todos</option>
              <option value="OPEN">Abertos</option>
              <option value="ANSWERED">Respondidos</option>
              <option value="FORWARDED">Encaminhados</option>
              <option value="CLOSED">Resolvidos</option>
            </select>
          </div>

          <div className="mt-6 grid gap-4">
            {filtered.length === 0 ? (
              <div className="rounded-3xl border border-slate-200 bg-slate-50 p-8 text-center">
                <h3 className="text-2xl font-black text-slate-950">Nenhum atendimento neste filtro</h3>
                <p className="mx-auto mt-2 max-w-2xl text-sm font-semibold leading-6 text-slate-500">
                  Quando existir um atendimento desse evento para o operador, ele aparece aqui para resposta
                  ou encaminhamento ao Super Admin.
                </p>
              </div>
            ) : (
              filtered.map((ticket) => (
                <article key={ticket.id} className="rounded-[26px] border border-slate-200 bg-slate-50 p-5">
                  <div className="flex flex-wrap items-start justify-between gap-4">
                    <div>
                      <p className="text-[10px] font-black uppercase tracking-[0.22em] text-blue-600">
                        {ticket.category} • {statusLabel(ticket.status)}
                      </p>
                      <h3 className="mt-2 text-2xl font-black text-slate-950">{ticket.title}</h3>
                      <p className="mt-1 text-sm font-semibold text-slate-500">
                        {ticket.customerName}
                        {ticket.customerEmail ? ` • ${ticket.customerEmail}` : ""}
                        {" • "}
                        {formatDate(ticket.createdAt)}
                      </p>
                    </div>

                    <span
                      className={`rounded-full px-3 py-2 text-xs font-black ${
                        ticket.status === "FORWARDED"
                          ? "bg-purple-100 text-purple-800"
                          : ticket.status === "CLOSED"
                            ? "bg-emerald-100 text-emerald-800"
                            : ticket.status === "ANSWERED"
                              ? "bg-blue-100 text-blue-800"
                              : "bg-amber-100 text-amber-800"
                      }`}
                    >
                      {statusLabel(ticket.status)}
                    </span>
                  </div>

                  <div className="mt-4 rounded-2xl bg-white p-4 text-sm font-semibold leading-6 text-slate-700 ring-1 ring-slate-200">
                    {ticket.message}
                  </div>

                  {ticket.forwardedAt ? (
                    <div className="mt-4 rounded-2xl border border-purple-200 bg-purple-50 p-4 text-sm font-bold text-purple-900">
                      Encaminhado ao Super Admin por {ticket.forwardedBy || "Operador"} em {formatDate(ticket.forwardedAt)}.
                      {ticket.forwardedReason ? <p className="mt-1">Motivo: {ticket.forwardedReason}</p> : null}
                    </div>
                  ) : null}

                  {ticket.replies?.length ? (
                    <div className="mt-4 space-y-2">
                      <p className="text-[10px] font-black uppercase tracking-[0.22em] text-slate-400">
                        Respostas registradas
                      </p>

                      {ticket.replies.map((reply) => (
                        <div key={reply.id} className="rounded-2xl bg-white p-4 ring-1 ring-slate-200">
                          <p className="text-sm font-semibold leading-6 text-slate-700">{reply.message}</p>
                          <p className="mt-2 text-xs font-black text-slate-400">
                            {reply.operatorName || "Operador"} • {formatDate(reply.createdAt)}
                          </p>
                        </div>
                      ))}
                    </div>
                  ) : null}

                  {ticket.status !== "CLOSED" ? (
                    <div className="mt-5 grid gap-4 xl:grid-cols-2">
                      <form onSubmit={(event) => answerTicket(event, ticket.id)} className="rounded-2xl bg-white p-4 ring-1 ring-slate-200">
                        <p className="text-[10px] font-black uppercase tracking-[0.22em] text-blue-600">
                          Responder cliente
                        </p>

                        <textarea
                          value={drafts[ticket.id] || ""}
                          onChange={(event) =>
                            setDrafts((current) => ({
                              ...current,
                              [ticket.id]: event.target.value,
                            }))
                          }
                          placeholder="Digite a resposta para este atendimento..."
                          className="mt-3 min-h-[110px] w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-bold outline-none focus:border-blue-500"
                        />

                        <button
                          type="submit"
                          className="mt-3 h-11 w-full rounded-2xl bg-blue-700 text-sm font-black text-white"
                        >
                          Salvar resposta
                        </button>
                      </form>

                      <div className="rounded-2xl bg-white p-4 ring-1 ring-slate-200">
                        <p className="text-[10px] font-black uppercase tracking-[0.22em] text-purple-600">
                          Problema interno
                        </p>

                        <textarea
                          value={forwardReasons[ticket.id] || ""}
                          onChange={(event) =>
                            setForwardReasons((current) => ({
                              ...current,
                              [ticket.id]: event.target.value,
                            }))
                          }
                          placeholder="Explique o problema interno para o Super Admin..."
                          className="mt-3 min-h-[110px] w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-bold outline-none focus:border-purple-500"
                        />

                        <button
                          type="button"
                          onClick={() => forwardToSuperAdmin(ticket.id)}
                          className="mt-3 h-11 w-full rounded-2xl bg-purple-700 text-sm font-black text-white"
                        >
                          Encaminhar para Super Admin
                        </button>
                      </div>
                    </div>
                  ) : null}

                  {ticket.status !== "CLOSED" ? (
                    <button
                      type="button"
                      onClick={() => closeTicket(ticket.id)}
                      className="mt-4 rounded-2xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-black text-emerald-700"
                    >
                      Marcar como resolvido
                    </button>
                  ) : null}
                </article>
              ))
            )}
          </div>
        </section>
      </section>
    </main>
  );
}

function Metric({ label, value }: { label: string; value: string }) {
  return (
    <article className="rounded-[24px] border border-slate-200 bg-white p-5 shadow-sm">
      <p className="text-[11px] font-black uppercase tracking-[0.2em] text-slate-400">{label}</p>
      <p className="mt-2 text-2xl font-black text-slate-950">{value}</p>
    </article>
  );
}