"use client";
// @ts-nocheck

import { useState } from "react";
import { getStoredAuthUser } from "../../../../lib/auth-client";
import { createSupportTicketReal } from "../../../../lib/support-api-workflow";

type StoredUser = { id?: string; name?: string; email?: string; role?: string };

function fallbackUser(): StoredUser {
  return { id: "operator-local", name: "Operador", email: "operador@local.test", role: "OPERATOR" };
}

function readEvent() {
  if (typeof window === "undefined") return { eventId: "", eventName: "" };
  const params = new URLSearchParams(window.location.search);
  return {
    eventId: params.get("eventId") || localStorage.getItem("operator-selected-event-id") || "",
    eventName: params.get("eventName") || localStorage.getItem("operator-selected-event-name") || "",
  };
}

export default function NewOperatorSupportPage() {
  const event = readEvent();
  const [form, setForm] = useState({
    eventId: event.eventId,
    eventName: event.eventName,
    title: "",
    message: "",
  });
  const [saving, setSaving] = useState(false);

  async function submit() {
    if (!form.message.trim()) {
      alert("Descreva o problema técnico.");
      return;
    }

    setSaving(true);

    try {
      const user = getStoredAuthUser<StoredUser>() || fallbackUser();

      const ticket = await createSupportTicketReal({
        title: form.title || "Chamado técnico do operador",
        category: "Suporte técnico",
        message: form.message,
        priority: "NORMAL" as any,
        sourceType: "OPERATOR",
        targetType: "SUPER_ADMIN" as any,
        currentOwnerType: "SUPER_ADMIN",
        eventId: form.eventId || undefined,
        eventName: form.eventName || undefined,
        operatorName: user.name || "Operador",
        operatorEmail: user.email,
        createdByRole: "OPERATOR",
        createdByName: user.name || "Operador",
        createdByEmail: user.email,
      } as any);

      window.location.href = `/operator/support${ticket?.id ? `?ticket=${ticket.id}` : ""}`;
    } catch (error) {
      alert(error instanceof Error ? error.message : "Não foi possível abrir chamado técnico.");
      setSaving(false);
    }
  }

  return (
    <main className="min-h-screen bg-slate-100 px-4 py-8 text-slate-950">
      <div className="mx-auto max-w-3xl">
        <a href="/operator/support" className="text-sm font-black text-blue-600">← Voltar para suporte</a>

        <section className="mt-4 rounded-[2rem] border border-slate-200 bg-white p-6 shadow-sm">
          <p className="text-xs font-black uppercase tracking-[0.24em] text-blue-600">Chamado técnico</p>
          <h1 className="mt-2 text-3xl font-black">Abrir chamado com Super Admin</h1>
          <p className="mt-2 text-sm font-bold text-slate-500">Use esta página para problemas técnicos do site, check-in, QR Code ou acesso operacional.</p>

          <div className="mt-6 grid gap-3">
            <input value={form.eventId} onChange={(event) => setForm((current) => ({ ...current, eventId: event.target.value }))} className="h-12 rounded-2xl border border-slate-200 bg-slate-50 px-4 text-sm font-bold outline-none" placeholder="ID do evento" />
            <input value={form.eventName} onChange={(event) => setForm((current) => ({ ...current, eventName: event.target.value }))} className="h-12 rounded-2xl border border-slate-200 bg-slate-50 px-4 text-sm font-bold outline-none" placeholder="Nome do evento" />
            <input value={form.title} onChange={(event) => setForm((current) => ({ ...current, title: event.target.value }))} className="h-12 rounded-2xl border border-slate-200 bg-slate-50 px-4 text-sm font-bold outline-none" placeholder="Título do problema" />
            <textarea value={form.message} onChange={(event) => setForm((current) => ({ ...current, message: event.target.value }))} className="min-h-36 rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-bold outline-none" placeholder="Descreva o problema técnico" />
            <button type="button" onClick={submit} disabled={saving} className="rounded-2xl bg-blue-600 px-5 py-4 text-sm font-black text-white disabled:opacity-50">{saving ? "Abrindo..." : "Abrir chamado técnico"}</button>
          </div>
        </section>
      </div>
    </main>
  );
}