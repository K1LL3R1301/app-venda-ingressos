"use client";
// @ts-nocheck

import { useEffect, useMemo, useState } from "react";
import { getStoredAuthUser } from "../../../lib/auth-client";
import {
  addSupportMessageReal,
  forwardSupportToSuperAdminReal,
  getVisibleSupportTicketsReal,
  resolveSupportTicketReal,
  seedSupportTicketForEventReal,
} from "../../../lib/support-api-workflow";

type Ticket = any;
type StoredUser = { id?: string; name?: string; email?: string; role?: string };

const REPLY_TARGETS = [
  ["PRODUCER", "Produtor/Admin"],
  ["CUSTOMER", "Cliente"],
  ["SUPER_ADMIN", "Suporte Site"],
  ["ALL", "Todos"],
] as const;

function fallbackUser(): StoredUser {
  return { id: "operator-local", name: "Operador", email: "operador@local.test", role: "OPERATOR" };
}

function eventInfo() {
  if (typeof window === "undefined") return { eventId: "", eventName: "Evento operacional" };
  const params = new URLSearchParams(window.location.search);
  return {
    eventId: params.get("eventId") || localStorage.getItem("operator-selected-event-id") || "",
    eventName: params.get("eventName") || localStorage.getItem("operator-selected-event-name") || "Evento operacional",
  };
}

function label(value?: string) {
  const labels: Record<string, string> = {
    CUSTOMER: "Cliente",
    PRODUCER: "Produtor/Admin",
    OPERATOR: "Operador",
    SUPER_ADMIN: "Suporte Site",
    ALL: "Todos",
    OPEN: "Aberto",
    IN_PROGRESS: "Em andamento",
    FORWARDED_TO_SUPER_ADMIN: "Com Suporte Site",
    RETURNED_TO_OPERATOR: "Devolvido ao operador",
    RETURNED_TO_PRODUCER: "Devolvido ao produtor",
    RESOLVED: "Resolvido",
    CLOSED: "Fechado",
  };
  return labels[String(value || "").toUpperCase()] || String(value || "Sistema");
}

function when(value?: string) {
  if (!value) return "";
  try {
    return new Intl.DateTimeFormat("pt-BR", { day: "2-digit", month: "2-digit", hour: "2-digit", minute: "2-digit" }).format(new Date(value));
  } catch {
    return String(value);
  }
}

function messages(ticket?: Ticket) {
  return Array.isArray(ticket?.messages) ? ticket.messages : [];
}

function isMine(message: any) {
  return String(message?.authorRole || "").toUpperCase() === "OPERATOR";
}

function lastMessage(ticket: Ticket) {
  const list = messages(ticket);
  return list[list.length - 1]?.text || ticket?.title || "Sem mensagens";
}

function CardList({ tickets, selectedId, onSelect }: { tickets: Ticket[]; selectedId?: string; onSelect: (id: string) => void }) {
  if (!tickets.length) {
    return <div className="rounded-3xl border border-dashed border-slate-200 bg-white p-8 text-center text-sm font-black text-slate-600">Nenhum chamado encontrado.</div>;
  }

  return (
    <div className="space-y-3">
      {tickets.map((ticket) => (
        <button key={ticket.id} type="button" onClick={() => onSelect(ticket.id)} className={`w-full rounded-3xl border p-4 text-left transition ${selectedId === ticket.id ? "border-blue-400 bg-blue-50 shadow-sm" : "border-slate-200 bg-white hover:border-blue-200"}`}>
          <p className="truncate text-sm font-black text-slate-950">{ticket.title || "Chamado"}</p>
          <p className="mt-2 line-clamp-2 text-xs font-bold text-slate-500">{lastMessage(ticket)}</p>
          <p className="mt-3 text-[10px] font-black uppercase tracking-[0.14em] text-slate-400">{label(ticket.status)}</p>
        </button>
      ))}
    </div>
  );
}

function Bubble({ message }: { message: any }) {
  const mine = isMine(message);
  const kind = String(message?.kind || "MESSAGE").toUpperCase();

  return (
    <div className={`flex ${mine ? "justify-end" : "justify-start"}`}>
      <div className={`max-w-[78%] rounded-3xl px-4 py-3 shadow-sm ${mine ? "rounded-br-md bg-blue-600 text-white" : kind === "FORWARD" ? "rounded-bl-md border border-amber-200 bg-amber-50 text-amber-950" : "rounded-bl-md bg-white text-slate-900"}`}>
        <p className={`mb-1 text-[10px] font-black uppercase tracking-[0.16em] ${mine ? "text-blue-100" : "text-slate-400"}`}>Tipo de conta: {label(message.authorRole)}</p>
        <p className="whitespace-pre-wrap text-sm font-bold leading-relaxed">{message.text}</p>
        <p className={`mt-2 text-right text-[10px] font-bold ${mine ? "text-blue-100" : "text-slate-400"}`}>{when(message.createdAt)}</p>
      </div>
    </div>
  );
}

export default function OperatorSupportPage() {
  const [user, setUser] = useState<StoredUser | null>(null);
  const [info, setInfo] = useState({ eventId: "", eventName: "Evento operacional" });
  const [tickets, setTickets] = useState<Ticket[]>([]);
  const [selectedId, setSelectedId] = useState("");
  const [reply, setReply] = useState("");
  const [forwardReason, setForwardReason] = useState("");
  const [forwardOpen, setForwardOpen] = useState(false);

  const selectedTicket = useMemo(() => tickets.find((ticket) => ticket.id === selectedId) || null, [tickets, selectedId]);

  function actor() {
    const current = user || fallbackUser();
    return { role: "OPERATOR" as const, name: current.name || "Operador", email: current.email };
  }

  function selectTicket(id: string) {
    setSelectedId(id);
    if (typeof window !== "undefined") {
      const url = new URL(window.location.href);
      url.searchParams.set("ticket", id);
      window.history.replaceState(null, "", url.toString());
    }
  }

  async function reload(nextInfo = info) {
    const current = getStoredAuthUser<StoredUser>() || fallbackUser();
    setUser(current);

    await seedSupportTicketForEventReal({
      eventId: nextInfo.eventId || undefined,
      eventName: nextInfo.eventName,
      operatorName: current.name || "Operador",
      operatorEmail: current.email,
    });

    const data = await getVisibleSupportTicketsReal({ role: "OPERATOR", userEmail: current.email, eventId: nextInfo.eventId || null });
    setTickets(data);

    const ticketFromUrl = typeof window !== "undefined" ? new URLSearchParams(window.location.search).get("ticket") : "";
    const nextId = ticketFromUrl || selectedId || data[0]?.id || "";
    if (nextId) setSelectedId(nextId);
  }

  useEffect(() => {
    const nextInfo = eventInfo();
    setInfo(nextInfo);
    void reload(nextInfo);

    const onUpdate = () => void reload(nextInfo);
    window.addEventListener("support-workflow:update", onUpdate);
    return () => window.removeEventListener("support-workflow:update", onUpdate);
  }, []);

  async function sendReply() {
    if (!selectedTicket || !reply.trim()) return;
    await addSupportMessageReal(selectedTicket.id, actor(), reply, { targetType: "ALL" as any });
    setReply("");
    await reload();
  }

  async function forwardToSuper() {
    if (!selectedTicket || !forwardReason.trim()) {
      alert("Informe a justificativa do encaminhamento.");
      return;
    }

    await forwardSupportToSuperAdminReal(selectedTicket.id, actor(), forwardReason);
    setForwardReason("");
    setForwardOpen(false);
    await reload();
  }

  async function closeTicket() {
    if (!selectedTicket) return;
    await resolveSupportTicketReal(selectedTicket.id, actor(), "Chamado finalizado pelo operador.", { targetType: "ALL" as any });
    await reload();
  }

  return (
    <main className="min-h-screen bg-slate-100 px-4 py-8 text-slate-950">
      <div className="mx-auto max-w-7xl">
        <header className="rounded-[2rem] bg-slate-950 p-6 text-white shadow-sm">
          <div className="flex flex-wrap items-center justify-between gap-4">
            <div>
              <p className="text-xs font-black uppercase tracking-[0.24em] text-blue-300">Suporte operacional</p>
              <h1 className="mt-2 text-3xl font-black">Chat de suporte do operador</h1>
              <p className="mt-2 max-w-3xl text-sm font-bold text-slate-300">Evento: {info.eventName || "Não informado"}</p>
            </div>
            <a href={`/operator/support/new?eventId=${encodeURIComponent(info.eventId || "")}&eventName=${encodeURIComponent(info.eventName || "")}`} className="rounded-2xl bg-blue-600 px-5 py-3 text-sm font-black text-white">Abrir técnico</a>
          </div>
        </header>

        <section className="mt-6 grid h-[calc(100vh-230px)] min-h-[620px] gap-5 lg:grid-cols-[360px_1fr]">
          <aside className="overflow-hidden rounded-[2rem] border border-slate-200 bg-white p-4 shadow-sm">
            <div className="mb-4 flex items-center justify-between">
              <div>
                <p className="text-xs font-black uppercase tracking-[0.18em] text-slate-400">Fichas</p>
                <h2 className="text-xl font-black">Chamados</h2>
              </div>
              <span className="rounded-full bg-slate-100 px-3 py-1 text-xs font-black text-slate-500">{tickets.length}</span>
            </div>
            <div className="h-[calc(100%-62px)] overflow-y-auto pr-1">
              <CardList tickets={tickets} selectedId={selectedTicket?.id} onSelect={selectTicket} />
            </div>
          </aside>

          <section className="flex min-h-0 flex-col overflow-hidden rounded-[2rem] border border-slate-200 bg-[#e9f3ee] shadow-sm">
            {selectedTicket ? (
              <>
                <div className="flex flex-wrap items-center justify-between gap-3 border-b border-slate-200 bg-white px-5 py-4">
                  <div>
                    <h2 className="text-lg font-black">{selectedTicket.title || "Chamado"}</h2>
                    <p className="text-xs font-bold text-slate-500">{selectedTicket.protocol || selectedTicket.id}</p>
                  </div>
                  <div className="flex flex-wrap gap-2">
                    <button type="button" onClick={() => setForwardOpen((current) => !current)} className="rounded-2xl bg-amber-500 px-4 py-2 text-xs font-black text-white">Encaminhar Suporte Site</button>
                    <button type="button" onClick={closeTicket} className="rounded-2xl bg-slate-950 px-4 py-2 text-xs font-black text-white">Resolver chamado</button>
                  </div>
                </div>

                {forwardOpen ? (
                  <div className="border-b border-amber-200 bg-amber-50 p-4">
                    <p className="text-xs font-black uppercase tracking-[0.18em] text-amber-700">Justificativa para o Suporte Site</p>
                    <div className="mt-2 flex gap-2">
                      <textarea value={forwardReason} onChange={(event) => setForwardReason(event.target.value)} className="min-h-20 flex-1 rounded-2xl border border-amber-200 bg-white px-4 py-3 text-sm font-bold outline-none" placeholder="Explique brevemente por que este chamado precisa do Super Admin..." />
                      <button type="button" onClick={forwardToSuper} className="rounded-2xl bg-amber-600 px-5 py-3 text-sm font-black text-white">Enviar</button>
                    </div>
                  </div>
                ) : null}

                <div className="flex-1 space-y-3 overflow-y-auto p-5">
                  {messages(selectedTicket).map((message: any) => <Bubble key={message.id} message={message} />)}
                </div>

                <div className="border-t border-slate-200 bg-white p-4">
<div className="flex gap-2">
                    <textarea value={reply} onChange={(event) => setReply(event.target.value)} className="min-h-12 flex-1 rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-bold outline-none focus:border-blue-500" placeholder="Digite uma mensagem..." onKeyDown={(event) => { if (event.key === "Enter" && !event.shiftKey) { event.preventDefault(); void sendReply(); } }} />
                    <button type="button" onClick={sendReply} className="rounded-2xl bg-blue-600 px-6 text-sm font-black text-white">Enviar</button>
                  </div>
                </div>
              </>
            ) : (
              <div className="grid flex-1 place-items-center p-10 text-center">
                <div>
                  <p className="text-2xl font-black text-slate-700">Selecione uma ficha</p>
                  <p className="mt-2 text-sm font-bold text-slate-500">Ao clicar em uma ficha, o chat abre aqui.</p>
                </div>
              </div>
            )}
          </section>
        </section>
      </div>
    </main>
  );
}