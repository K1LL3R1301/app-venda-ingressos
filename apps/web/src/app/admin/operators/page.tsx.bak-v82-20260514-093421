"use client";

import Link from "next/link";
import { useEffect, useMemo, useState } from "react";

type EventItem = {
  id: string;
  name?: string | null;
  title?: string | null;
  eventDate?: string | null;
  startDate?: string | null;
};

type Assignment = {
  id: string;
  protocol: string;
  status: string;
  invitationMessage?: string | null;
  notes?: string | null;
  operatorName?: string | null;
  operatorEmail?: string | null;
  operatorCpf?: string | null;
  eventTitle?: string | null;
  eventDate?: string | null;
  invitedAt?: string | null;
  acceptedAt?: string | null;
  assignedAt?: string | null;
  operator?: {
    id: string;
    name: string;
    email: string;
    cpf?: string | null;
    role: string;
  } | null;
  event?: {
    id: string;
    name: string;
    eventDate?: string | null;
  } | null;
};

type OperatorReport = {
  assignment: Assignment;
  eventHasPassed: boolean;
  summary: {
    ticketsTotal: number;
    ticketsUsed: number;
    operatorCheckins: number;
    supportThreads: number;
    supportThreadsClosed: number;
    supportMessages: number;
    paidOrders: number;
    paidRevenue: number;
  };
  checkins: Array<{
    id: string;
    checkedAt: string;
    ticketCode: string;
    holderName?: string | null;
    holderCpf?: string | null;
    ticketTypeName: string;
  }>;
  supportThreads: Array<{
    id: string;
    subject: string;
    status: string;
    customerName?: string | null;
    customerEmail: string;
    messagesCount: number;
    updatedAt: string;
  }>;
};

type AssignForm = {
  eventId: string;
  notes: string;
  canValidateTickets: boolean;
  canAnswerSupport: boolean;
};

const API_BASE_URL =
  process.env.NEXT_PUBLIC_API_URL?.replace(/\/$/, "") || "http://localhost:3001/v1";

function token() {
  return typeof window === "undefined" ? "" : localStorage.getItem("token") || "";
}

function formatDate(value?: string | null) {
  if (!value) return "-";
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return value;
  return date.toLocaleString("pt-BR", {
    day: "2-digit",
    month: "short",
    year: "numeric",
    hour: "2-digit",
    minute: "2-digit",
  });
}

function money(value?: number | null) {
  return new Intl.NumberFormat("pt-BR", {
    style: "currency",
    currency: "BRL",
  }).format(Number(value || 0));
}

function cpfDigits(value: string) {
  return value.replace(/\D/g, "").slice(0, 11);
}

function maskCpf(value: string) {
  const cpf = cpfDigits(value);
  return cpf
    .replace(/^(\d{3})(\d)/, "$1.$2")
    .replace(/^(\d{3})\.(\d{3})(\d)/, "$1.$2.$3")
    .replace(/\.(\d{3})(\d)/, ".$1-$2");
}

function eventName(event: EventItem) {
  return event.name || event.title || "Evento sem nome";
}

function personName(assignment: Assignment) {
  return assignment.operator?.name || assignment.operatorName || "Pessoa sem nome";
}

function personEmail(assignment: Assignment) {
  return assignment.operator?.email || assignment.operatorEmail || "-";
}

function personCpf(assignment: Assignment) {
  return assignment.operator?.cpf || assignment.operatorCpf || "-";
}

function statusLabel(status: string) {
  const normalized = status.toUpperCase();

  const labels: Record<string, string> = {
    INVITED: "Convite enviado",
    ACCEPTED: "Aceitou convite",
    ACTIVE: "Atribuído ao evento",
    DECLINED: "Recusado",
    REVOKED: "Revogado",
  };

  return labels[normalized] || status;
}

function Stat({
  label,
  value,
  helper,
}: {
  label: string;
  value: string | number;
  helper?: string;
}) {
  return (
    <div className="rounded-[24px] border border-slate-200 bg-white p-5 shadow-sm">
      <p className="text-[11px] font-black uppercase tracking-[0.22em] text-slate-400">
        {label}
      </p>
      <p className="mt-3 text-3xl font-black text-slate-950">{value}</p>
      {helper ? <p className="mt-1 text-xs font-semibold text-slate-500">{helper}</p> : null}
    </div>
  );
}

export default function AdminOperatorsPage() {
  const [cpf, setCpf] = useState("");
  const [message, setMessage] = useState("");
  const [events, setEvents] = useState<EventItem[]>([]);
  const [assignments, setAssignments] = useState<Assignment[]>([]);
  const [assignForms, setAssignForms] = useState<Record<string, AssignForm>>({});
  const [report, setReport] = useState<OperatorReport | null>(null);
  const [loading, setLoading] = useState(true);
  const [savingInvite, setSavingInvite] = useState(false);
  const [savingAssignmentId, setSavingAssignmentId] = useState<string | null>(null);

  async function load() {
    const auth = token();

    if (!auth || auth === "undefined") {
      window.location.href = "/login";
      return;
    }

    setLoading(true);

    try {
      const [eventsRes, assignmentsRes] = await Promise.all([
        fetch(`${API_BASE_URL}/events`, {
          headers: { Authorization: `Bearer ${auth}` },
        }),
        fetch(`${API_BASE_URL}/operator-assignments`, {
          headers: { Authorization: `Bearer ${auth}` },
        }),
      ]);

      const eventsJson = await eventsRes.json().catch(() => []);
      const assignmentsJson = await assignmentsRes.json().catch(() => []);

      setEvents(Array.isArray(eventsJson) ? eventsJson : []);
      setAssignments(Array.isArray(assignmentsJson) ? assignmentsJson : []);
    } finally {
      setLoading(false);
    }
  }

  useEffect(() => {
    load();
  }, []);

  const sortedEvents = useMemo(() => {
    return [...events].sort((a, b) => {
      const aDate = new Date(a.eventDate || a.startDate || 0).getTime();
      const bDate = new Date(b.eventDate || b.startDate || 0).getTime();
      return bDate - aDate;
    });
  }, [events]);

  const invited = assignments.filter((assignment) => assignment.status === "INVITED");
  const accepted = assignments.filter((assignment) => assignment.status === "ACCEPTED");
  const active = assignments.filter((assignment) => assignment.status === "ACTIVE");
  const declined = assignments.filter((assignment) => assignment.status === "DECLINED");

  function getAssignForm(id: string): AssignForm {
    return (
      assignForms[id] || {
        eventId: "",
        notes: "",
        canValidateTickets: true,
        canAnswerSupport: true,
      }
    );
  }

  function setAssignForm(id: string, next: Partial<AssignForm>) {
    setAssignForms((current) => ({
      ...current,
      [id]: {
        ...getAssignForm(id),
        ...next,
      },
    }));
  }

  async function inviteOperator(event: React.FormEvent<HTMLFormElement>) {
    event.preventDefault();

    const auth = token();

    if (!auth) {
      window.location.href = "/login";
      return;
    }

    if (cpfDigits(cpf).length !== 11) {
      alert("Informe um CPF válido com 11 dígitos.");
      return;
    }

    setSavingInvite(true);

    try {
      const response = await fetch(`${API_BASE_URL}/operator-assignments/invite`, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          Authorization: `Bearer ${auth}`,
        },
        body: JSON.stringify({
          cpf: cpfDigits(cpf),
          message,
        }),
      });

      const result = await response.json().catch(() => null);

      if (!response.ok) {
        alert(typeof result?.message === "string" ? result.message : "Erro ao enviar convite.");
        return;
      }

      setCpf("");
      setMessage("");
      await load();
      alert(
        "Convite enviado. A pessoa precisa aceitar em /operator-invitations antes de você atribuir um evento.",
      );
    } finally {
      setSavingInvite(false);
    }
  }

  async function assignEvent(assignmentId: string) {
    const auth = token();
    const form = getAssignForm(assignmentId);

    if (!form.eventId) {
      alert("Selecione o evento.");
      return;
    }

    setSavingAssignmentId(assignmentId);

    try {
      const response = await fetch(`${API_BASE_URL}/operator-assignments/${assignmentId}/assign`, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          Authorization: `Bearer ${auth}`,
        },
        body: JSON.stringify(form),
      });

      const result = await response.json().catch(() => null);

      if (!response.ok) {
        alert(typeof result?.message === "string" ? result.message : "Erro ao atribuir evento.");
        return;
      }

      setAssignForms((current) => {
        const next = { ...current };
        delete next[assignmentId];
        return next;
      });

      await load();
      alert("Operador atribuído ao evento.");
    } finally {
      setSavingAssignmentId(null);
    }
  }

  async function loadReport(assignmentId: string) {
    const auth = token();

    const response = await fetch(`${API_BASE_URL}/operator-assignments/${assignmentId}/report`, {
      headers: { Authorization: `Bearer ${auth}` },
    });

    const result = await response.json().catch(() => null);

    if (!response.ok) {
      alert(typeof result?.message === "string" ? result.message : "Erro ao carregar relatório.");
      return;
    }

    setReport(result);
  }

  return (
    <main className="mx-auto max-w-[1500px] space-y-6 px-4 py-6">
      <section
        className="relative overflow-hidden rounded-[34px] text-white shadow-sm"
        style={{
          background:
            "linear-gradient(135deg, #ff6900 0%, #7c2d12 18%, #111827 50%, #020617 100%)",
        }}
      >
        <div className="absolute -right-24 -top-24 h-72 w-72 rounded-full bg-orange-400/25 blur-3xl" />
        <div className="absolute -bottom-24 -left-24 h-72 w-72 rounded-full bg-black/60 blur-3xl" />
        <div className="absolute inset-0 bg-black/25" />

        <div className="relative z-10 grid gap-6 p-7 lg:grid-cols-[1.1fr_0.9fr] lg:p-9">
          <div>
            <p className="text-[11px] font-black uppercase tracking-[0.34em] text-orange-200">
              Operadores de evento
            </p>
            <h1 className="mt-4 max-w-4xl text-4xl font-black leading-tight md:text-5xl">
              Convide, aguarde o aceite e só depois atribua ao evento.
            </h1>
            <p className="mt-4 max-w-3xl text-sm font-semibold leading-7 text-white/80">
              O admin envia o convite por CPF. A pessoa aceita no painel dela. Depois aparece
              o card para você escolher o evento e registrar as observações finais.
            </p>
          </div>

          <div className="grid gap-3 sm:grid-cols-4">
            <div className="rounded-3xl border border-white/10 bg-white/10 p-5">
              <p className="text-[11px] font-black uppercase tracking-[0.22em] text-white/55">
                Enviados
              </p>
              <p className="mt-3 text-3xl font-black">{invited.length}</p>
            </div>
            <div className="rounded-3xl border border-white/10 bg-white/10 p-5">
              <p className="text-[11px] font-black uppercase tracking-[0.22em] text-white/55">
                Aceitos
              </p>
              <p className="mt-3 text-3xl font-black">{accepted.length}</p>
            </div>
            <div className="rounded-3xl border border-white/10 bg-white/10 p-5">
              <p className="text-[11px] font-black uppercase tracking-[0.22em] text-white/55">
                Ativos
              </p>
              <p className="mt-3 text-3xl font-black">{active.length}</p>
            </div>
            <div className="rounded-3xl border border-white/10 bg-white/10 p-5">
              <p className="text-[11px] font-black uppercase tracking-[0.22em] text-white/55">
                Recusados
              </p>
              <p className="mt-3 text-3xl font-black">{declined.length}</p>
            </div>
          </div>
        </div>
      </section>

      <section className="grid gap-6 xl:grid-cols-[420px_1fr]">
        <form
          onSubmit={inviteOperator}
          className="rounded-[30px] border border-slate-200 bg-white p-6 shadow-sm"
        >
          <p className="text-[11px] font-black uppercase tracking-[0.22em] text-orange-600">
            Etapa 1
          </p>
          <h2 className="mt-2 text-2xl font-black text-slate-950">Convidar por CPF</h2>
          <p className="mt-2 text-sm leading-6 text-slate-500">
            A pessoa precisa ter uma conta customer. Nesta etapa você ainda não atribui evento.
          </p>

          <div className="mt-6 space-y-4">
            <label className="block">
              <span className="text-sm font-black text-slate-700">CPF da conta customer</span>
              <input
                value={cpf}
                onChange={(event) => setCpf(maskCpf(event.target.value))}
                placeholder="000.000.000-00"
                className="mt-2 h-12 w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 text-sm font-semibold outline-none transition focus:border-orange-400 focus:bg-white"
              />
            </label>

            <label className="block">
              <span className="text-sm font-black text-slate-700">Mensagem do convite</span>
              <textarea
                value={message}
                onChange={(event) => setMessage(event.target.value)}
                rows={4}
                placeholder="Ex: você foi convidado para trabalhar como operador nos eventos da plataforma."
                className="mt-2 w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-semibold outline-none transition focus:border-orange-400 focus:bg-white"
              />
            </label>

            <button
              type="submit"
              disabled={savingInvite}
              className="w-full rounded-2xl bg-slate-950 px-5 py-4 text-sm font-black text-white transition hover:bg-slate-800 disabled:cursor-not-allowed disabled:opacity-60"
            >
              {savingInvite ? "Enviando convite..." : "Enviar convite"}
            </button>

            <div className="rounded-2xl bg-orange-50 p-4 text-xs font-bold leading-5 text-orange-800">
              A pessoa aceita em: <strong>/operator-invitations</strong>. Depois do aceite,
              ela aparece em "Aceitos aguardando evento".
            </div>
          </div>
        </form>

        <section className="space-y-6">
          <section className="rounded-[30px] border border-slate-200 bg-white p-6 shadow-sm">
            <p className="text-[11px] font-black uppercase tracking-[0.22em] text-orange-600">
              Etapa 2
            </p>
            <h2 className="mt-2 text-2xl font-black text-slate-950">
              Aceitos aguardando evento
            </h2>
            <p className="mt-2 text-sm text-slate-500">
              Depois que a pessoa aceita o convite, o card dela aparece aqui para atribuir o evento.
            </p>

            <div className="mt-6 grid gap-4 xl:grid-cols-2">
              {loading ? (
                <div className="col-span-full rounded-3xl bg-slate-50 p-6 text-sm font-bold text-slate-500">
                  Carregando convites...
                </div>
              ) : accepted.length === 0 ? (
                <div className="col-span-full rounded-3xl bg-slate-50 p-8 text-center">
                  <p className="font-black text-slate-950">Nenhum aceite aguardando evento.</p>
                  <p className="mt-2 text-sm text-slate-500">
                    Envie um convite e aguarde a pessoa aceitar.
                  </p>
                </div>
              ) : (
                accepted.map((assignment) => {
                  const form = getAssignForm(assignment.id);

                  return (
                    <article
                      key={assignment.id}
                      className="rounded-[26px] border border-orange-200 bg-orange-50 p-5"
                    >
                      <div className="flex items-start justify-between gap-3">
                        <div>
                          <p className="text-[11px] font-black uppercase tracking-[0.18em] text-orange-700">
                            Aceitou convite
                          </p>
                          <h3 className="mt-2 text-xl font-black text-slate-950">
                            {personName(assignment)}
                          </h3>
                          <p className="mt-1 text-sm font-semibold text-slate-600">
                            {personEmail(assignment)}
                          </p>
                          <p className="mt-1 text-xs font-bold text-slate-500">
                            CPF: {personCpf(assignment)}
                          </p>
                        </div>
                        <span className="rounded-full bg-white px-3 py-1 text-xs font-black text-orange-700">
                          {assignment.protocol}
                        </span>
                      </div>

                      <div className="mt-5 space-y-3">
                        <label className="block">
                          <span className="text-sm font-black text-slate-700">Evento</span>
                          <select
                            value={form.eventId}
                            onChange={(event) =>
                              setAssignForm(assignment.id, { eventId: event.target.value })
                            }
                            className="mt-2 h-12 w-full rounded-2xl border border-orange-200 bg-white px-4 text-sm font-semibold outline-none transition focus:border-orange-400"
                          >
                            <option value="">Selecione um evento</option>
                            {sortedEvents.map((event) => (
                              <option key={event.id} value={event.id}>
                                {eventName(event)} • {formatDate(event.eventDate || event.startDate)}
                              </option>
                            ))}
                          </select>
                        </label>

                        <div className="grid gap-3 sm:grid-cols-2">
                          <label className="flex items-center gap-3 rounded-2xl border border-orange-200 bg-white p-4 text-sm font-bold text-slate-700">
                            <input
                              type="checkbox"
                              checked={form.canValidateTickets}
                              onChange={(event) =>
                                setAssignForm(assignment.id, {
                                  canValidateTickets: event.target.checked,
                                })
                              }
                            />
                            Validar ingressos
                          </label>
                          <label className="flex items-center gap-3 rounded-2xl border border-orange-200 bg-white p-4 text-sm font-bold text-slate-700">
                            <input
                              type="checkbox"
                              checked={form.canAnswerSupport}
                              onChange={(event) =>
                                setAssignForm(assignment.id, {
                                  canAnswerSupport: event.target.checked,
                                })
                              }
                            />
                            Atender chats
                          </label>
                        </div>

                        <label className="block">
                          <span className="text-sm font-black text-slate-700">
                            Observações finais
                          </span>
                          <textarea
                            value={form.notes}
                            onChange={(event) =>
                              setAssignForm(assignment.id, { notes: event.target.value })
                            }
                            rows={3}
                            placeholder="Ex: portaria principal, turno da noite, atendimento VIP."
                            className="mt-2 w-full rounded-2xl border border-orange-200 bg-white px-4 py-3 text-sm font-semibold outline-none transition focus:border-orange-400"
                          />
                        </label>

                        <button
                          type="button"
                          onClick={() => assignEvent(assignment.id)}
                          disabled={savingAssignmentId === assignment.id}
                          className="w-full rounded-2xl bg-slate-950 px-5 py-4 text-sm font-black text-white transition hover:bg-slate-800 disabled:cursor-not-allowed disabled:opacity-60"
                        >
                          {savingAssignmentId === assignment.id
                            ? "Atribuindo..."
                            : "Atribuir ao evento"}
                        </button>
                      </div>
                    </article>
                  );
                })
              )}
            </div>
          </section>

          <section className="rounded-[30px] border border-slate-200 bg-white p-6 shadow-sm">
            <p className="text-[11px] font-black uppercase tracking-[0.22em] text-orange-600">
              Convites enviados
            </p>
            <h2 className="mt-2 text-2xl font-black text-slate-950">
              Aguardando aceite
            </h2>

            <div className="mt-5 grid gap-3">
              {invited.length === 0 ? (
                <p className="rounded-2xl bg-slate-50 p-5 text-sm font-semibold text-slate-500">
                  Nenhum convite pendente.
                </p>
              ) : (
                invited.map((assignment) => (
                  <div
                    key={assignment.id}
                    className="flex flex-col gap-2 rounded-2xl border border-slate-200 bg-slate-50 p-4 md:flex-row md:items-center md:justify-between"
                  >
                    <div>
                      <p className="font-black text-slate-950">{personName(assignment)}</p>
                      <p className="text-xs font-semibold text-slate-500">
                        {personEmail(assignment)} • CPF: {personCpf(assignment)}
                      </p>
                    </div>
                    <div className="text-xs font-black text-slate-500">
                      {statusLabel(assignment.status)} • {formatDate(assignment.invitedAt)}
                    </div>
                  </div>
                ))
              )}
            </div>
          </section>
        </section>
      </section>

      <section className="rounded-[30px] border border-slate-200 bg-white p-6 shadow-sm">
        <div className="flex flex-col gap-3 md:flex-row md:items-start md:justify-between">
          <div>
            <p className="text-[11px] font-black uppercase tracking-[0.22em] text-orange-600">
              Etapa 3
            </p>
            <h2 className="mt-2 text-2xl font-black text-slate-950">
              Operadores atribuídos
            </h2>
            <p className="mt-2 text-sm text-slate-500">
              Aqui ficam os operadores já vinculados a um evento e o relatório pós-evento.
            </p>
          </div>

          <Link
            href="/admin/dashboard"
            className="rounded-2xl border border-slate-200 bg-white px-5 py-3 text-sm font-black text-slate-700 transition hover:bg-slate-50"
          >
            Voltar ao painel
          </Link>
        </div>

        <div className="mt-6 overflow-x-auto">
          {active.length === 0 ? (
            <div className="rounded-3xl bg-slate-50 p-8 text-center">
              <p className="font-black text-slate-950">Nenhum operador atribuído.</p>
              <p className="mt-2 text-sm text-slate-500">
                Atribua um evento depois que a pessoa aceitar o convite.
              </p>
            </div>
          ) : (
            <table className="w-full min-w-[960px] border-collapse text-sm">
              <thead>
                <tr className="border-b border-slate-200 bg-slate-50 text-left text-[11px] font-black uppercase tracking-[0.16em] text-slate-500">
                  <th className="px-4 py-3">Operador</th>
                  <th className="px-4 py-3">Evento</th>
                  <th className="px-4 py-3">Observações</th>
                  <th className="px-4 py-3">Status</th>
                  <th className="px-4 py-3 text-right">Relatório</th>
                </tr>
              </thead>
              <tbody>
                {active.map((assignment) => {
                  const eventDate = assignment.eventDate || assignment.event?.eventDate;
                  const passed = eventDate ? new Date(eventDate).getTime() < Date.now() : false;

                  return (
                    <tr key={assignment.id} className="border-b border-slate-100">
                      <td className="px-4 py-4">
                        <p className="font-black text-slate-950">{personName(assignment)}</p>
                        <p className="mt-1 text-xs text-slate-500">{personEmail(assignment)}</p>
                        <p className="mt-1 text-xs text-slate-400">
                          CPF: {personCpf(assignment)}
                        </p>
                      </td>
                      <td className="px-4 py-4">
                        <p className="font-bold text-slate-950">
                          {assignment.event?.name || assignment.eventTitle || "-"}
                        </p>
                        <p className="mt-1 text-xs text-slate-500">{formatDate(eventDate)}</p>
                        {passed ? (
                          <span className="mt-2 inline-flex rounded-full bg-orange-50 px-3 py-1 text-xs font-black text-orange-700">
                            Pós-evento
                          </span>
                        ) : null}
                      </td>
                      <td className="max-w-[280px] px-4 py-4 text-xs font-semibold leading-5 text-slate-500">
                        {assignment.notes || "-"}
                      </td>
                      <td className="px-4 py-4">
                        <span className="rounded-full bg-emerald-50 px-3 py-1 text-xs font-black text-emerald-700">
                          {statusLabel(assignment.status)}
                        </span>
                      </td>
                      <td className="px-4 py-4 text-right">
                        <button
                          type="button"
                          onClick={() => loadReport(assignment.id)}
                          className="rounded-2xl bg-slate-950 px-4 py-3 text-xs font-black text-white transition hover:bg-slate-800"
                        >
                          Ver relatório
                        </button>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          )}
        </div>
      </section>

      {report ? (
        <section className="rounded-[30px] border border-slate-200 bg-white p-6 shadow-sm">
          <div className="flex flex-col gap-3 md:flex-row md:items-start md:justify-between">
            <div>
              <p className="text-[11px] font-black uppercase tracking-[0.22em] text-orange-600">
                Relatório do operador
              </p>
              <h2 className="mt-2 text-2xl font-black text-slate-950">
                {personName(report.assignment)}
              </h2>
              <p className="mt-2 text-sm text-slate-500">
                Evento: {report.assignment.event?.name || report.assignment.eventTitle} •{" "}
                {report.eventHasPassed ? "pós-evento" : "evento em andamento ou futuro"}
              </p>
            </div>
            <button
              type="button"
              onClick={() => setReport(null)}
              className="rounded-2xl border border-slate-200 bg-white px-5 py-3 text-sm font-black text-slate-700 transition hover:bg-slate-50"
            >
              Fechar relatório
            </button>
          </div>

          <div className="mt-6 grid gap-4 md:grid-cols-2 xl:grid-cols-4">
            <Stat label="Ingressos do evento" value={report.summary.ticketsTotal} helper="Total emitido/encontrado" />
            <Stat label="Passados no evento" value={report.summary.ticketsUsed} helper="Total geral de ingressos usados" />
            <Stat label="Passados por operador" value={report.summary.operatorCheckins} helper="Check-ins deste operador" />
            <Stat label="Chats atendidos" value={report.summary.supportThreadsClosed} helper={`${report.summary.supportThreads} chat(s) atribuídos`} />
            <Stat label="Mensagens" value={report.summary.supportMessages} helper="Mensagens nos chats" />
            <Stat label="Pedidos pagos" value={report.summary.paidOrders} helper="Pedidos pagos do evento" />
            <Stat label="Receita paga" value={money(report.summary.paidRevenue)} helper="Receita do evento" />
            <Stat label="Status" value={report.eventHasPassed ? "Pós-evento" : "Aberto"} helper="Relatório sempre disponível" />
          </div>

          <div className="mt-7 grid gap-6 xl:grid-cols-2">
            <div className="rounded-[24px] border border-slate-200 bg-slate-50 p-5">
              <h3 className="text-xl font-black text-slate-950">Últimos ingressos passados</h3>
              <div className="mt-4 max-h-[420px] space-y-3 overflow-auto">
                {report.checkins.length === 0 ? (
                  <p className="text-sm font-semibold text-slate-500">
                    Nenhum check-in atribuído a este operador ainda.
                  </p>
                ) : (
                  report.checkins.map((checkin) => (
                    <div key={checkin.id} className="rounded-2xl bg-white p-4 shadow-sm">
                      <p className="font-black text-slate-950">{checkin.ticketTypeName}</p>
                      <p className="mt-1 text-xs text-slate-500">
                        Código: {checkin.ticketCode} • {formatDate(checkin.checkedAt)}
                      </p>
                      <p className="mt-1 text-xs text-slate-500">
                        Titular: {checkin.holderName || "-"} • CPF: {checkin.holderCpf || "-"}
                      </p>
                    </div>
                  ))
                )}
              </div>
            </div>

            <div className="rounded-[24px] border border-slate-200 bg-slate-50 p-5">
              <h3 className="text-xl font-black text-slate-950">Chats e atendimentos</h3>
              <div className="mt-4 max-h-[420px] space-y-3 overflow-auto">
                {report.supportThreads.length === 0 ? (
                  <p className="text-sm font-semibold text-slate-500">
                    Nenhum chat atribuído a este operador.
                  </p>
                ) : (
                  report.supportThreads.map((thread) => (
                    <div key={thread.id} className="rounded-2xl bg-white p-4 shadow-sm">
                      <p className="font-black text-slate-950">{thread.subject}</p>
                      <p className="mt-1 text-xs text-slate-500">
                        Cliente: {thread.customerName || thread.customerEmail}
                      </p>
                      <p className="mt-1 text-xs text-slate-500">
                        Status: {thread.status} • Mensagens: {thread.messagesCount}
                      </p>
                    </div>
                  ))
                )}
              </div>
            </div>
          </div>
        </section>
      ) : null}
    </main>
  );
}
