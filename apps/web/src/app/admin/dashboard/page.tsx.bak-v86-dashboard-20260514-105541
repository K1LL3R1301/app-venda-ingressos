"use client";

import Link from "next/link";
import { useEffect, useMemo, useState } from "react";

type EventItem = {
  id: string;
  name?: string | null;
  title?: string | null;
  description?: string | null;
  category?: string | null;
  eventDate?: string | null;
  date?: string | null;
  startsAt?: string | null;
  capacity?: number | string | null;
  totalCapacity?: number | string | null;
  organizerName?: string | null;
  organizer?: {
    name?: string | null;
    fantasyName?: string | null;
  } | null;
  venue?: {
    name?: string | null;
    city?: string | null;
    state?: string | null;
  } | null;
  city?: string | null;
  state?: string | null;
};

type OrderItem = {
  id: string;
  eventId?: string | null;
  status?: string | null;
  totalAmount?: string | number | null;
  createdAt?: string | null;
};

type OrganizerItem = {
  id: string;
  name?: string | null;
  fantasyName?: string | null;
};

type LoadState = {
  events: EventItem[];
  orders: OrderItem[];
  organizers: OrganizerItem[];
};

const API_BASE_URL =
  process.env.NEXT_PUBLIC_API_URL?.replace(/\/$/, "") || "http://localhost:3001/v1";

function toNumber(value?: string | number | null) {
  if (typeof value === "number") return value;

  const normalized = String(value ?? "0")
    .replace(/[^\d,.-]/g, "")
    .replace(/\./g, "")
    .replace(",", ".");

  const parsed = Number(normalized);
  return Number.isFinite(parsed) ? parsed : 0;
}

function formatMoney(value: number) {
  return new Intl.NumberFormat("pt-BR", {
    style: "currency",
    currency: "BRL",
  }).format(value);
}

function normalizeStatus(status?: string | null) {
  return String(status || "").toUpperCase();
}

function getEventName(event: EventItem) {
  return event.name || event.title || "Evento sem nome";
}

function getEventDate(event: EventItem) {
  const value = event.eventDate || event.startsAt || event.date;

  if (!value) return "Data não informada";

  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return value;

  return date.toLocaleString("pt-BR", {
    day: "2-digit",
    month: "short",
    year: "numeric",
    hour: "2-digit",
    minute: "2-digit",
  });
}

function getEventCapacity(event: EventItem) {
  const capacity = toNumber(event.capacity ?? event.totalCapacity);

  return capacity > 0 ? capacity : null;
}

function getOrganizerName(event: EventItem) {
  return (
    event.organizerName ||
    event.organizer?.fantasyName ||
    event.organizer?.name ||
    "Organizador não informado"
  );
}

function getEventLocation(event: EventItem) {
  const city = event.venue?.city || event.city;
  const state = event.venue?.state || event.state;

  if (city && state) return `${city} - ${state}`;
  if (city) return city;
  if (state) return state;

  return "Local não informado";
}

function getEventDescription(event: EventItem) {
  return event.description || `Evento da categoria ${event.category || "geral"}.`;
}

async function fetchArray<T>(path: string, token: string) {
  try {
    const response = await fetch(`${API_BASE_URL}${path}`, {
      headers: {
        "Content-Type": "application/json",
        Authorization: `Bearer ${token}`,
      },
      cache: "no-store",
    });

    if (!response.ok) return [];

    const data = await response.json().catch(() => []);

    return Array.isArray(data) ? (data as T[]) : [];
  } catch {
    return [];
  }
}

function DashboardCard({
  label,
  value,
  detail,
  href,
  icon,
}: {
  label: string;
  value: string | number;
  detail: string;
  href: string;
  icon: string;
}) {
  return (
    <Link
      href={href}
      className="group rounded-[26px] border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-1 hover:border-orange-300 hover:shadow-md"
    >
      <div className="flex items-start justify-between gap-4">
        <div>
          <p className="text-[11px] font-black uppercase tracking-[0.24em] text-slate-400">
            {label}
          </p>

          <p className="mt-5 text-3xl font-black text-slate-950">{value}</p>
        </div>

        <div
          className="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl text-xl text-white shadow-sm transition group-hover:scale-105"
          style={{
            background:
              "linear-gradient(135deg, #ff6900 0%, #111827 48%, #020617 100%)",
          }}
        >
          {icon}
        </div>
      </div>

      <p className="mt-2 text-sm text-slate-500">{detail}</p>
    </Link>
  );
}

function StatusPill({ label, value }: { label: string; value: number }) {
  return (
    <div className="flex items-center justify-between rounded-2xl border border-slate-200 bg-slate-50 px-4 py-4">
      <span className="font-black text-slate-700">{label}</span>
      <span className="rounded-full bg-white px-3 py-1 text-sm font-black text-slate-950 shadow-sm">
        {value}
      </span>
    </div>
  );
}

