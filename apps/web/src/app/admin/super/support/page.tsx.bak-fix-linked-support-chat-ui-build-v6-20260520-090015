// @ts-nocheck
"use client";

import {
  supportTargetLabel,
  useEffect,
  useMemo,
  useState } from "react";
  import { getStoredAuthUser } from "../../../../lib/auth-client";
  import {
    supportOwnerLabel,
  supportPriorityLabel,
  supportStatusLabel
    type SupportTicket
} from "../../../../lib/support-workflow";
  import {
    addSupportMessageReal,
  getVisibleSupportTicketsReal,
  resolveSupportTicketReal,
  returnSupportFromSuperAdminReal
} from "../../../../lib/support-api-workflow";

type StoredUser = { id?: string; name?: string; email?: string; role?: string };

function superFallback(): StoredUser {
  return { name: "Super Admin", email: "super@admin.com", role: "SUPER_ADMIN" };
}

export default function SuperSupportPage() {
  const [user, setUser] = useState<StoredUser | null>(null);
  const [tickets, setTickets] = useState<SupportTicket[]>([]);
  const [selectedId, setSelectedId] = useState("");
  const [response, setResponse] = useState("");
  const [responseTarget, setResponseTarget] = useState<"ALL" | "CUSTOMER" | "PRODUCER" | "OPERATOR" | "SUPER_ADMIN">("CUSTOMER");
  const [filter, setFilter] = useState<"TECH" | "ALL" | "RESOLVED">("TECH");

  async function reload() {
    const storedUser = getStoredAuthUser<StoredUser>() || superFallback();
    setUser(storedUser);
    setTickets(await getVisibleSupportTicketsReal({ role: "SUPER_ADMIN", userEmail: storedUser.email }));
  }

  useEffect(() => {
    void reload();
    const onUpdate = () => void reload();
    window.addEventListener("astro-support-updated", onUpdate);
    return () => window.removeEventListener("astro-support-updated", onUpdate);
  }, []);

  const filteredTickets = useMemo(() => {
    return tickets.filter((ticket) => {
      if (filter === "RESOLVED") return ["RESOLVED", "CLOSED"].includes(ticket.status);
      if (filter === "TECH") return ticket.currentOwnerType === "SUPER_ADMIN" && !["RESOLVED", "CLOSED"].includes(ticket.status);
      return true;
    });
  }, [tickets, filter]);

  const selectedTicket = tickets.find((ticket) => ticket.id === selectedId) || filteredTickets[0] || null;

  function actor() {
    const current = user || superFallback();
    return { name: current.name || "Super Admin", email: current.email };
  }

  async function replyOnly() {
    if (!selectedTicket) return;
    try {
      await addSupportMessageReal(selectedTicket.id, { role: "SUPER_ADMIN", ...actor() }, response, { targetType: responseTarget });
      setResponse("");
      await reload();
    } catch (error) {
      alert(error instanceof Error ? error.message : "Não foi possível responder.");
    }
  }

  async function returnToProducer() {
    if (!selectedTicket) return;
    try {
      await returnSupportFromSuperAdminReal(selectedTicket.id, "PRODUCER", actor(), response);
      setResponse("");
      await reload();
    } catch (error) {
      alert(error instanceof Error ? error.message : "Não foi possível devolver ao produtor.");
    }
  }

  async function returnToOperator() {
    if (!selectedTicket) return;
    try {
      await returnSupportFromSuperAdminReal(selectedTicket.id, "OPERATOR", actor(), response);
      setResponse("");
      await reload();
    } catch (error) {
      alert(error instanceof Error ? error.message : "Não foi possível devolver ao operador.");
    }
  }

  async function returnToCustomer() {
    if (!selectedTicket) return;
    try {
      await returnSupportFromSuperAdminReal(selectedTicket.id, "CUSTOMER", actor(), response);
      setResponse("");
      await reload();
    } catch (error) {
      alert(error instanceof Error ? error.message : "Não foi possível devolver ao cliente.");
    }
  }

  async function resolveTechnical() {
    if (!selectedTicket) return;
    try {
      await resolveSupportTicketReal(selectedTicket.id, { role: "SUPER_ADMIN", ...actor() }, response, { targetType: responseTarget });
      setResponse("");
      await reload();
    } catch (error) {
      alert(error instanceof Error ? error.message : "Não foi possível resolver.");
    }
  }

  return (
    <main className="min-h-screen bg-slate-100 px-4 py-8 text-slate-950">
      <section className="mx-auto max-w-7xl space-y-6">
        <section className="rounded-[34px] bg-slate-950 p-8 text-white shadow-sm">
          <p className="text-[11px] font-black uppercase tracking-[0.34em] text-emerald-300">Super Admin</p>
          <h1 className="mt-4 text-5xl font-black leading-tight">Suporte técnico interligado.</h1>
          <p className="mt-4 max-w-4xl text-sm font-semibold leading-7 text-white/75">
            Aqui entram chamados encaminhados por produtor ou operador quando parecer problema interno do site.
          </p>
        </section>

        <section className="grid gap-6 lg:grid-cols-[380px_1fr]">
          <aside className="rounded-[30px] border border-slate-200 bg-white p-5 shadow-sm">
            <div className="flex flex-wrap items-center justify-between gap-3">
              <div>
                <p className="text-[11px] font-black uppercase tracking-[0.22em] text-slate-400">Fila técnica</p>
                <h2 className="mt-1 text-2xl font-black">Chamados</h2>
              </div>
              <a href="/admin" className="rounded-2xl border border-slate-200 px-4 py-3 text-xs font-black">Painel</a>
            </div>

            <div className="mt-4 grid grid-cols-3 gap-2">
              {[["TECH", "Técnicos"], ["RESOLVED", "Resolvidos"], ["ALL", "Todos"]].map(([key, label]) => (
                <button key={key} type="button" onClick={() => setFilter(key)} className={`rounded-2xl px-3 py-3 text-xs font-black ${filter === key ? "bg-slate-950 text-white" : "bg-slate-50 text-slate-600 ring-1 ring-slate-200"}`}>{label}</button>
              ))}
            </div>

            <TicketList tickets={filteredTickets} selectedId={selectedTicket?.id} onSelect={setSelectedId} />
          </aside>

          <section>
            {selectedTicket ? (
              <article className="rounded-[30px] border border-slate-200 bg-white p-6 shadow-sm">
                <TicketHeader ticket={selectedTicket} />
                <div className="mt-6"><TicketMessages ticket={selectedTicket} /></div>
                <section className="mt-6 rounded-2xl border border-slate-200 bg-slate-50 p-4">
                  <h3 className="text-lg font-black">Resposta do Super Admin</h3>
                  <p className="mt-1 text-sm font-semibold text-slate-500">Use o mesmo texto para responder, devolver ou resolver o chamado.</p>
                  <select value={responseTarget} onChange={(event) => setResponseTarget(event.target.value as any)} className="mt-3 h-12 w-full rounded-2xl border border-emerald-200 bg-white px-4 text-sm font-black outline-none">
                    <option value="CUSTOMER">Responder cliente</option>
                    <option value="PRODUCER">Responder produtor/admin</option>
                    <option value="OPERATOR">Responder operador</option>
                    <option value="ALL">Responder todos</option>
                  </select>
                  <textarea value={response} onChange={(event) => setResponse(event.target.value)} className="mt-3 min-h-32 w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm font-bold outline-none focus:border-emerald-500" placeholder="Digite a orientação técnica..." />
                  <div className="mt-3 grid gap-2 md:grid-cols-5">
                    <button type="button" onClick={replyOnly} className="rounded-2xl bg-slate-950 px-4 py-3 text-sm font-black text-white">Responder alvo</button>
                    <button type="button" onClick={returnToCustomer} className="rounded-2xl bg-violet-600 px-4 py-3 text-sm font-black text-white">Devolver ao cliente</button>
                    <button type="button" onClick={returnToProducer} className="rounded-2xl bg-orange-600 px-4 py-3 text-sm font-black text-white">Devolver ao produtor</button>
                    <button type="button" onClick={returnToOperator} className="rounded-2xl bg-blue-600 px-4 py-3 text-sm font-black text-white">Devolver ao operador</button>
                    <button type="button" onClick={resolveTechnical} className="rounded-2xl bg-emerald-600 px-4 py-3 text-sm font-black text-white">Resolver técnico</button>
                  </div>
                </section>
              </article>
            ) : (
              <EmptyState />
            )}
          </section>
        </section>
      </section>
    </main>
  );
}

function TicketList({ tickets, selectedId, onSelect }: { tickets: SupportTicket[]; selectedId?: string; onSelect: (id: string) => void }) {
  return (
    <div className="mt-5 space-y-3">
      {tickets.length === 0 ? (
        <div className="rounded-2xl bg-slate-50 p-4 text-sm font-bold text-slate-500">Nenhum chamado técnico neste filtro.</div>
      ) : (
        tickets.map((ticket) => (
          <button key={ticket.id} type="button" onClick={() => onSelect(ticket.id)} className={`w-full rounded-2xl border p-4 text-left ${selectedId === ticket.id ? "border-emerald-300 bg-emerald-50" : "border-slate-200 bg-slate-50"}`}>
            <p className="text-[10px] font-black uppercase tracking-[0.2em] text-slate-400">{ticket.protocol}</p>
            <h3 className="mt-1 text-lg font-black">{ticket.title}</h3>
            <p className="mt-1 text-xs font-bold text-slate-500">{supportStatusLabel(ticket.status)} • {supportPriorityLabel(ticket.priority)}</p>
          </button>
        ))
      )}
    </div>
  );
}

function TicketHeader({ ticket }: { ticket: SupportTicket }) {
  return (
    <div className="flex flex-wrap items-start justify-between gap-4">
      <div>
        <p className="text-[11px] font-black uppercase tracking-[0.22em] text-emerald-600">{ticket.protocol}</p>
        <h2 className="mt-2 text-3xl font-black">{ticket.title}</h2>
        <p className="mt-2 text-sm font-bold text-slate-500">{ticket.eventName || "Sem evento"} • atual: {supportOwnerLabel(ticket.currentOwnerType)}</p>
      </div>
      <span className="rounded-full bg-slate-950 px-4 py-2 text-xs font-black text-white">{supportStatusLabel(ticket.status)}</span>
    </div>
  );
}

function EmptyState() {
  return (
    <section className="rounded-[30px] border border-slate-200 bg-white p-8 text-center shadow-sm">
      <h2 className="text-3xl font-black">Nenhum chamado selecionado</h2>
    </section>
  );
}

function timeLabel(value?: string) {
  if (!value) return "-";
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return value;
  return date.toLocaleString("pt-BR", {
    day: "2-digit",
    month: "short",
    hour: "2-digit",
    minute: "2-digit"
});
}

function TicketMessages({ ticket }: { ticket: SupportTicket }) {
  return (
    <section className="rounded-2xl bg-slate-50 p-4">
      <p className="text-[11px] font-black uppercase tracking-[0.22em] text-slate-400">Histórico completo</p>
      <div className="mt-4 space-y-3">
        {ticket.messages.map((message) => (
          <div key={message.id} className="rounded-2xl bg-white p-4 ring-1 ring-slate-200">
            <div className="flex flex-wrap justify-between gap-2">
              <p className="text-sm font-black">{message.authorName}</p>
              <p className="text-xs font-bold text-slate-400">{timeLabel(message.createdAt)}</p>
            </div>
            <p className="mt-1 text-xs font-black uppercase tracking-[0.18em] text-orange-600">
              {supportOwnerLabel(message.authorRole)} → {supportTargetLabel(message.targetType)} {message.internal ? "• nota interna" : ""}
            </p>
            <p className="mt-3 whitespace-pre-wrap text-sm font-semibold leading-6 text-slate-700">{message.text}</p>
          </div>
        ))}
      </div>
    </section>
  );
}

function ActionBox({
  title,
  value,
  setValue,
  placeholder,
  buttonLabel,
  onClick,
  tone = "dark"
}: {
  title: string;
  value: string;
  setValue: (value: string) => void;
  placeholder: string;
  buttonLabel: string;
  onClick: () => void;
  tone?: "dark" | "blue" | "green" | "orange";
}) {
  const buttonClass =
    tone === "blue"
      ? "bg-blue-600 text-white"
      : tone === "green"
        ? "bg-emerald-600 text-white"
        : tone === "orange"
          ? "bg-orange-600 text-white"
          : "bg-slate-950 text-white";

  return (
    <div className="rounded-2xl border border-slate-200 bg-slate-50 p-4">
      <h3 className="text-lg font-black">{title}</h3>
      <textarea
        value={value}
        onChange={(event) => setValue(event.target.value)}
        className="mt-3 min-h-28 w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm font-bold outline-none focus:border-orange-500"
        placeholder={placeholder}
      />
      <button type="button" onClick={onClick} className={`mt-3 w-full rounded-2xl px-4 py-3 text-sm font-black ${buttonClass}`}>
        {buttonLabel}
      </button>
    </div>
  );
}