"use client";
// @ts-nocheck

import { useEffect, useMemo, useState } from "react";
import { getStoredAuthUser } from "../../../../lib/auth-client";
import {
  addSupportMessageReal,
  getVisibleSupportTicketsReal,
  resolveSupportTicketReal,
  returnSupportFromSuperAdminReal,
} from "../../../../lib/support-api-workflow";

type SupportTicket = any;
type StoredUser = { id?: string; name?: string; email?: string; role?: string };

const FILTERS = [
  ["TECH", "Técnicos"],
  ["RESOLVED", "Resolvidos"],
  ["ALL", "Todos"],
] as const;

const TARGETS = [
  ["CUSTOMER", "Cliente"],
  ["PRODUCER", "Produtor/Admin"],
  ["OPERATOR", "Operador"],
  ["ALL", "Todos do chamado"],
] as const;

function fallbackUser(): StoredUser {
  return {
    id: "super-local",
    name: "Super Admin",
    email: "super@local.test",
    role: "SUPER_ADMIN",
  };
}

function ownerLabel(value?: string) {
  const labels: Record<string, string> = {
    CUSTOMER: "Cliente",
    PRODUCER: "Produtor/Admin",
    ADMIN: "Produtor/Admin",
    OPERATOR: "Operador",
    SUPER_ADMIN: "Super Admin",
    ALL: "Todos",
  };

  return labels[String(value || "").toUpperCase()] || "Sistema";
}

function statusLabel(value?: string) {
  const labels: Record<string, string> = {
    OPEN: "Aberto",
    IN_PROGRESS: "Em andamento",
    FORWARDED_TO_SUPER_ADMIN: "Com Super Admin",
    RETURNED_TO_PRODUCER: "Devolvido ao produtor",
    RETURNED_TO_OPERATOR: "Devolvido ao operador",
    CUSTOMER_REPLY: "Cliente respondeu",
    RESOLVED: "Resolvido",
    CLOSED: "Fechado",
  };

  return labels[String(value || "").toUpperCase()] || String(value || "Aberto");
}

function targetLabel(value?: string) {
  return ownerLabel(value || "ALL");
}

function dateLabel(value?: string) {
  if (!value) return "Agora";

  try {
    return new Intl.DateTimeFormat("pt-BR", {
      day: "2-digit",
      month: "2-digit",
      hour: "2-digit",
      minute: "2-digit",
    }).format(new Date(value));
  } catch {
    return String(value);
  }
}

function ticketMessages(ticket?: SupportTicket) {
  return Array.isArray(ticket?.messages) ? ticket.messages : [];
}

function TicketList({ tickets, selectedId, onSelect }: { tickets: SupportTicket[]; selectedId?: string; onSelect: (id: string) => void }) {
  if (!tickets.length) {
    return (
      <div className="rounded-3xl border border-dashed border-slate-200 bg-white p-8 text-center">
        <p className="text-sm font-black text-slate-600">Nenhum chamado na fila do Super Admin.</p>
      </div>
    );
  }

  return (
    <div className="space-y-3">
      {tickets.map((ticket) => (
        <button
          key={ticket.id}
          type="button"
          onClick={() => onSelect(ticket.id)}
          className={`w-full rounded-3xl border p-4 text-left transition ${
            selectedId === ticket.id ? "border-emerald-400 bg-emerald-50" : "border-slate-200 bg-white hover:border-emerald-200"
          }`}
        >
          <p className="text-sm font-black text-slate-950">{ticket.title || "Chamado"}</p>
          <p className="mt-1 text-xs font-bold text-slate-500">{ticket.protocol || ticket.id}</p>
          <div className="mt-3 flex flex-wrap gap-2">
            <span className="rounded-full bg-slate-100 px-3 py-1 text-[10px] font-black uppercase text-slate-600">{statusLabel(ticket.status)}</span>
            <span className="rounded-full bg-emerald-100 px-3 py-1 text-[10px] font-black uppercase text-emerald-700">{ownerLabel(ticket.currentOwnerType)}</span>
          </div>
        </button>
      ))}
    </div>
  );
}

function ChatPanel({ ticket }: { ticket?: SupportTicket }) {
  if (!ticket) {
    return (
      <div className="rounded-3xl border border-dashed border-slate-200 bg-white p-10 text-center">
        <p className="text-sm font-black text-slate-600">Selecione um chamado técnico.</p>
      </div>
    );
  }

  return (
    <div className="rounded-3xl border border-slate-200 bg-white p-5">
      <div className="flex flex-wrap items-start justify-between gap-3 border-b border-slate-100 pb-4">
        <div>
          <p className="text-lg font-black text-slate-950">{ticket.title}</p>
          <p className="mt-1 text-xs font-bold text-slate-500">{ticket.protocol}</p>
        </div>
        <span className="rounded-full bg-emerald-100 px-3 py-1 text-[10px] font-black uppercase text-emerald-700">{statusLabel(ticket.status)}</span>
      </div>

      <div className="mt-5 max-h-[480px] space-y-3 overflow-y-auto pr-1">
        {ticketMessages(ticket).map((message: any) => (
          <div key={message.id} className="rounded-3xl border border-slate-100 bg-slate-50 p-4">
            <div className="flex flex-wrap items-center justify-between gap-2">
              <p className="text-xs font-black uppercase tracking-[0.18em] text-slate-500">
                {ownerLabel(message.authorRole)} → {targetLabel(message.targetType)}
              </p>
              <p className="text-[10px] font-bold text-slate-400">{dateLabel(message.createdAt)}</p>
            </div>
            <p className="mt-2 whitespace-pre-wrap text-sm font-bold leading-relaxed text-slate-800">{message.text}</p>
            {message.kind && message.kind !== "MESSAGE" ? (
              <span className="mt-3 inline-flex rounded-full bg-white px-3 py-1 text-[10px] font-black uppercase text-slate-500">
                {message.kind}
              </span>
            ) : null}
          </div>
        ))}
      </div>
    </div>
  );
}

export default function SuperSupportPage() {
  const [user, setUser] = useState<StoredUser | null>(null);
  const [tickets, setTickets] = useState<SupportTicket[]>([]);
  const [selectedId, setSelectedId] = useState("");
  const [filter, setFilter] = useState("TECH");
  const [response, setResponse] = useState("");
  const [responseTarget, setResponseTarget] = useState("CUSTOMER");

  const filteredTickets = useMemo(() => {
    if (filter === "RESOLVED") {
      return tickets.filter((ticket) => ["RESOLVED", "CLOSED"].includes(String(ticket.status || "").toUpperCase()));
    }

    if (filter === "TECH") {
      return tickets.filter((ticket) => !["RESOLVED", "CLOSED"].includes(String(ticket.status || "").toUpperCase()));
    }

    return tickets;
  }, [tickets, filter]);

  const selectedTicket = useMemo(
    () => filteredTickets.find((ticket) => ticket.id === selectedId) || filteredTickets[0],
    [filteredTickets, selectedId],
  );

  function actor() {
    const current = user || fallbackUser();

    return {
      name: current.name || "Super Admin",
      email: current.email,
    };
  }

  async function reload() {
    const storedUser = getStoredAuthUser<StoredUser>() || fallbackUser();
    setUser(storedUser);

    const data = await getVisibleSupportTicketsReal({
      role: "SUPER_ADMIN",
      userEmail: storedUser.email,
    });

    setTickets(data);

    if (!selectedId && data[0]?.id) {
      setSelectedId(data[0].id);
    }
  }

  useEffect(() => {
    void reload();

    const onUpdate = () => void reload();
    window.addEventListener("support-workflow:update", onUpdate);

    return () => window.removeEventListener("support-workflow:update", onUpdate);
  }, []);

  async function replyOnly() {
    if (!selectedTicket || !response.trim()) return;

    await addSupportMessageReal(
      selectedTicket.id,
      { role: "SUPER_ADMIN", ...actor() },
      response,
      { targetType: responseTarget as any },
    );

    setResponse("");
    await reload();
  }

  async function returnToCustomer() {
    if (!selectedTicket || !response.trim()) return;

    await returnSupportFromSuperAdminReal(selectedTicket.id, "CUSTOMER", actor(), response);
    setResponse("");
    await reload();
  }

  async function returnToProducer() {
    if (!selectedTicket || !response.trim()) return;

    await returnSupportFromSuperAdminReal(selectedTicket.id, "PRODUCER", actor(), response);
    setResponse("");
    await reload();
  }

  async function returnToOperator() {
    if (!selectedTicket || !response.trim()) return;

    await returnSupportFromSuperAdminReal(selectedTicket.id, "OPERATOR", actor(), response);
    setResponse("");
    await reload();
  }

  async function resolveTechnical() {
    if (!selectedTicket || !response.trim()) return;

    await resolveSupportTicketReal(
      selectedTicket.id,
      { role: "SUPER_ADMIN", ...actor() },
      response,
      { targetType: responseTarget as any },
    );

    setResponse("");
    await reload();
  }

  return (
    <main className="min-h-screen bg-slate-50 px-4 py-8 text-slate-950">
      <div className="mx-auto max-w-7xl">
        <header className="rounded-[2rem] bg-slate-950 p-6 text-white shadow-sm">
          <p className="text-xs font-black uppercase tracking-[0.24em] text-emerald-300">Super Admin</p>
          <h1 className="mt-2 text-3xl font-black">Suporte técnico interligado</h1>
          <p className="mt-2 max-w-3xl text-sm font-bold text-slate-300">
            Receba o chat inteiro encaminhado por produtor ou operador, responda o alvo correto e devolva para quem deve continuar.
          </p>
        </header>

        <section className="mt-6 grid gap-5 lg:grid-cols-[380px_1fr]">
          <aside className="space-y-5">
            <div className="rounded-3xl border border-slate-200 bg-white p-4">
              <p className="text-xs font-black uppercase tracking-[0.18em] text-slate-500">Filtrar</p>
              <div className="mt-4 grid grid-cols-3 gap-2">
                {FILTERS.map(([value, label]) => (
                  <button
                    key={value}
                    type="button"
                    onClick={() => setFilter(value)}
                    className={`rounded-2xl px-3 py-2 text-xs font-black ${
                      filter === value ? "bg-emerald-600 text-white" : "bg-slate-100 text-slate-600"
                    }`}
                  >
                    {label}
                  </button>
                ))}
              </div>
            </div>

            <TicketList tickets={filteredTickets} selectedId={selectedTicket?.id} onSelect={setSelectedId} />
          </aside>

          <section className="space-y-5">
            <ChatPanel ticket={selectedTicket} />

            {selectedTicket ? (
              <section className="rounded-3xl border border-emerald-100 bg-emerald-50 p-5">
                <label className="text-xs font-black uppercase tracking-[0.18em] text-emerald-700">Responder para</label>
                <select value={responseTarget} onChange={(event) => setResponseTarget(event.target.value)} className="mt-2 h-12 w-full rounded-2xl border border-emerald-200 bg-white px-4 text-sm font-black outline-none">
                  {TARGETS.map(([value, label]) => (
                    <option key={value} value={value}>{label}</option>
                  ))}
                </select>

                <textarea value={response} onChange={(event) => setResponse(event.target.value)} className="mt-3 min-h-32 w-full rounded-2xl border border-emerald-200 bg-white px-4 py-3 text-sm font-bold outline-none" placeholder="Digite a orientação técnica..." />

                <div className="mt-3 grid gap-2 md:grid-cols-5">
                  <button type="button" onClick={replyOnly} className="rounded-2xl bg-slate-950 px-4 py-3 text-sm font-black text-white">Responder alvo</button>
                  <button type="button" onClick={returnToCustomer} className="rounded-2xl bg-violet-600 px-4 py-3 text-sm font-black text-white">Devolver cliente</button>
                  <button type="button" onClick={returnToProducer} className="rounded-2xl bg-orange-600 px-4 py-3 text-sm font-black text-white">Devolver produtor</button>
                  <button type="button" onClick={returnToOperator} className="rounded-2xl bg-blue-600 px-4 py-3 text-sm font-black text-white">Devolver operador</button>
                  <button type="button" onClick={resolveTechnical} className="rounded-2xl bg-emerald-600 px-4 py-3 text-sm font-black text-white">Resolver técnico</button>
                </div>
              </section>
            ) : null}
          </section>
        </section>
      </div>
    </main>
  );
}