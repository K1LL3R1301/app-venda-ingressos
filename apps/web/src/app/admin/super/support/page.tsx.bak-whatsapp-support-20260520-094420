"use client";
// @ts-nocheck

import { useEffect, useMemo, useState } from "react";
import { getStoredAuthUser } from "../../../../lib/auth-client";
import {
  addSupportMessageReal,
  getVisibleSupportTicketsReal,
  resolveSupportTicketReal,
  returnSupportFromSuperAdminReal,
} from "../../../../lib/support-api-workflow";

type Ticket = any;
type StoredUser = { id?: string; name?: string; email?: string; role?: string };

const FILTERS = [
  ["TECH", "Técnicos"],
  ["RESOLVED", "Resolvidos"],
  ["ALL", "Todos"],
] as const;

const REPLY_TARGETS = [
  ["CUSTOMER", "Cliente"],
  ["PRODUCER", "Produtor/Admin"],
  ["OPERATOR", "Operador"],
  ["ALL", "Todos"],
] as const;

function fallbackUser(): StoredUser {
  return { id: "super-local", name: "Super Admin", email: "super@local.test", role: "SUPER_ADMIN" };
}

function label(value?: string) {
  const labels: Record<string, string> = {
    CUSTOMER: "Cliente",
    PRODUCER: "Produtor/Admin",
    ADMIN: "Produtor/Admin",
    OPERATOR: "Operador",
    SUPER_ADMIN: "Super Admin",
    ALL: "Todos",
    OPEN: "Aberto",
    IN_PROGRESS: "Em andamento",
    FORWARDED_TO_SUPER_ADMIN: "Com Super Admin",
    RETURNED_TO_PRODUCER: "Devolvido ao produtor",
    RETURNED_TO_OPERATOR: "Devolvido ao operador",
    CUSTOMER_REPLY: "Cliente respondeu",
    RESOLVED: "Resolvido",
    CLOSED: "Fechado",
  };
  return labels[String(value || "").toUpperCase()] || String(value || "Sistema");
}

function when(value?: string) {
  if (!value) return "";
  try {
    return new Intl.DateTimeFormat("pt-BR", { day: "2-digit", month: "2-digit", hour: "2-digit", minute: "2-digit" }).format(new Date(value));
  } catch {
    return String(value);
  }
}

function messages(ticket?: Ticket) {
  return Array.isArray(ticket?.messages) ? ticket.messages : [];
}

function isMine(message: any) {
  return String(message?.authorRole || "").toUpperCase() === "SUPER_ADMIN";
}

function lastMessage(ticket: Ticket) {
  const list = messages(ticket);
  return list[list.length - 1]?.text || ticket?.title || "Sem mensagens";
}

function CardList({ tickets, selectedId, onSelect }: { tickets: Ticket[]; selectedId?: string; onSelect: (id: string) => void }) {
  if (!tickets.length) {
    return <div className="rounded-3xl border border-dashed border-slate-200 bg-white p-8 text-center text-sm font-black text-slate-600">Nenhum chamado técnico encontrado.</div>;
  }

  return (
    <div className="space-y-3">
      {tickets.map((ticket) => (
        <button key={ticket.id} type="button" onClick={() => onSelect(ticket.id)} className={`w-full rounded-3xl border p-4 text-left transition ${selectedId === ticket.id ? "border-emerald-400 bg-emerald-50 shadow-sm" : "border-slate-200 bg-white hover:border-emerald-200"}`}>
          <p className="truncate text-sm font-black text-slate-950">{ticket.title || "Chamado"}</p>
          <p className="mt-2 line-clamp-2 text-xs font-bold text-slate-500">{lastMessage(ticket)}</p>
          <p className="mt-3 text-[10px] font-black uppercase tracking-[0.14em] text-slate-400">{label(ticket.status)} • {label(ticket.currentOwnerType)}</p>
        </button>
      ))}
    </div>
  );
}

function Bubble({ message }: { message: any }) {
  const mine = isMine(message);
  const kind = String(message?.kind || "MESSAGE").toUpperCase();

  return (
    <div className={`flex ${mine ? "justify-end" : "justify-start"}`}>
      <div className={`max-w-[78%] rounded-3xl px-4 py-3 shadow-sm ${mine ? "rounded-br-md bg-emerald-600 text-white" : kind === "FORWARD" ? "rounded-bl-md border border-amber-200 bg-amber-50 text-amber-950" : "rounded-bl-md bg-white text-slate-900"}`}>
        <p className={`mb-1 text-[10px] font-black uppercase tracking-[0.16em] ${mine ? "text-emerald-100" : "text-slate-400"}`}>{label(message.authorRole)} → {label(message.targetType || "ALL")}</p>
        <p className="whitespace-pre-wrap text-sm font-bold leading-relaxed">{message.text}</p>
        <p className={`mt-2 text-right text-[10px] font-bold ${mine ? "text-emerald-100" : "text-slate-400"}`}>{when(message.createdAt)}</p>
      </div>
    </div>
  );
}

export default function SuperSupportPage() {
  const [user, setUser] = useState<StoredUser | null>(null);
  const [tickets, setTickets] = useState<Ticket[]>([]);
  const [selectedId, setSelectedId] = useState("");
  const [filter, setFilter] = useState("TECH");
  const [response, setResponse] = useState("");
  const [responseTarget, setResponseTarget] = useState("CUSTOMER");

  const filteredTickets = useMemo(() => {
    if (filter === "RESOLVED") return tickets.filter((ticket) => ["RESOLVED", "CLOSED"].includes(String(ticket.status || "").toUpperCase()));
    if (filter === "TECH") return tickets.filter((ticket) => !["RESOLVED", "CLOSED"].includes(String(ticket.status || "").toUpperCase()));
    return tickets;
  }, [tickets, filter]);

  const selectedTicket = useMemo(() => filteredTickets.find((ticket) => ticket.id === selectedId) || null, [filteredTickets, selectedId]);

  function actor() {
    const current = user || fallbackUser();
    return { role: "SUPER_ADMIN" as const, name: current.name || "Super Admin", email: current.email };
  }

  function selectTicket(id: string) {
    setSelectedId(id);
    if (typeof window !== "undefined") {
      const url = new URL(window.location.href);
      url.searchParams.set("ticket", id);
      window.history.replaceState(null, "", url.toString());
    }
  }

  async function reload() {
    const current = getStoredAuthUser<StoredUser>() || fallbackUser();
    setUser(current);

    const data = await getVisibleSupportTicketsReal({ role: "SUPER_ADMIN", userEmail: current.email });
    setTickets(data);

    const ticketFromUrl = typeof window !== "undefined" ? new URLSearchParams(window.location.search).get("ticket") : "";
    const nextId = ticketFromUrl || selectedId || data[0]?.id || "";
    if (nextId) setSelectedId(nextId);
  }

  useEffect(() => {
    void reload();
    const onUpdate = () => void reload();
    window.addEventListener("support-workflow:update", onUpdate);
    return () => window.removeEventListener("support-workflow:update", onUpdate);
  }, []);

  async function sendReply() {
    if (!selectedTicket || !response.trim()) return;
    await addSupportMessageReal(selectedTicket.id, actor(), response, { targetType: responseTarget as any });
    setResponse("");
    await reload();
  }

  async function returnTo(target: "CUSTOMER" | "PRODUCER" | "OPERATOR") {
    if (!selectedTicket || !response.trim()) {
      alert("Digite uma resposta antes de devolver o chamado.");
      return;
    }

    await returnSupportFromSuperAdminReal(selectedTicket.id, target, actor(), response);
    setResponse("");
    await reload();
  }

  async function resolveTicket() {
    if (!selectedTicket) return;
    await resolveSupportTicketReal(selectedTicket.id, actor(), response.trim() || "Chamado técnico resolvido pelo Super Admin.", { targetType: responseTarget as any });
    setResponse("");
    await reload();
  }

  return (
    <main className="min-h-screen bg-slate-100 px-4 py-8 text-slate-950">
      <div className="mx-auto max-w-7xl">
        <header className="rounded-[2rem] bg-slate-950 p-6 text-white shadow-sm">
          <p className="text-xs font-black uppercase tracking-[0.24em] text-emerald-300">Super Admin</p>
          <h1 className="mt-2 text-3xl font-black">Suporte técnico interligado</h1>
          <p className="mt-2 max-w-3xl text-sm font-bold text-slate-300">Veja o chat inteiro encaminhado por produtor ou operador, com a justificativa junto das mensagens.</p>
        </header>

        <section className="mt-6 grid h-[calc(100vh-230px)] min-h-[620px] gap-5 lg:grid-cols-[360px_1fr]">
          <aside className="overflow-hidden rounded-[2rem] border border-slate-200 bg-white p-4 shadow-sm">
            <div className="mb-4 grid grid-cols-3 gap-2">
              {FILTERS.map(([value, text]) => (
                <button key={value} type="button" onClick={() => setFilter(value)} className={`rounded-2xl px-3 py-2 text-xs font-black ${filter === value ? "bg-emerald-600 text-white" : "bg-slate-100 text-slate-600"}`}>
                  {text}
                </button>
              ))}
            </div>
            <div className="h-[calc(100%-52px)] overflow-y-auto pr-1">
              <CardList tickets={filteredTickets} selectedId={selectedTicket?.id} onSelect={selectTicket} />
            </div>
          </aside>

          <section className="flex min-h-0 flex-col overflow-hidden rounded-[2rem] border border-slate-200 bg-[#e9f3ee] shadow-sm">
            {selectedTicket ? (
              <>
                <div className="flex flex-wrap items-center justify-between gap-3 border-b border-slate-200 bg-white px-5 py-4">
                  <div>
                    <h2 className="text-lg font-black">{selectedTicket.title || "Chamado"}</h2>
                    <p className="text-xs font-bold text-slate-500">{selectedTicket.protocol || selectedTicket.id}</p>
                  </div>
                  <button type="button" onClick={resolveTicket} className="rounded-2xl bg-emerald-600 px-4 py-2 text-xs font-black text-white">Resolver técnico</button>
                </div>

                <div className="flex-1 space-y-3 overflow-y-auto p-5">
                  {messages(selectedTicket).map((message: any) => <Bubble key={message.id} message={message} />)}
                </div>

                <div className="border-t border-slate-200 bg-white p-4">
                  <select value={responseTarget} onChange={(event) => setResponseTarget(event.target.value)} className="mb-2 h-11 rounded-2xl border border-slate-200 bg-slate-50 px-3 text-xs font-black outline-none">
                    {REPLY_TARGETS.map(([value, text]) => <option key={value} value={value}>{text}</option>)}
                  </select>
                  <textarea value={response} onChange={(event) => setResponse(event.target.value)} className="min-h-20 w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-bold outline-none focus:border-emerald-500" placeholder="Digite a resposta técnica..." />
                  <div className="mt-2 grid gap-2 md:grid-cols-4">
                    <button type="button" onClick={sendReply} className="rounded-2xl bg-slate-950 px-4 py-3 text-xs font-black text-white">Responder</button>
                    <button type="button" onClick={() => returnTo("CUSTOMER")} className="rounded-2xl bg-violet-600 px-4 py-3 text-xs font-black text-white">Devolver cliente</button>
                    <button type="button" onClick={() => returnTo("PRODUCER")} className="rounded-2xl bg-orange-600 px-4 py-3 text-xs font-black text-white">Devolver produtor</button>
                    <button type="button" onClick={() => returnTo("OPERATOR")} className="rounded-2xl bg-blue-600 px-4 py-3 text-xs font-black text-white">Devolver operador</button>
                  </div>
                </div>
              </>
            ) : (
              <div className="grid flex-1 place-items-center p-10 text-center">
                <div>
                  <p className="text-2xl font-black text-slate-700">Selecione uma ficha</p>
                  <p className="mt-2 text-sm font-bold text-slate-500">Ao clicar em uma ficha, o chat técnico abre aqui.</p>
                </div>
              </div>
            )}
          </section>
        </section>
      </div>
    </main>
  );
}