"use client";
// @ts-nocheck

import { useEffect, useMemo, useState } from "react";
import { getStoredAuthUser } from "../../../lib/auth-client";
import {
  addSupportMessageReal,
  createSupportTicketReal,
  forwardSupportToSuperAdminReal,
  getVisibleSupportTicketsReal,
  resolveSupportTicketReal,
} from "../../../lib/support-api-workflow";

type SupportTicket = any;
type StoredUser = { id?: string; name?: string; email?: string; role?: string };

const TARGETS = [
  ["CUSTOMER", "Cliente"],
  ["PRODUCER", "Produtor/Admin"],
  ["OPERATOR", "Operador"],
  ["SUPER_ADMIN", "Super Admin"],
  ["ALL", "Todos do chamado"],
] as const;

function fallbackUser(): StoredUser {
  return {
    id: "admin-local",
    name: "Produtor/Admin",
    email: "admin@local.test",
    role: "ADMIN",
  };
}

function ownerLabel(value?: string) {
  const labels: Record<string, string> = {
    CUSTOMER: "Cliente",
    PRODUCER: "Produtor/Admin",
    ADMIN: "Produtor/Admin",
    OPERATOR: "Operador",
    SUPER_ADMIN: "Super Admin",
    ALL: "Todos",
  };

  return labels[String(value || "").toUpperCase()] || "Sistema";
}

function statusLabel(value?: string) {
  const labels: Record<string, string> = {
    OPEN: "Aberto",
    IN_PROGRESS: "Em andamento",
    CUSTOMER_REPLY: "Resposta do cliente",
    PRODUCER_REPLY: "Resposta do produtor",
    FORWARDED_TO_SUPER_ADMIN: "Com Super Admin",
    RETURNED_TO_PRODUCER: "Devolvido ao produtor",
    RETURNED_TO_OPERATOR: "Devolvido ao operador",
    RESOLVED: "Resolvido",
    CLOSED: "Fechado",
  };

  return labels[String(value || "").toUpperCase()] || String(value || "Aberto");
}

function priorityLabel(value?: string) {
  const labels: Record<string, string> = {
    LOW: "Baixa",
    NORMAL: "Normal",
    HIGH: "Alta",
    URGENT: "Urgente",
  };

  return labels[String(value || "NORMAL").toUpperCase()] || "Normal";
}

function targetLabel(value?: string) {
  return ownerLabel(value || "ALL");
}

function dateLabel(value?: string) {
  if (!value) return "Agora";

  try {
    return new Intl.DateTimeFormat("pt-BR", {
      day: "2-digit",
      month: "2-digit",
      hour: "2-digit",
      minute: "2-digit",
    }).format(new Date(value));
  } catch {
    return String(value);
  }
}

function ticketMessages(ticket?: SupportTicket) {
  return Array.isArray(ticket?.messages) ? ticket.messages : [];
}

function ticketHistory(ticket?: SupportTicket) {
  return Array.isArray(ticket?.history) ? ticket.history : [];
}

function TicketList({
  tickets,
  selectedId,
  onSelect,
}: {
  tickets: SupportTicket[];
  selectedId?: string;
  onSelect: (id: string) => void;
}) {
  if (!tickets.length) {
    return (
      <div className="rounded-3xl border border-dashed border-slate-200 bg-white p-8 text-center">
        <p className="text-sm font-black text-slate-600">Nenhum chamado encontrado.</p>
        <p className="mt-1 text-xs font-bold text-slate-400">Abra um chamado ou aguarde uma nova conversa.</p>
      </div>
    );
  }

  return (
    <div className="space-y-3">
      {tickets.map((ticket) => (
        <button
          key={ticket.id}
          type="button"
          onClick={() => onSelect(ticket.id)}
          className={`w-full rounded-3xl border p-4 text-left transition ${
            selectedId === ticket.id
              ? "border-orange-400 bg-orange-50 shadow-sm"
              : "border-slate-200 bg-white hover:border-orange-200"
          }`}
        >
          <div className="flex items-start justify-between gap-3">
            <div>
              <p className="text-sm font-black text-slate-950">{ticket.title || "Chamado"}</p>
              <p className="mt-1 text-xs font-bold text-slate-500">{ticket.protocol || ticket.id}</p>
            </div>
            <span className="rounded-full bg-slate-100 px-3 py-1 text-[10px] font-black uppercase text-slate-600">
              {statusLabel(ticket.status)}
            </span>
          </div>

          <div className="mt-3 grid gap-2 text-xs font-bold text-slate-500">
            <span>Evento: {ticket.eventName || "Não informado"}</span>
            <span>Dono atual: {ownerLabel(ticket.currentOwnerType)}</span>
            <span>Prioridade: {priorityLabel(ticket.priority)}</span>
          </div>
        </button>
      ))}
    </div>
  );
}

function ChatPanel({ ticket }: { ticket?: SupportTicket }) {
  if (!ticket) {
    return (
      <div className="rounded-3xl border border-dashed border-slate-200 bg-white p-10 text-center">
        <p className="text-sm font-black text-slate-600">Selecione um chamado para ver o chat.</p>
      </div>
    );
  }

  return (
    <div className="rounded-3xl border border-slate-200 bg-white p-5">
      <div className="flex flex-wrap items-start justify-between gap-3 border-b border-slate-100 pb-4">
        <div>
          <p className="text-lg font-black text-slate-950">{ticket.title}</p>
          <p className="mt-1 text-xs font-bold text-slate-500">{ticket.protocol}</p>
        </div>
        <div className="flex flex-wrap gap-2">
          <span className="rounded-full bg-orange-100 px-3 py-1 text-[10px] font-black uppercase text-orange-700">
            {statusLabel(ticket.status)}
          </span>
          <span className="rounded-full bg-slate-100 px-3 py-1 text-[10px] font-black uppercase text-slate-600">
            {ownerLabel(ticket.currentOwnerType)}
          </span>
        </div>
      </div>

      <div className="mt-5 max-h-[460px] space-y-3 overflow-y-auto pr-1">
        {ticketMessages(ticket).map((message: any) => (
          <div key={message.id} className="rounded-3xl border border-slate-100 bg-slate-50 p-4">
            <div className="flex flex-wrap items-center justify-between gap-2">
              <p className="text-xs font-black uppercase tracking-[0.18em] text-slate-500">
                {ownerLabel(message.authorRole)} → {targetLabel(message.targetType)}
              </p>
              <p className="text-[10px] font-bold text-slate-400">{dateLabel(message.createdAt)}</p>
            </div>
            <p className="mt-2 whitespace-pre-wrap text-sm font-bold leading-relaxed text-slate-800">{message.text}</p>
            {message.kind && message.kind !== "MESSAGE" ? (
              <span className="mt-3 inline-flex rounded-full bg-white px-3 py-1 text-[10px] font-black uppercase text-slate-500">
                {message.kind}
              </span>
            ) : null}
          </div>
        ))}

        {!ticketMessages(ticket).length ? (
          <p className="rounded-2xl bg-slate-50 p-4 text-sm font-bold text-slate-500">Sem mensagens ainda.</p>
        ) : null}
      </div>

      {ticketHistory(ticket).length ? (
        <details className="mt-5 rounded-2xl border border-slate-100 bg-slate-50 p-4">
          <summary className="cursor-pointer text-xs font-black uppercase tracking-[0.18em] text-slate-500">
            Histórico do chamado
          </summary>
          <div className="mt-3 space-y-2">
            {ticketHistory(ticket).map((item: any) => (
              <p key={item.id} className="text-xs font-bold text-slate-500">
                {dateLabel(item.createdAt)} • {item.action} {item.to ? `→ ${ownerLabel(item.to)}` : ""}
              </p>
            ))}
          </div>
        </details>
      ) : null}
    </div>
  );
}

function ActionBox({
  title,
  value,
  setValue,
  onSubmit,
  button,
  placeholder,
}: {
  title: string;
  value: string;
  setValue: (value: string) => void;
  onSubmit: () => void;
  button: string;
  placeholder: string;
}) {
  return (
    <section className="rounded-3xl border border-slate-200 bg-white p-4">
      <p className="text-xs font-black uppercase tracking-[0.18em] text-slate-500">{title}</p>
      <textarea
        value={value}
        onChange={(event) => setValue(event.target.value)}
        className="mt-3 min-h-28 w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-bold outline-none focus:border-orange-500"
        placeholder={placeholder}
      />
      <button
        type="button"
        onClick={onSubmit}
        className="mt-3 w-full rounded-2xl bg-slate-950 px-4 py-3 text-sm font-black text-white"
      >
        {button}
      </button>
    </section>
  );
}

export default function AdminSupportPage() {
  const [user, setUser] = useState<StoredUser | null>(null);
  const [tickets, setTickets] = useState<SupportTicket[]>([]);
  const [selectedId, setSelectedId] = useState("");
  const [reply, setReply] = useState("");
  const [replyTarget, setReplyTarget] = useState("CUSTOMER");
  const [forwardReason, setForwardReason] = useState("");
  const [resolution, setResolution] = useState("");
  const [newTicket, setNewTicket] = useState({
    eventId: "",
    eventName: "",
    customerName: "",
    title: "",
    message: "",
    priority: "NORMAL",
    targetType: "PRODUCER",
  });

  const selectedTicket = useMemo(
    () => tickets.find((ticket) => ticket.id === selectedId) || tickets[0],
    [tickets, selectedId],
  );

  function actor() {
    const current = user || fallbackUser();

    return {
      role: "PRODUCER" as const,
      name: current.name || "Produtor/Admin",
      email: current.email,
    };
  }

  async function reload() {
    const storedUser = getStoredAuthUser<StoredUser>() || fallbackUser();
    setUser(storedUser);

    const data = await getVisibleSupportTicketsReal({
      role: "PRODUCER",
      userEmail: storedUser.email,
    });

    setTickets(data);

    if (!selectedId && data[0]?.id) {
      setSelectedId(data[0].id);
    }
  }

  useEffect(() => {
    void reload();

    const onUpdate = () => void reload();
    window.addEventListener("support-workflow:update", onUpdate);

    return () => window.removeEventListener("support-workflow:update", onUpdate);
  }, []);

  async function createTicket() {
    if (!newTicket.title.trim() || !newTicket.message.trim()) {
      alert("Informe título e mensagem.");
      return;
    }

    const current = user || fallbackUser();

    const ticket = await createSupportTicketReal({
      title: newTicket.title,
      category: newTicket.targetType === "SUPER_ADMIN" ? "Suporte técnico" : "Atendimento",
      message: newTicket.message,
      priority: newTicket.priority,
      sourceType: "PRODUCER",
      targetType: newTicket.targetType,
      currentOwnerType: newTicket.targetType === "SUPER_ADMIN" ? "SUPER_ADMIN" : "PRODUCER",
      eventId: newTicket.eventId || undefined,
      eventName: newTicket.eventName || undefined,
      customerName: newTicket.customerName || undefined,
      producerName: current.name || "Produtor/Admin",
      producerEmail: current.email,
      createdByRole: "PRODUCER",
      createdByName: current.name || "Produtor/Admin",
      createdByEmail: current.email,
    });

    setSelectedId(ticket?.id || "");
    setNewTicket({
      eventId: "",
      eventName: "",
      customerName: "",
      title: "",
      message: "",
      priority: "NORMAL",
      targetType: "PRODUCER",
    });
    await reload();
  }

  async function answerSelected() {
    if (!selectedTicket || !reply.trim()) return;

    await addSupportMessageReal(selectedTicket.id, actor(), reply, { targetType: replyTarget as any });
    setReply("");
    await reload();
  }

  async function forwardSelected() {
    if (!selectedTicket || !forwardReason.trim()) return;

    await forwardSupportToSuperAdminReal(selectedTicket.id, actor(), forwardReason);
    setForwardReason("");
    await reload();
  }

  async function resolveSelected() {
    if (!selectedTicket || !resolution.trim()) return;

    await resolveSupportTicketReal(selectedTicket.id, actor(), resolution, { targetType: "ALL" });
    setResolution("");
    await reload();
  }

  return (
    <main className="min-h-screen bg-slate-50 px-4 py-8 text-slate-950">
      <div className="mx-auto max-w-7xl">
        <header className="rounded-[2rem] bg-slate-950 p-6 text-white shadow-sm">
          <p className="text-xs font-black uppercase tracking-[0.24em] text-orange-300">Suporte interligado</p>
          <h1 className="mt-2 text-3xl font-black">Central de suporte do produtor</h1>
          <p className="mt-2 max-w-3xl text-sm font-bold text-slate-300">
            Converse com cliente, operador ou Super Admin em um único chamado com histórico completo.
          </p>
        </header>

        <section className="mt-6 grid gap-5 lg:grid-cols-[380px_1fr]">
          <aside className="space-y-5">
            <section className="rounded-3xl border border-slate-200 bg-white p-5">
              <p className="text-xs font-black uppercase tracking-[0.18em] text-slate-500">Abrir chamado</p>
              <div className="mt-4 grid gap-3">
                <input value={newTicket.eventId} onChange={(event) => setNewTicket((current) => ({ ...current, eventId: event.target.value }))} className="h-11 rounded-2xl border border-slate-200 bg-slate-50 px-4 text-sm font-bold outline-none" placeholder="ID do evento para API real" />
                <input value={newTicket.eventName} onChange={(event) => setNewTicket((current) => ({ ...current, eventName: event.target.value }))} className="h-11 rounded-2xl border border-slate-200 bg-slate-50 px-4 text-sm font-bold outline-none" placeholder="Nome do evento" />
                <input value={newTicket.customerName} onChange={(event) => setNewTicket((current) => ({ ...current, customerName: event.target.value }))} className="h-11 rounded-2xl border border-slate-200 bg-slate-50 px-4 text-sm font-bold outline-none" placeholder="Cliente relacionado, se houver" />
                <input value={newTicket.title} onChange={(event) => setNewTicket((current) => ({ ...current, title: event.target.value }))} className="h-11 rounded-2xl border border-slate-200 bg-slate-50 px-4 text-sm font-bold outline-none" placeholder="Título do chamado" />
                <select value={newTicket.targetType} onChange={(event) => setNewTicket((current) => ({ ...current, targetType: event.target.value }))} className="h-11 rounded-2xl border border-slate-200 bg-slate-50 px-4 text-sm font-bold outline-none">
                  <option value="PRODUCER">Atendimento do produtor</option>
                  <option value="SUPER_ADMIN">Chamado técnico para Super Admin</option>
                </select>
                <select value={newTicket.priority} onChange={(event) => setNewTicket((current) => ({ ...current, priority: event.target.value }))} className="h-11 rounded-2xl border border-slate-200 bg-slate-50 px-4 text-sm font-bold outline-none">
                  <option value="LOW">Baixa</option>
                  <option value="NORMAL">Normal</option>
                  <option value="HIGH">Alta</option>
                  <option value="URGENT">Urgente</option>
                </select>
                <textarea value={newTicket.message} onChange={(event) => setNewTicket((current) => ({ ...current, message: event.target.value }))} className="min-h-24 rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-bold outline-none" placeholder="Mensagem inicial" />
                <button type="button" onClick={createTicket} className="rounded-2xl bg-orange-600 px-4 py-3 text-sm font-black text-white">
                  Abrir chamado
                </button>
              </div>
            </section>

            <TicketList tickets={tickets} selectedId={selectedTicket?.id} onSelect={setSelectedId} />
          </aside>

          <section className="space-y-5">
            <ChatPanel ticket={selectedTicket} />

            {selectedTicket ? (
              <>
                <section className="rounded-3xl border border-orange-100 bg-orange-50 p-4">
                  <label className="text-xs font-black uppercase tracking-[0.18em] text-orange-700">Responder para</label>
                  <select value={replyTarget} onChange={(event) => setReplyTarget(event.target.value)} className="mt-2 h-12 w-full rounded-2xl border border-orange-200 bg-white px-4 text-sm font-black outline-none">
                    {TARGETS.map(([value, label]) => (
                      <option key={value} value={value}>{label}</option>
                    ))}
                  </select>
                </section>

                <section className="grid gap-4 lg:grid-cols-3">
                  <ActionBox title="Responder no chat" value={reply} setValue={setReply} onSubmit={answerSelected} button="Responder" placeholder="Digite sua resposta..." />
                  <ActionBox title="Encaminhar ao Super Admin" value={forwardReason} setValue={setForwardReason} onSubmit={forwardSelected} button="Encaminhar" placeholder="Explique brevemente por que precisa do Super Admin..." />
                  <ActionBox title="Resolver chamado" value={resolution} setValue={setResolution} onSubmit={resolveSelected} button="Resolver" placeholder="Informe a solução final..." />
                </section>
              </>
            ) : null}
          </section>
        </section>
      </div>
    </main>
  );
}