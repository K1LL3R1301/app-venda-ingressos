"use client";

import Link from "next/link";
import { useEffect, useMemo, useState } from "react";

type OrderItem = {
  id: string;
  eventId?: string | null;
  customerName?: string | null;
  customerEmail?: string | null;
  customerDocument?: string | null;
  status?: string | null;
  totalAmount?: string | number | null;
  createdAt?: string | null;
  updatedAt?: string | null;
  event?: {
    id?: string | null;
    name?: string | null;
    eventDate?: string | null;
  } | null;
  items?: Array<{
    id: string;
    quantity?: number | null;
    unitPrice?: string | number | null;
    totalPrice?: string | number | null;
    ticketType?: {
      id?: string | null;
      name?: string | null;
    } | null;
    tickets?: Array<{
      id: string;
      code?: string | null;
      status?: string | null;
    }>;
  }>;
  payments?: Array<{
    id: string;
    method?: string | null;
    amount?: string | number | null;
    status?: string | null;
    createdAt?: string | null;
  }>;
};

type StoredUser = {
  id?: string;
  name?: string;
  email?: string;
  cpf?: string;
  role?: string;
};

type PeriodFilter = "ALL" | "TODAY" | "7D" | "30D" | "YEAR" | "CUSTOM";
type StatusFilter = "ALL" | "PAID" | "PENDING" | "CANCELED" | "REFUNDED";

const API_BASE_URL =
  process.env.NEXT_PUBLIC_API_URL?.replace(/\/$/, "") || "http://localhost:3001/v1";

const MONEY = new Intl.NumberFormat("pt-BR", {
  style: "currency",
  currency: "BRL",
});

const NUMBER = new Intl.NumberFormat("pt-BR");

function toNumber(value?: string | number | null) {
  if (typeof value === "number") return value;

  const normalized = String(value ?? "0")
    .replace(/[^\d,.-]/g, "")
    .replace(/\./g, "")
    .replace(",", ".");

  const parsed = Number(normalized);
  return Number.isFinite(parsed) ? parsed : 0;
}

function formatMoney(value?: string | number | null) {
  return MONEY.format(toNumber(value));
}

function formatNumber(value?: number | null) {
  return NUMBER.format(value || 0);
}

function normalizeStatus(status?: string | null) {
  return String(status || "").toUpperCase();
}

function isPaid(order: OrderItem) {
  return normalizeStatus(order.status) === "PAID";
}

function isCanceled(order: OrderItem) {
  return ["CANCELED", "CANCELLED", "EXPIRED", "FAILED"].includes(normalizeStatus(order.status));
}

function isRefund(order: OrderItem) {
  const status = normalizeStatus(order.status);
  const ticketStatuses = (order.items || [])
    .flatMap((item) => item.tickets || [])
    .map((ticket) => normalizeStatus(ticket.status));

  return (
    status.includes("REFUND") ||
    ticketStatuses.some((ticketStatus) =>
      ["CANCELED", "CANCELLED", "REFUNDED"].includes(ticketStatus),
    )
  );
}

function getOrderAmount(order: OrderItem) {
  return toNumber(order.totalAmount);
}

function getEventName(order: OrderItem) {
  return order.event?.name || order.eventId || "Evento não informado";
}

function getPaymentLabel(method?: string | null) {
  const normalized = String(method || "").toUpperCase();

  const labels: Record<string, string> = {
    PIX: "Pix",
    CARD: "Cartão",
    CREDIT_CARD: "Cartão de crédito",
    DEBIT_CARD: "Cartão de débito",
    BOLETO: "Boleto",
    CASH: "Dinheiro",
    MANUAL: "Manual",
    WALLET: "Wallet",
    COURTESY: "Cortesia",
    TRANSFER: "Transferência",
  };

  return labels[normalized] || method || "Não informado";
}

function getPaymentSummary(order: OrderItem) {
  if (!order.payments?.length) return "Não informado";

  return Array.from(new Set(order.payments.map((payment) => getPaymentLabel(payment.method)))).join(", ");
}

function getTicketQuantity(order: OrderItem) {
  return (order.items || []).reduce((total, item) => {
    const qty = Number(item.quantity ?? 0);
    return total + (Number.isFinite(qty) ? qty : 0);
  }, 0);
}

function getQrQuantity(order: OrderItem) {
  return (order.items || []).reduce((total, item) => total + (item.tickets?.length || 0), 0);
}

function dateValue(date: Date) {
  const year = date.getFullYear();
  const month = String(date.getMonth() + 1).padStart(2, "0");
  const day = String(date.getDate()).padStart(2, "0");

  return `${year}-${month}-${day}`;
}

function formatDate(value?: string | null) {
  if (!value) return "-";

  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return value;

  return date.toLocaleDateString("pt-BR", {
    day: "2-digit",
    month: "2-digit",
    year: "numeric",
  });
}

function formatDateTime(value?: string | null) {
  if (!value) return "-";

  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return value;

  return date.toLocaleString("pt-BR", {
    day: "2-digit",
    month: "2-digit",
    year: "numeric",
    hour: "2-digit",
    minute: "2-digit",
  });
}

function dayKey(value?: string | null) {
  if (!value) return "sem-data";

  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return "sem-data";

  return dateValue(date);
}

function monthKey(value?: string | null) {
  if (!value) return "sem-mes";

  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return "sem-mes";

  return `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, "0")}`;
}

function monthLabel(key: string) {
  if (!/^\d{4}-\d{2}$/.test(key)) return key;

  const [year, month] = key.split("-");
  const date = new Date(Number(year), Number(month) - 1, 1);

  return date.toLocaleDateString("pt-BR", {
    month: "short",
    year: "2-digit",
  });
}

function inPeriod(order: OrderItem, period: PeriodFilter, startDate: string, endDate: string) {
  if (period === "ALL") return true;

  const created = new Date(order.createdAt || "");
  if (Number.isNaN(created.getTime())) return false;

  const now = new Date();
  const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());

  if (period === "TODAY") return created >= today;
  if (period === "7D") return created.getTime() >= now.getTime() - 7 * 24 * 60 * 60 * 1000;
  if (period === "30D") return created.getTime() >= now.getTime() - 30 * 24 * 60 * 60 * 1000;
  if (period === "YEAR") return created.getFullYear() === now.getFullYear();

  if (period === "CUSTOM") {
    if (startDate) {
      const start = new Date(`${startDate}T00:00:00`);
      if (created < start) return false;
    }

    if (endDate) {
      const end = new Date(`${endDate}T23:59:59`);
      if (created > end) return false;
    }
  }

  return true;
}

function csvCell(value: unknown) {
  return `"${String(value ?? "").replace(/"/g, '""')}"`;
}

function downloadCsv(filename: string, rows: Array<Array<string | number | null | undefined>>) {
  const csv = rows.map((row) => row.map(csvCell).join(";")).join("\n");
  const blob = new Blob(["\ufeff", csv], {
    type: "text/csv;charset=utf-8;",
  });
  const url = URL.createObjectURL(blob);
  const link = document.createElement("a");

  link.href = url;
  link.download = filename;
  link.click();

  URL.revokeObjectURL(url);
}

function rollingDays(days = 14) {
  const today = new Date();

  return Array.from({ length: days }).map((_, index) => {
    const date = new Date(today);
    date.setDate(today.getDate() - (days - 1 - index));
    return dateValue(date);
  });
}

function linePath(points: Array<{ label: string; value: number }>, width = 780, height = 230) {
  if (!points.length) return "";

  const max = Math.max(...points.map((point) => point.value), 1);
  const step = points.length <= 1 ? width : width / (points.length - 1);

  return points
    .map((point, index) => {
      const x = index * step;
      const y = height - (point.value / max) * height;
      return `${index === 0 ? "M" : "L"} ${x.toFixed(2)} ${y.toFixed(2)}`;
    })
    .join(" ");
}

function areaPath(points: Array<{ label: string; value: number }>, width = 780, height = 230) {
  const line = linePath(points, width, height);
  if (!line) return "";

  return `${line} L ${width} ${height} L 0 ${height} Z`;
}

function MetricCard({
  title,
  value,
  helper,
  tone = "light",
}: {
  title: string;
  value: string | number;
  helper?: string;
  tone?: "light" | "dark" | "green" | "orange" | "red" | "purple";
}) {
  const classes = {
    light: "border-neutral-200 bg-white text-neutral-950",
    dark: "border-neutral-950 bg-neutral-950 text-white",
    green: "border-emerald-100 bg-emerald-50 text-emerald-950",
    orange: "border-orange-100 bg-orange-50 text-orange-950",
    red: "border-red-100 bg-red-50 text-red-950",
    purple: "border-[#1b0035]/10 bg-[#1b0035] text-white",
  }[tone];

  return (
    <div className={`rounded-[26px] border p-5 shadow-sm ${classes}`}>
      <p className="text-[11px] font-black uppercase tracking-[0.22em] opacity-55">{title}</p>
      <p className="mt-3 text-3xl font-black">{value}</p>
      {helper ? <p className="mt-1 text-xs font-bold opacity-65">{helper}</p> : null}
    </div>
  );
}

function TopBar({ label, value, max }: { label: string; value: number; max: number }) {
  const width = max > 0 ? Math.max(4, (value / max) * 100) : 0;

  return (
    <div className="space-y-2">
      <div className="flex items-center justify-between gap-3 text-sm">
        <span className="truncate font-black text-neutral-950">{label}</span>
        <span className="shrink-0 font-black text-neutral-700">{formatMoney(value)}</span>
      </div>
      <div className="h-3 overflow-hidden rounded-full bg-neutral-100">
        <div
          className="h-full rounded-full bg-gradient-to-r from-orange-500 via-orange-700 to-[#1b0035]"
          style={{ width: `${width}%` }}
        />
      </div>
    </div>
  );
}

export default function AdminFinancePage() {
  const [orders, setOrders] = useState<OrderItem[]>([]);
  const [user, setUser] = useState<StoredUser | null>(null);
  const [loading, setLoading] = useState(true);
  const [loadError, setLoadError] = useState("");
  const [eventFilter, setEventFilter] = useState("ALL");
  const [statusFilter, setStatusFilter] = useState<StatusFilter>("ALL");
  const [periodFilter, setPeriodFilter] = useState<PeriodFilter>("YEAR");
  const [startDate, setStartDate] = useState(() => `${new Date().getFullYear()}-01-01`);
  const [endDate, setEndDate] = useState(() => dateValue(new Date()));

  const role = String(user?.role || "").toUpperCase();
  const isSuperAdmin = role === "SUPER_ADMIN";

  useEffect(() => {
    async function load() {
      const token = localStorage.getItem("token");
      const rawUser = localStorage.getItem("user");

      if (!token || token === "undefined") {
        window.location.href = "/login";
        return;
      }

      try {
        setUser(rawUser ? (JSON.parse(rawUser) as StoredUser) : null);
      } catch {
        setUser(null);
      }

      try {
        const response = await fetch(`${API_BASE_URL}/orders`, {
          headers: {
            "Content-Type": "application/json",
            Authorization: `Bearer ${token}`,
          },
        });

        const result = await response.json().catch(() => null);

        if (!response.ok) {
          throw new Error(
            typeof result?.message === "string"
              ? result.message
              : "Erro ao carregar dados financeiros",
          );
        }

        setOrders(Array.isArray(result) ? result : []);
      } catch (error) {
        setLoadError(error instanceof Error ? error.message : "Erro ao conectar com a API");
      } finally {
        setLoading(false);
      }
    }

    load();
  }, []);

  const sortedOrders = useMemo(() => {
    return [...orders].sort((a, b) => {
      const aDate = new Date(a.createdAt || 0).getTime();
      const bDate = new Date(b.createdAt || 0).getTime();
      return bDate - aDate;
    });
  }, [orders]);

  const eventOptions = useMemo(() => {
    const map = new Map<string, string>();

    sortedOrders.forEach((order) => {
      const id = order.event?.id || order.eventId;
      if (!id) return;

      map.set(id, order.event?.name || id);
    });

    return Array.from(map.entries()).map(([id, name]) => ({
      id,
      name,
    }));
  }, [sortedOrders]);

  const filteredOrders = useMemo(() => {
    return sortedOrders.filter((order) => {
      if (eventFilter !== "ALL") {
        const eventId = order.event?.id || order.eventId;
        if (eventId !== eventFilter) return false;
      }

      if (statusFilter !== "ALL") {
        const status = normalizeStatus(order.status);

        if (statusFilter === "CANCELED") {
          if (!isCanceled(order)) return false;
        } else if (statusFilter === "REFUNDED") {
          if (!isRefund(order)) return false;
        } else if (status !== statusFilter) {
          return false;
        }
      }

      return inPeriod(order, periodFilter, startDate, endDate);
    });
  }, [sortedOrders, eventFilter, statusFilter, periodFilter, startDate, endDate]);

  const paidOrders = filteredOrders.filter(isPaid);
  const pendingOrders = filteredOrders.filter((order) => normalizeStatus(order.status) === "PENDING");
  const canceledOrders = filteredOrders.filter(isCanceled);
  const refundedOrders = filteredOrders.filter(isRefund);

  const grossPaid = paidOrders.reduce((total, order) => total + getOrderAmount(order), 0);
  const pendingAmount = pendingOrders.reduce((total, order) => total + getOrderAmount(order), 0);
  const canceledAmount = canceledOrders.reduce((total, order) => total + getOrderAmount(order), 0);
  const refundAmount = refundedOrders.reduce((total, order) => total + getOrderAmount(order), 0);
  const netEstimated = Math.max(0, grossPaid - refundAmount);
  const ticketCount = paidOrders.reduce((total, order) => total + getTicketQuantity(order), 0);
  const qrCount = filteredOrders.reduce((total, order) => total + getQrQuantity(order), 0);
  const averageTicket = paidOrders.length ? grossPaid / paidOrders.length : 0;
  const conversion = filteredOrders.length ? (paidOrders.length / filteredOrders.length) * 100 : 0;
  const uniqueDocuments = new Set(
    paidOrders.map((order) => order.customerDocument).filter(Boolean),
  ).size;

  const dailyRevenue = useMemo(() => {
    const keys = rollingDays(14);
    const map = new Map(keys.map((key) => [key, 0]));

    paidOrders.forEach((order) => {
      const key = dayKey(order.createdAt);
      if (!map.has(key)) return;
      map.set(key, (map.get(key) || 0) + getOrderAmount(order));
    });

    return keys.map((key) => ({
      label: formatDate(key),
      shortLabel: formatDate(key).slice(0, 5),
      value: map.get(key) || 0,
    }));
  }, [paidOrders]);

  const monthlyRevenue = useMemo(() => {
    const map = new Map<string, number>();

    paidOrders.forEach((order) => {
      const key = monthKey(order.createdAt);
      map.set(key, (map.get(key) || 0) + getOrderAmount(order));
    });

    return Array.from(map.entries())
      .sort(([a], [b]) => a.localeCompare(b))
      .map(([key, value]) => ({
        label: monthLabel(key),
        value,
      }));
  }, [paidOrders]);

  const paymentRanking = useMemo(() => {
    const map = new Map<string, { label: string; amount: number; count: number }>();

    paidOrders.forEach((order) => {
      const key = getPaymentSummary(order);
      const current = map.get(key) || {
        label: key,
        amount: 0,
        count: 0,
      };

      current.amount += getOrderAmount(order);
      current.count += 1;
      map.set(key, current);
    });

    return Array.from(map.values()).sort((a, b) => b.amount - a.amount);
  }, [paidOrders]);

  const eventRanking = useMemo(() => {
    const map = new Map<string, { label: string; amount: number; count: number; tickets: number }>();

    paidOrders.forEach((order) => {
      const key = order.event?.id || order.eventId || getEventName(order);
      const current = map.get(key) || {
        label: getEventName(order),
        amount: 0,
        count: 0,
        tickets: 0,
      };

      current.amount += getOrderAmount(order);
      current.count += 1;
      current.tickets += getTicketQuantity(order);
      map.set(key, current);
    });

    return Array.from(map.values()).sort((a, b) => b.amount - a.amount);
  }, [paidOrders]);

  const maxDaily = Math.max(...dailyRevenue.map((point) => point.value), 1);
  const maxPayment = Math.max(...paymentRanking.map((item) => item.amount), 1);
  const maxEvent = Math.max(...eventRanking.map((item) => item.amount), 1);

  const statusData = [
    {
      label: "Pagos",
      value: paidOrders.length,
      color: "#10b981",
      className: "bg-emerald-500",
    },
    {
      label: "Pendentes",
      value: pendingOrders.length,
      color: "#f59e0b",
      className: "bg-amber-500",
    },
    {
      label: "Cancelados",
      value: canceledOrders.length,
      color: "#ef4444",
      className: "bg-red-500",
    },
    {
      label: "Estornos",
      value: refundedOrders.length,
      color: "#0ea5e9",
      className: "bg-sky-500",
    },
  ].filter((item) => item.value > 0);

  const statusConic = statusData.length
    ? (() => {
        let current = 0;
        const total = statusData.reduce((sum, item) => sum + item.value, 0);

        return `conic-gradient(${statusData
          .map((item) => {
            const start = current;
            const end = current + (item.value / total) * 360;
            current = end;
            return `${item.color} ${start}deg ${end}deg`;
          })
          .join(", ")})`;
      })()
    : "conic-gradient(#e5e7eb 0deg 360deg)";

  function exportAccountingCsv() {
    downloadCsv("astro-financeiro-contador-ir.csv", [
      ["Campo", "Valor"],
      ["Perfil", isSuperAdmin ? "SUPER_ADMIN - visão global" : "ADMIN - eventos próprios"],
      ["Período", periodFilter],
      ["Data inicial", startDate || "-"],
      ["Data final", endDate || "-"],
      ["Pedidos no filtro", filteredOrders.length],
      ["Pedidos pagos", paidOrders.length],
      ["Receita bruta paga", grossPaid.toFixed(2).replace(".", ",")],
      ["Estornos/reembolsos estimados", refundAmount.toFixed(2).replace(".", ",")],
      ["Receita líquida operacional estimada", netEstimated.toFixed(2).replace(".", ",")],
      ["Pendências em aberto", pendingAmount.toFixed(2).replace(".", ",")],
      ["Cancelamentos/expirados/falhos", canceledAmount.toFixed(2).replace(".", ",")],
      ["Ingressos pagos", ticketCount],
      ["QR codes gerados", qrCount],
      ["Ticket médio por pedido pago", averageTicket.toFixed(2).replace(".", ",")],
      ["CPF/CNPJ únicos em pedidos pagos", uniqueDocuments],
      ["Observação", "Relatório operacional para conferência. Não substitui escrituração fiscal, emissão de nota, contabilidade oficial ou apuração tributária."],
      [],
      ["Receita mensal"],
      ["Mês", "Valor"],
      ...monthlyRevenue.map((row) => [row.label, row.value.toFixed(2).replace(".", ",")]),
      [],
      ["Métodos de pagamento"],
      ["Método", "Valor", "Pedidos"],
      ...paymentRanking.map((row) => [
        row.label,
        row.amount.toFixed(2).replace(".", ","),
        row.count,
      ]),
      [],
      ["Eventos"],
      ["Evento", "Valor", "Pedidos", "Ingressos"],
      ...eventRanking.map((row) => [
        row.label,
        row.amount.toFixed(2).replace(".", ","),
        row.count,
        row.tickets,
      ]),
    ]);
  }

  function exportOrdersCsv() {
    downloadCsv("astro-financeiro-base-pedidos.csv", [
      ["Pedido", "Data", "Status", "Evento", "Cliente", "E-mail", "Documento", "Pagamento", "Valor", "Ingressos", "QR codes"],
      ...filteredOrders.map((order) => [
        order.id,
        formatDateTime(order.createdAt),
        normalizeStatus(order.status),
        getEventName(order),
        order.customerName || "",
        order.customerEmail || "",
        order.customerDocument || "",
        getPaymentSummary(order),
        getOrderAmount(order).toFixed(2).replace(".", ","),
        getTicketQuantity(order),
        getQrQuantity(order),
      ]),
    ]);
  }

  return (
    <main className="mx-auto max-w-[1500px] space-y-6 px-4 py-6">
      <section className="overflow-hidden rounded-[34px] bg-[#07020f] text-white shadow-sm">
        <div className="grid gap-7 p-7 lg:grid-cols-[1.1fr_0.9fr] lg:p-9">
          <div>
            <p className="text-[11px] font-black uppercase tracking-[0.32em] text-orange-300">
              Central financeira {isSuperAdmin ? "global" : "do administrador"}
            </p>
            <h1 className="mt-4 max-w-4xl text-4xl font-black leading-tight md:text-5xl">
              Gráficos, receita e relatório para contador.
            </h1>
            <p className="mt-4 max-w-3xl text-sm font-semibold leading-7 text-white/70">
              Esta é uma tela separada da tela de pedidos. Aqui ficam indicadores financeiros,
              exportações, receita por evento, métodos de pagamento e base operacional para IR/contador.
            </p>

            <div className="mt-6 flex flex-wrap gap-3">
              <Link
                href="/admin/orders"
                className="rounded-2xl bg-white px-5 py-3 text-sm font-black text-neutral-950 hover:bg-neutral-100"
              >
                Ir para pedidos
              </Link>
              <button
                type="button"
                onClick={exportAccountingCsv}
                className="rounded-2xl bg-orange-500 px-5 py-3 text-sm font-black text-white hover:bg-orange-600"
              >
                Exportar IR/contador
              </button>
              <button
                type="button"
                onClick={exportOrdersCsv}
                className="rounded-2xl bg-white/10 px-5 py-3 text-sm font-black text-white ring-1 ring-white/15 hover:bg-white/15"
              >
                Exportar base de pedidos
              </button>
            </div>
          </div>

          <div className="grid gap-3 sm:grid-cols-2">
            <div className="rounded-3xl border border-white/10 bg-white/10 p-5">
              <p className="text-[11px] font-black uppercase tracking-[0.24em] text-white/55">
                Receita bruta paga
              </p>
              <p className="mt-3 text-3xl font-black">{formatMoney(grossPaid)}</p>
              <p className="mt-1 text-xs font-semibold text-white/50">{paidOrders.length} pedido(s)</p>
            </div>

            <div className="rounded-3xl border border-white/10 bg-white/10 p-5">
              <p className="text-[11px] font-black uppercase tracking-[0.24em] text-white/55">
                Líquida estimada
              </p>
              <p className="mt-3 text-3xl font-black">{formatMoney(netEstimated)}</p>
              <p className="mt-1 text-xs font-semibold text-white/50">pagos menos estornos</p>
            </div>

            <div className="rounded-3xl border border-white/10 bg-white/10 p-5">
              <p className="text-[11px] font-black uppercase tracking-[0.24em] text-white/55">
                Documentos únicos
              </p>
              <p className="mt-3 text-3xl font-black">{formatNumber(uniqueDocuments)}</p>
              <p className="mt-1 text-xs font-semibold text-white/50">CPF/CNPJ em pedidos pagos</p>
            </div>

            <div className="rounded-3xl border border-white/10 bg-white/10 p-5">
              <p className="text-[11px] font-black uppercase tracking-[0.24em] text-white/55">
                QR codes
              </p>
              <p className="mt-3 text-3xl font-black">{formatNumber(qrCount)}</p>
              <p className="mt-1 text-xs font-semibold text-white/50">ingressos vinculados</p>
            </div>
          </div>
        </div>
      </section>

      <section className="rounded-[28px] border border-neutral-200 bg-white p-4 shadow-sm">
        <div className="grid gap-3 xl:grid-cols-[220px_170px_170px_160px_160px_auto]">
          <select
            value={eventFilter}
            onChange={(event) => setEventFilter(event.target.value)}
            className="h-12 rounded-2xl border border-neutral-200 bg-neutral-50 px-4 text-sm font-bold outline-none focus:border-orange-400"
          >
            <option value="ALL">Todos os eventos</option>
            {eventOptions.map((event) => (
              <option key={event.id} value={event.id}>
                {event.name}
              </option>
            ))}
          </select>

          <select
            value={statusFilter}
            onChange={(event) => setStatusFilter(event.target.value as StatusFilter)}
            className="h-12 rounded-2xl border border-neutral-200 bg-neutral-50 px-4 text-sm font-bold outline-none focus:border-orange-400"
          >
            <option value="ALL">Todos status</option>
            <option value="PAID">Pagos</option>
            <option value="PENDING">Pendentes</option>
            <option value="CANCELED">Cancelados</option>
            <option value="REFUNDED">Estornos</option>
          </select>

          <select
            value={periodFilter}
            onChange={(event) => setPeriodFilter(event.target.value as PeriodFilter)}
            className="h-12 rounded-2xl border border-neutral-200 bg-neutral-50 px-4 text-sm font-bold outline-none focus:border-orange-400"
          >
            <option value="ALL">Todo período</option>
            <option value="TODAY">Hoje</option>
            <option value="7D">Últimos 7 dias</option>
            <option value="30D">Últimos 30 dias</option>
            <option value="YEAR">Ano atual</option>
            <option value="CUSTOM">Personalizado</option>
          </select>

          <input
            type="date"
            value={startDate}
            onChange={(event) => {
              setStartDate(event.target.value);
              setPeriodFilter("CUSTOM");
            }}
            className="h-12 rounded-2xl border border-neutral-200 bg-neutral-50 px-4 text-sm font-bold outline-none focus:border-orange-400"
          />

          <input
            type="date"
            value={endDate}
            onChange={(event) => {
              setEndDate(event.target.value);
              setPeriodFilter("CUSTOM");
            }}
            className="h-12 rounded-2xl border border-neutral-200 bg-neutral-50 px-4 text-sm font-bold outline-none focus:border-orange-400"
          />

          <div className="rounded-2xl border border-neutral-200 bg-neutral-50 px-4 py-2">
            <p className="text-[10px] font-black uppercase tracking-[0.22em] text-neutral-400">
              Base
            </p>
            <p className="text-sm font-black">{filteredOrders.length} pedido(s)</p>
          </div>
        </div>
      </section>

      {loadError ? (
        <section className="rounded-2xl border border-red-200 bg-red-50 px-5 py-4 text-sm font-black text-red-700">
          {loadError}
        </section>
      ) : null}

      {loading ? (
        <section className="rounded-3xl bg-white p-8 text-center text-sm font-bold text-neutral-500 shadow-sm">
          Carregando financeiro...
        </section>
      ) : null}

      <section className="grid gap-4 md:grid-cols-2 xl:grid-cols-6">
        <MetricCard title="Receita bruta" value={formatMoney(grossPaid)} helper={`${paidOrders.length} pago(s)`} tone="green" />
        <MetricCard title="Líquida estimada" value={formatMoney(netEstimated)} helper="pagos menos estornos" tone="purple" />
        <MetricCard title="Pendentes" value={formatMoney(pendingAmount)} helper={`${pendingOrders.length} pedido(s)`} tone="orange" />
        <MetricCard title="Cancelados" value={formatMoney(canceledAmount)} helper={`${canceledOrders.length} pedido(s)`} tone="red" />
        <MetricCard title="Estornos" value={formatMoney(refundAmount)} helper={`${refundedOrders.length} ocorrência(s)`} />
        <MetricCard title="Ticket médio" value={formatMoney(averageTicket)} helper={`${conversion.toFixed(1).replace(".", ",")}% pagos`} />
      </section>

      <section className="grid gap-5 xl:grid-cols-[1.25fr_0.75fr]">
        <section className="rounded-[28px] border border-neutral-200 bg-white p-5 shadow-sm">
          <div className="flex flex-wrap items-end justify-between gap-3">
            <div>
              <p className="text-[11px] font-black uppercase tracking-[0.26em] text-orange-600">
                Receita diária
              </p>
              <h2 className="mt-1 text-2xl font-black">Últimos 14 dias pagos</h2>
            </div>
            <p className="rounded-2xl bg-neutral-50 px-4 py-3 text-sm font-black">
              Pico: {formatMoney(maxDaily)}
            </p>
          </div>

          <div className="mt-6 overflow-hidden rounded-3xl bg-[#07020f] p-4">
            <svg viewBox="0 0 780 270" className="h-[270px] w-full">
              <defs>
                <linearGradient id="financeArea" x1="0" x2="0" y1="0" y2="1">
                  <stop offset="0%" stopColor="#ff6900" stopOpacity="0.62" />
                  <stop offset="100%" stopColor="#1b0035" stopOpacity="0.03" />
                </linearGradient>
                <linearGradient id="financeLine" x1="0" x2="1" y1="0" y2="0">
                  <stop offset="0%" stopColor="#ff6900" />
                  <stop offset="100%" stopColor="#ffffff" />
                </linearGradient>
              </defs>

              {[0, 1, 2, 3].map((line) => (
                <line
                  key={line}
                  x1="0"
                  x2="780"
                  y1={30 + line * 55}
                  y2={30 + line * 55}
                  stroke="rgba(255,255,255,0.08)"
                />
              ))}

              <path d={areaPath(dailyRevenue)} fill="url(#financeArea)" />
              <path
                d={linePath(dailyRevenue)}
                fill="none"
                stroke="url(#financeLine)"
                strokeLinecap="round"
                strokeLinejoin="round"
                strokeWidth="5"
              />

              {dailyRevenue.map((point, index) => {
                const x = dailyRevenue.length <= 1 ? 0 : (780 / (dailyRevenue.length - 1)) * index;
                const y = 230 - (point.value / maxDaily) * 230;

                return (
                  <g key={point.label}>
                    <circle cx={x} cy={y} r="5" fill="#fff" />
                    <text
                      x={x}
                      y="262"
                      textAnchor="middle"
                      fill="rgba(255,255,255,0.66)"
                      fontSize="11"
                      fontWeight="800"
                    >
                      {point.shortLabel}
                    </text>
                  </g>
                );
              })}
            </svg>
          </div>
        </section>

        <section className="rounded-[28px] border border-neutral-200 bg-white p-5 shadow-sm">
          <p className="text-[11px] font-black uppercase tracking-[0.26em] text-orange-600">
            Saúde financeira
          </p>
          <h2 className="mt-1 text-2xl font-black">Distribuição por status</h2>

          <div className="mt-6 flex items-center justify-center">
            <div
              className="flex h-56 w-56 items-center justify-center rounded-full"
              style={{ background: statusConic }}
            >
              <div className="flex h-32 w-32 flex-col items-center justify-center rounded-full bg-white text-center shadow-inner">
                <p className="text-3xl font-black">{filteredOrders.length}</p>
                <p className="text-[10px] font-black uppercase tracking-[0.18em] text-neutral-400">
                  pedidos
                </p>
              </div>
            </div>
          </div>

          <div className="mt-6 space-y-3">
            {statusData.length === 0 ? (
              <p className="rounded-2xl bg-neutral-50 p-4 text-center text-sm font-bold text-neutral-500">
                Sem dados no filtro atual.
              </p>
            ) : (
              statusData.map((item) => (
                <div key={item.label} className="flex items-center justify-between">
                  <div className="flex items-center gap-2">
                    <span className={`h-3 w-3 rounded-full ${item.className}`} />
                    <span className="text-sm font-bold">{item.label}</span>
                  </div>
                  <span className="text-sm font-black">{item.value}</span>
                </div>
              ))
            )}
          </div>
        </section>
      </section>

      <section className="rounded-[28px] border border-orange-200 bg-orange-50 p-5 shadow-sm">
        <div className="grid gap-5 lg:grid-cols-[1fr_320px]">
          <div>
            <p className="text-[11px] font-black uppercase tracking-[0.26em] text-orange-700">
              Contabilidade e imposto
            </p>
            <h2 className="mt-2 text-2xl font-black">Base operacional para conferência fiscal.</h2>
            <p className="mt-3 max-w-4xl text-sm font-semibold leading-6 text-neutral-700">
              O relatório exporta receita bruta paga, estornos estimados, receita líquida operacional,
              métodos de pagamento, receita por mês, receita por evento e documentos dos compradores.
              Use como base para o contador. Não substitui nota fiscal, escrituração ou apuração tributária oficial.
            </p>
          </div>

          <button
            type="button"
            onClick={exportAccountingCsv}
            className="rounded-3xl bg-[#1b0035] px-6 py-5 text-sm font-black text-white hover:bg-[#2c064f]"
          >
            Baixar relatório contábil
          </button>
        </div>
      </section>

      <section className="grid gap-5 xl:grid-cols-2">
        <section className="rounded-[28px] border border-neutral-200 bg-white p-5 shadow-sm">
          <p className="text-[11px] font-black uppercase tracking-[0.26em] text-orange-600">
            Formas de pagamento
          </p>
          <h2 className="mt-1 text-2xl font-black">Receita paga por método</h2>

          <div className="mt-6 space-y-5">
            {paymentRanking.length === 0 ? (
              <p className="rounded-2xl bg-neutral-50 p-5 text-center text-sm font-bold text-neutral-500">
                Nenhum pagamento pago encontrado.
              </p>
            ) : (
              paymentRanking.map((item) => (
                <TopBar
                  key={item.label}
                  label={`${item.label} • ${item.count} pedido(s)`}
                  value={item.amount}
                  max={maxPayment}
                />
              ))
            )}
          </div>
        </section>

        <section className="rounded-[28px] border border-neutral-200 bg-white p-5 shadow-sm">
          <p className="text-[11px] font-black uppercase tracking-[0.26em] text-orange-600">
            Eventos mais rentáveis
          </p>
          <h2 className="mt-1 text-2xl font-black">Receita paga por evento</h2>

          <div className="mt-6 space-y-5">
            {eventRanking.length === 0 ? (
              <p className="rounded-2xl bg-neutral-50 p-5 text-center text-sm font-bold text-neutral-500">
                Nenhum evento com receita paga.
              </p>
            ) : (
              eventRanking.slice(0, 8).map((item) => (
                <TopBar
                  key={item.label}
                  label={`${item.label} • ${item.tickets} ingresso(s)`}
                  value={item.amount}
                  max={maxEvent}
                />
              ))
            )}
          </div>
        </section>
      </section>

      <section className="rounded-[28px] border border-neutral-200 bg-white p-5 shadow-sm">
        <div className="flex flex-wrap items-center justify-between gap-3">
          <div>
            <p className="text-[11px] font-black uppercase tracking-[0.26em] text-orange-600">
              Prévia da base
            </p>
            <h2 className="mt-1 text-2xl font-black">Pedidos considerados no financeiro</h2>
          </div>
          <Link
            href="/admin/orders"
            className="rounded-2xl bg-neutral-950 px-5 py-3 text-sm font-black text-white hover:bg-neutral-800"
          >
            Abrir tela de pedidos
          </Link>
        </div>

        <div className="mt-5 overflow-x-auto">
          <table className="w-full border-collapse text-sm">
            <thead>
              <tr className="border-b bg-neutral-50 text-left text-[11px] font-black uppercase tracking-[0.16em] text-neutral-500">
                <th className="px-4 py-3">Pedido</th>
                <th className="px-4 py-3">Data</th>
                <th className="px-4 py-3">Evento</th>
                <th className="px-4 py-3">Cliente</th>
                <th className="px-4 py-3">Pagamento</th>
                <th className="px-4 py-3">Valor</th>
                <th className="px-4 py-3">Status</th>
              </tr>
            </thead>
            <tbody>
              {filteredOrders.slice(0, 15).map((order) => (
                <tr key={order.id} className="border-b border-neutral-100">
                  <td className="px-4 py-3 font-black">#{order.id}</td>
                  <td className="px-4 py-3 text-neutral-500">{formatDateTime(order.createdAt)}</td>
                  <td className="px-4 py-3 font-bold">{getEventName(order)}</td>
                  <td className="px-4 py-3 text-neutral-500">{order.customerName || "-"}</td>
                  <td className="px-4 py-3 text-neutral-500">{getPaymentSummary(order)}</td>
                  <td className="px-4 py-3 font-black">{formatMoney(order.totalAmount)}</td>
                  <td className="px-4 py-3 font-bold">{normalizeStatus(order.status) || "-"}</td>
                </tr>
              ))}
            </tbody>
          </table>

          {!filteredOrders.length ? (
            <p className="rounded-2xl bg-neutral-50 p-6 text-center text-sm font-bold text-neutral-500">
              Nenhum pedido no filtro atual.
            </p>
          ) : null}
        </div>
      </section>
    </main>
  );
}

