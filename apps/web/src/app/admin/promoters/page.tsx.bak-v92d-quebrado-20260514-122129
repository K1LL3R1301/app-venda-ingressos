"use client";

import Link from "next/link";
import { useEffect, useState, type FormEvent } from "react";

const API_BASE_URL =
  process.env.NEXT_PUBLIC_API_URL?.replace(/\/$/, "") || "http://localhost:3001/v1";

type AnyItem = Record<string, any>;

function token() {
  return typeof window === "undefined" ? "" : localStorage.getItem("token") || "";
}

function money(value?: number | string | null) {
  return new Intl.NumberFormat("pt-BR", { style: "currency", currency: "BRL" }).format(Number(value || 0));
}

function code(value: string) {
  return value.toUpperCase().replace(/\s+/g, "").replace(/[^A-Z0-9_-]/g, "");
}

async function apiError(response: Response) {
  const text = await response.text().catch(() => "");
  try {
    const json = JSON.parse(text);
    if (Array.isArray(json?.message)) return json.message.join("\n");
    if (typeof json?.message === "string") return json.message;
    if (typeof json?.error === "string") return json.error;
  } catch {}
  return text || `Erro ${response.status}`;
}

function Field(props: any) {
  return <input {...props} className="h-12 w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 text-sm font-semibold outline-none focus:border-orange-400" />;
}

function Select(props: any) {
  return <select {...props} className="h-12 w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 text-sm font-semibold outline-none focus:border-orange-400" />;
}

function Metric({ label, value }: { label: string; value: string | number }) {
  return (
    <div className="rounded-3xl border border-slate-200 bg-white p-5 shadow-sm">
      <p className="text-[10px] font-black uppercase tracking-[0.22em] text-slate-400">{label}</p>
      <p className="mt-3 text-3xl font-black text-slate-950">{value}</p>
    </div>
  );
}

export default function AdminPromotersPage() {
  const [tab, setTab] = useState("promoters");
  const [events, setEvents] = useState<AnyItem[]>([]);
  const [overview, setOverview] = useState<AnyItem>({});
  const [reports, setReports] = useState<AnyItem>({});
  const [promoters, setPromoters] = useState<AnyItem[]>([]);
  const [coupons, setCoupons] = useState<AnyItem[]>([]);
  const [links, setLinks] = useState<AnyItem[]>([]);
  const [sales, setSales] = useState<AnyItem[]>([]);
  const [promoterForm, setPromoterForm] = useState({
    name: "",
    document: "",
    email: "",
    whatsapp: "",
    pixKey: "",
    eventId: "",
    commissionType: "PERCENT",
    commissionValue: "10",
    commissionBase: "NET_AMOUNT",
    notes: "",
  });
  const [couponForm, setCouponForm] = useState({
    code: "",
    eventId: "",
    promoterId: "",
    discountType: "PERCENT",
    discountValue: "10",
    usageLimit: "100",
    perCpfLimit: "1",
    validChannels: "online,admin,pdv",
  });
  const [linkForm, setLinkForm] = useState({ promoterId: "", eventId: "", label: "", slug: "", url: "" });
  const [saleForm, setSaleForm] = useState({
    eventId: "",
    promoterId: "",
    couponId: "",
    linkId: "",
    orderId: "",
    customerName: "",
    grossAmount: "",
    discountAmount: "",
    netAmount: "",
    status: "PAID",
  });
  const [paymentForms, setPaymentForms] = useState<Record<string, AnyItem>>({});

  async function load() {
    const auth = token();
    if (!auth || auth === "undefined") {
      window.location.href = "/login";
      return;
    }
    const headers = { Authorization: `Bearer ${auth}` };
    const [eventsRes, overviewRes, promotersRes, couponsRes, linksRes, salesRes, reportsRes] = await Promise.all([
      fetch(`${API_BASE_URL}/events`, { headers }),
      fetch(`${API_BASE_URL}/promoters/overview`, { headers }),
      fetch(`${API_BASE_URL}/promoters`, { headers }),
      fetch(`${API_BASE_URL}/promoters/coupons`, { headers }),
      fetch(`${API_BASE_URL}/promoters/links`, { headers }),
      fetch(`${API_BASE_URL}/promoters/sales`, { headers }),
      fetch(`${API_BASE_URL}/promoters/reports`, { headers }),
    ]);
    setEvents(await eventsRes.json().catch(() => []));
    setOverview(await overviewRes.json().catch(() => ({})));
    setPromoters(await promotersRes.json().catch(() => []));
    setCoupons(await couponsRes.json().catch(() => []));
    setLinks(await linksRes.json().catch(() => []));
    setSales(await salesRes.json().catch(() => []));
    setReports(await reportsRes.json().catch(() => ({})));
  }

  useEffect(() => {
    load();
  }, []);

  function eventTitle(eventId: string) {
    const event = events.find((item) => item.id === eventId);
    return event?.name || event?.title || "";
  }

  async function post(path: string, payload: AnyItem, message: string) {
    const response = await fetch(`${API_BASE_URL}${path}`, {
      method: "POST",
      headers: { "Content-Type": "application/json", Authorization: `Bearer ${token()}` },
      body: JSON.stringify(payload),
    });
    if (!response.ok) {
      alert(await apiError(response));
      return false;
    }
    await load();
    alert(message);
    return true;
  }

  async function createPromoter(event: FormEvent) {
    event.preventDefault();
    const ok = await post("/promoters", { ...promoterForm, eventTitle: eventTitle(promoterForm.eventId) }, "Promoter criado.");
    if (ok) setPromoterForm({ ...promoterForm, name: "", document: "", email: "", whatsapp: "", pixKey: "", notes: "" });
  }

  async function createCoupon(event: FormEvent) {
    event.preventDefault();
    const ok = await post("/promoters/coupons", { ...couponForm, code: code(couponForm.code), eventTitle: eventTitle(couponForm.eventId) }, "Cupom criado.");
    if (ok) setCouponForm({ ...couponForm, code: "" });
  }

  async function createLink(event: FormEvent) {
    event.preventDefault();
    const ok = await post("/promoters/links", { ...linkForm, eventTitle: eventTitle(linkForm.eventId) }, "Link criado.");
    if (ok) setLinkForm({ promoterId: "", eventId: "", label: "", slug: "", url: "" });
  }

  async function createSale(event: FormEvent) {
    event.preventDefault();
    const ok = await post("/promoters/sales/manual", { ...saleForm, eventTitle: eventTitle(saleForm.eventId) }, "Venda registrada.");
    if (ok) setSaleForm({ ...saleForm, orderId: "", customerName: "", grossAmount: "", discountAmount: "", netAmount: "" });
  }

  function patchPayment(id: string, patch: AnyItem) {
    setPaymentForms((current) => ({ ...current, [id]: { ...(current[id] || {}), ...patch } }));
  }

  function handleProof(id: string, file?: File | null) {
    if (!file) return;
    if (file.size > 4 * 1024 * 1024) {
      alert("Use um comprovante de até 4 MB.");
      return;
    }
    const reader = new FileReader();
    reader.onload = () => patchPayment(id, { paymentProofName: file.name, paymentProofDataUrl: String(reader.result || "") });
    reader.readAsDataURL(file);
  }

  async function markPaid(promoter: AnyItem) {
    const form = paymentForms[promoter.id] || {};
    if (!form.paymentProofDataUrl && !promoter.paymentProofDataUrl && !confirm("Marcar como pago sem comprovante?")) return;
    await post(`/promoters/${promoter.id}/commission/mark-paid`, form, "Comissão marcada como paga.");
  }

  function copy(text?: string | null) {
    if (!text) return;
    navigator.clipboard.writeText(text);
    alert("Copiado.");
