            <p className="text-[11px] font-black uppercase tracking-[0.22em] text-orange-600">Novo promoter</p>
            <h2 className="mt-2 text-2xl font-black text-slate-950">Cadastrar divulgador</h2>
            <div className="mt-6 space-y-3">
              <Field value={promoterForm.name} onChange={(e: any) => setPromoterForm({ ...promoterForm, name: e.target.value })} placeholder="Nome do promoter" />
              <Field value={promoterForm.document} onChange={(e: any) => setPromoterForm({ ...promoterForm, document: e.target.value })} placeholder="CPF/CNPJ" />
