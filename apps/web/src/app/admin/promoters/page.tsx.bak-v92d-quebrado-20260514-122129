                  <option value="GROSS_AMOUNT">Bruto</option>
                  <option value="AFTER_DISCOUNT">Após desconto</option>
                </Select>
              </div>
              <textarea value={promoterForm.notes} onChange={(e) => setPromoterForm({ ...promoterForm, notes: e.target.value })} rows={3} placeholder="Observações" className="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-semibold outline-none focus:border-orange-400" />
              <button className="w-full rounded-2xl bg-slate-950 px-5 py-4 text-sm font-black text-white">Criar promoter</button>
            </div>
          </form>

          <section className="grid gap-4">
            {promoters.map((promoter) => (
              <article key={promoter.id} className="rounded-[30px] border border-slate-200 bg-white p-6 shadow-sm">
                <div className="flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
                  <div>
                    <p className="text-[11px] font-black uppercase tracking-[0.22em] text-orange-600">{promoter.protocol}</p>
                    <h3 className="mt-2 text-2xl font-black text-slate-950">{promoter.name}</h3>
                    <p className="mt-1 text-sm font-semibold text-slate-500">{promoter.email || "Sem e-mail"} • {promoter.whatsapp || promoter.phone || "Sem telefone"}</p>
                    <p className="mt-1 text-sm font-semibold text-slate-500">Evento: {promoter.eventTitle || "Todos"} • Comissão: {promoter.commissionType === "PERCENT" ? `${Number(promoter.commissionValue || 0)}%` : money(promoter.commissionValue)}</p>
                  </div>
                  <div className="flex flex-wrap gap-2">
                    <button onClick={() => post(`/promoters/${promoter.id}/status`, { status: promoter.status === "ACTIVE" ? "INACTIVE" : "ACTIVE" }, "Status atualizado.")} className="rounded-2xl border border-slate-200 bg-white px-4 py-2 text-xs font-black text-slate-700">{promoter.status === "ACTIVE" ? "Desativar" : "Ativar"}</button>
                    <button onClick={() => { setCouponForm({ ...couponForm, promoterId: promoter.id, eventId: promoter.eventId || "" }); setTab("coupons"); }} className="rounded-2xl bg-orange-600 px-4 py-2 text-xs font-black text-white">Criar cupom</button>
                    <button onClick={() => { setLinkForm({ ...linkForm, promoterId: promoter.id, eventId: promoter.eventId || "" }); setTab("links"); }} className="rounded-2xl bg-slate-950 px-4 py-2 text-xs font-black text-white">Gerar link</button>
                  </div>
                </div>
                <div className="mt-5 grid gap-3 md:grid-cols-5">
                  <Metric label="Vendas" value={promoter.metrics?.paidSales || 0} />
                  <Metric label="Receita" value={money(promoter.metrics?.revenue || 0)} />
                  <Metric label="Comissão" value={money(promoter.metrics?.commission || 0)} />
                  <Metric label="Cupons" value={promoter.metrics?.coupons || 0} />
                  <Metric label="Links" value={promoter.metrics?.links || 0} />
                </div>
              </article>
            ))}
          </section>
        </section>
      )}

      {tab === "coupons" && (
        <section className="grid gap-6 xl:grid-cols-[430px_1fr]">
          <form onSubmit={createCoupon} className="rounded-[30px] border border-slate-200 bg-white p-6 shadow-sm">
            <p className="text-[11px] font-black uppercase tracking-[0.22em] text-orange-600">Novo cupom</p>
            <h2 className="mt-2 text-2xl font-black text-slate-950">Criar desconto</h2>
            <div className="mt-6 space-y-3">
              <Field value={couponForm.code} onChange={(e: any) => setCouponForm({ ...couponForm, code: code(e.target.value) })} placeholder="Código: JOAO10" />
              <Select value={couponForm.eventId} onChange={(e: any) => setCouponForm({ ...couponForm, eventId: e.target.value })}><option value="">Sem evento fixo</option>{events.map((event) => <option key={event.id} value={event.id}>{event.name || event.title}</option>)}</Select>
              <Select value={couponForm.promoterId} onChange={(e: any) => setCouponForm({ ...couponForm, promoterId: e.target.value })}><option value="">Sem promoter</option>{promoters.map((promoter) => <option key={promoter.id} value={promoter.id}>{promoter.name}</option>)}</Select>
              <div className="grid gap-3 sm:grid-cols-2">
                <Select value={couponForm.discountType} onChange={(e: any) => setCouponForm({ ...couponForm, discountType: e.target.value })}><option value="PERCENT">Porcentagem</option><option value="FIXED">Valor fixo</option><option value="FREE">Cortesia 100%</option></Select>
                <Field value={couponForm.discountValue} onChange={(e: any) => setCouponForm({ ...couponForm, discountValue: e.target.value })} placeholder="Valor" />
              </div>
              <div className="grid gap-3 sm:grid-cols-2">
                <Field value={couponForm.usageLimit} onChange={(e: any) => setCouponForm({ ...couponForm, usageLimit: e.target.value })} placeholder="Limite total" />
                <Field value={couponForm.perCpfLimit} onChange={(e: any) => setCouponForm({ ...couponForm, perCpfLimit: e.target.value })} placeholder="Limite por CPF" />
              </div>
              <Field value={couponForm.validChannels} onChange={(e: any) => setCouponForm({ ...couponForm, validChannels: e.target.value })} placeholder="Canais: online,admin,pdv" />
              <button className="w-full rounded-2xl bg-slate-950 px-5 py-4 text-sm font-black text-white">Criar cupom</button>
            </div>
          </form>
          <section className="grid gap-4">
            {coupons.map((coupon) => (
              <article key={coupon.id} className="rounded-[30px] border border-slate-200 bg-white p-6 shadow-sm">
                <div className="flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
                  <div>
                    <p className="text-[11px] font-black uppercase tracking-[0.22em] text-orange-600">Cupom</p>
                    <h3 className="mt-2 text-3xl font-black text-slate-950">{coupon.code}</h3>
                    <p className="mt-1 text-sm font-semibold text-slate-500">{coupon.discountType === "PERCENT" ? `${Number(coupon.discountValue)}%` : money(coupon.discountValue)} • Evento: {coupon.eventTitle || "Todos"}</p>
                    <p className="mt-1 text-sm font-semibold text-slate-500">Promoter: {coupon.promoter?.name || "Não vinculado"} • Uso: {coupon.usedCount}/{coupon.usageLimit || "∞"}</p>
                  </div>
                  <div className="flex flex-wrap gap-2">
                    <button onClick={() => copy(coupon.code)} className="rounded-2xl border border-slate-200 bg-white px-4 py-2 text-xs font-black text-slate-700">Copiar</button>
                    <button onClick={() => post(`/promoters/coupons/${coupon.id}/status`, { status: coupon.status === "ACTIVE" ? "INACTIVE" : "ACTIVE" }, "Status atualizado.")} className="rounded-2xl bg-slate-950 px-4 py-2 text-xs font-black text-white">{coupon.status === "ACTIVE" ? "Desativar" : "Ativar"}</button>
                  </div>
                </div>
              </article>
            ))}
          </section>
        </section>
      )}

      {tab === "links" && (
        <section className="grid gap-6 xl:grid-cols-[430px_1fr]">
          <form onSubmit={async (e) => { e.preventDefault(); const ok = await post("/promoters/links", { ...linkForm, eventTitle: eventTitle(linkForm.eventId) }, "Link criado."); if (ok) setLinkForm({ promoterId: "", eventId: "", label: "", slug: "", url: "" }); }} className="rounded-[30px] border border-slate-200 bg-white p-6 shadow-sm">
            <p className="text-[11px] font-black uppercase tracking-[0.22em] text-orange-600">Novo link</p>
            <h2 className="mt-2 text-2xl font-black text-slate-950">Gerar link rastreável</h2>
            <div className="mt-6 space-y-3">
              <Select value={linkForm.promoterId} onChange={(e: any) => setLinkForm({ ...linkForm, promoterId: e.target.value })}><option value="">Selecione promoter</option>{promoters.map((promoter) => <option key={promoter.id} value={promoter.id}>{promoter.name}</option>)}</Select>
              <Select value={linkForm.eventId} onChange={(e: any) => setLinkForm({ ...linkForm, eventId: e.target.value })}><option value="">Evento</option>{events.map((event) => <option key={event.id} value={event.id}>{event.name || event.title}</option>)}</Select>
