      {tab === "commissions" && (
        <section className="grid gap-4">
          {promoters.map((promoter) => {
            const form = paymentForms[promoter.id] || { paymentNotes: "", paymentProofName: "", paymentProofDataUrl: "" };
            return (
              <article key={promoter.id} className="rounded-[30px] border border-slate-200 bg-white p-6 shadow-sm">
                <div className="grid gap-5 lg:grid-cols-[1fr_420px]">
                  <div>
                    <p className="text-[11px] font-black uppercase tracking-[0.22em] text-orange-600">Comissão</p>
                    <h3 className="mt-2 text-2xl font-black text-slate-950">{promoter.name}</h3>
                    <p className="mt-1 text-sm font-semibold text-slate-500">Receita: {money(promoter.metrics?.revenue || 0)} • Comissão: {money(promoter.metrics?.commission || 0)}</p>
                    <div className="mt-5 grid gap-3 md:grid-cols-4">
                      <Metric label="Vendas" value={promoter.metrics?.paidSales || 0} />
                      <Metric label="Comissão" value={money(promoter.metrics?.commission || 0)} />
                      <Metric label="Status" value={promoter.paymentStatus === "PAID" ? "Pago" : "Pendente"} />
