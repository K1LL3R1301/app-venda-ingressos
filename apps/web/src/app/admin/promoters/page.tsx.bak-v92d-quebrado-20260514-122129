                  </div>
                  <div className="rounded-3xl border border-slate-200 bg-slate-50 p-5">
                    <textarea value={form.paymentNotes || ""} onChange={(e) => patchPayment(promoter.id, { paymentNotes: e.target.value })} rows={3} placeholder="Observação do pagamento" className="w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm font-semibold outline-none focus:border-orange-400" />
                    <input type="file" accept="image/*,.pdf" onChange={(e) => handleProof(promoter.id, e.target.files?.[0])} className="mt-3 w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm font-bold text-slate-600" />
                    {(form.paymentProofName || promoter.paymentProofName) ? <div className="mt-3 rounded-2xl bg-white p-3 text-xs font-bold text-slate-600">Comprovante: {form.paymentProofName || promoter.paymentProofName}</div> : null}
                    <button onClick={() => markPaid(promoter)} disabled={promoter.paymentStatus === "PAID"} className="mt-4 w-full rounded-2xl bg-slate-950 px-5 py-4 text-sm font-black text-white disabled:opacity-50">{promoter.paymentStatus === "PAID" ? "Comissão paga" : "Marcar comissão como paga"}</button>
                  </div>
                </div>
              </article>
            );
          })}
        </section>
      )}

      {tab === "sales" && (
        <section className="grid gap-6 xl:grid-cols-[430px_1fr]">
          <form onSubmit={async (e) => { e.preventDefault(); const ok = await post("/promoters/sales/manual", { ...saleForm, eventTitle: eventTitle(saleForm.eventId) }, "Venda registrada."); if (ok) setSaleForm({ ...saleForm, orderId: "", customerName: "", grossAmount: "", discountAmount: "", netAmount: "" }); }} className="rounded-[30px] border border-slate-200 bg-white p-6 shadow-sm">
            <p className="text-[11px] font-black uppercase tracking-[0.22em] text-orange-600">Venda manual</p>
            <h2 className="mt-2 text-2xl font-black text-slate-950">Simular/rastrear venda</h2>
            <div className="mt-6 space-y-3">
              <Select value={saleForm.eventId} onChange={(e: any) => setSaleForm({ ...saleForm, eventId: e.target.value })}><option value="">Evento</option>{events.map((event) => <option key={event.id} value={event.id}>{event.name || event.title}</option>)}</Select>
              <Select value={saleForm.promoterId} onChange={(e: any) => setSaleForm({ ...saleForm, promoterId: e.target.value })}><option value="">Promoter</option>{promoters.map((promoter) => <option key={promoter.id} value={promoter.id}>{promoter.name}</option>)}</Select>
              <Select value={saleForm.couponId} onChange={(e: any) => setSaleForm({ ...saleForm, couponId: e.target.value })}><option value="">Cupom</option>{coupons.map((coupon) => <option key={coupon.id} value={coupon.id}>{coupon.code}</option>)}</Select>
              <Select value={saleForm.linkId} onChange={(e: any) => setSaleForm({ ...saleForm, linkId: e.target.value })}><option value="">Link</option>{links.map((link) => <option key={link.id} value={link.id}>{link.label || link.slug}</option>)}</Select>
              <div className="grid gap-3 sm:grid-cols-3">
                <Field value={saleForm.grossAmount} onChange={(e: any) => setSaleForm({ ...saleForm, grossAmount: e.target.value })} placeholder="Valor bruto" />
                <Field value={saleForm.discountAmount} onChange={(e: any) => setSaleForm({ ...saleForm, discountAmount: e.target.value })} placeholder="Desconto" />
                <Field value={saleForm.netAmount} onChange={(e: any) => setSaleForm({ ...saleForm, netAmount: e.target.value })} placeholder="Valor líquido" />
              </div>
              <Field value={saleForm.orderId} onChange={(e: any) => setSaleForm({ ...saleForm, orderId: e.target.value })} placeholder="Pedido / referência" />
              <Field value={saleForm.customerName} onChange={(e: any) => setSaleForm({ ...saleForm, customerName: e.target.value })} placeholder="Cliente" />
              <button className="w-full rounded-2xl bg-slate-950 px-5 py-4 text-sm font-black text-white">Registrar venda</button>
            </div>
          </form>
          <section className="grid gap-4">
            {sales.map((sale) => (
              <article key={sale.id} className="rounded-[30px] border border-slate-200 bg-white p-6 shadow-sm">
                <div className="flex flex-col gap-3 md:flex-row md:items-start md:justify-between">
                  <div>
                    <p className="text-[11px] font-black uppercase tracking-[0.22em] text-orange-600">{sale.protocol}</p>
                    <h3 className="mt-2 text-xl font-black text-slate-950">{sale.customerName || sale.orderId || "Venda rastreada"}</h3>
                    <p className="mt-1 text-sm font-semibold text-slate-500">Promoter: {sale.promoter?.name || "-"} • Cupom: {sale.coupon?.code || "-"} • Link: {sale.link?.slug || "-"}</p>
                  </div>
                  <div className="text-right"><p className="text-2xl font-black text-slate-950">{money(sale.netAmount)}</p><p className="text-xs font-bold text-slate-500">Comissão: {money(sale.commissionAmount)}</p></div>
                </div>
              </article>
            ))}
          </section>
        </section>
      )}

      {tab === "reports" && (
        <section className="space-y-6">
          <div className="grid gap-4 md:grid-cols-4">
            <Metric label="Receita" value={money(reports.revenue || 0)} />
            <Metric label="Comissão" value={money(reports.commission || 0)} />
            <Metric label="Vendas pagas" value={reports.salesPaid || 0} />
            <Metric label="Links" value={reports.links || 0} />
          </div>
          <div className="grid gap-6 lg:grid-cols-2">
            <section className="rounded-[30px] border border-slate-200 bg-white p-6 shadow-sm">
              <p className="text-[11px] font-black uppercase tracking-[0.22em] text-orange-600">Ranking</p>
              <h2 className="mt-2 text-2xl font-black text-slate-950">Promoters por receita</h2>
              <div className="mt-5 space-y-3">
                {(reports.promoterRanking || []).map((item: AnyItem) => <div key={item.id} className="rounded-2xl border border-slate-200 bg-white p-4"><div className="flex justify-between gap-3"><p className="font-black text-slate-950">{item.name}</p><p className="font-black text-orange-600">{money(item.revenue)}</p></div><p className="mt-1 text-xs font-bold text-slate-500">{item.sales} vendas • comissão {money(item.commission)}</p></div>)}
              </div>
            </section>
            <section className="rounded-[30px] border border-slate-200 bg-white p-6 shadow-sm">
              <p className="text-[11px] font-black uppercase tracking-[0.22em] text-orange-600">Cupons</p>
              <h2 className="mt-2 text-2xl font-black text-slate-950">Cupons mais usados</h2>
              <div className="mt-5 space-y-3">
                {(reports.couponRanking || []).map((item: AnyItem) => <div key={item.id} className="rounded-2xl border border-slate-200 bg-white p-4"><div className="flex justify-between gap-3"><p className="font-black text-slate-950">{item.code}</p><p className="font-black text-orange-600">{money(item.revenue)}</p></div><p className="mt-1 text-xs font-bold text-slate-500">{item.sales} vendas • {item.usedCount} usos</p></div>)}
              </div>
            </section>
          </div>
        </section>
      )}

      {tab === "settings" && (
        <section className="space-y-6">
          <section className="rounded-[30px] border border-slate-200 bg-white p-6 shadow-sm">
            <div className="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
              <div>
                <p className="text-[11px] font-black uppercase tracking-[0.22em] text-orange-600">
                  Central de regras comerciais
                </p>
                <h2 className="mt-2 text-3xl font-black text-slate-950">
                  O motor de promoters e cupons está aqui.
                </h2>
                <p className="mt-3 max-w-3xl text-sm font-semibold leading-7 text-slate-600">
                  Esta tela agora serve para conferir o que já está ativo, testar regras comerciais e orientar o fluxo correto
                  entre checkout, cupom, link rastreável, pedido pago, comissão e pagamento ao promoter.
                </p>
              </div>

              <div className="grid min-w-[280px] gap-3 rounded-[26px] border border-slate-200 bg-slate-50 p-4">
                <div className="flex items-center justify-between gap-3">
                  <span className="text-xs font-black uppercase tracking-[0.18em] text-slate-400">
                    Receita rastreada
                  </span>
                  <span className="text-lg font-black text-slate-950">{money(overview.trackedRevenue || 0)}</span>
                </div>
                <div className="flex items-center justify-between gap-3">
                  <span className="text-xs font-black uppercase tracking-[0.18em] text-slate-400">
                    Comissão pendente
                  </span>
                  <span className="text-lg font-black text-orange-600">{money(overview.commissionPending || 0)}</span>
                </div>
                <div className="flex items-center justify-between gap-3">
                  <span className="text-xs font-black uppercase tracking-[0.18em] text-slate-400">
                    Cupons ativos
                  </span>
                  <span className="text-lg font-black text-slate-950">{overview.activeCoupons || 0}</span>
                </div>
              </div>
            </div>
          </section>

          <section className="grid gap-4 xl:grid-cols-4">
            {[
              {
                label: "Cupom no checkout",
                status: "Ativo",
                detail: "O checkout envia couponCode no pedido.",
                tone: "emerald",
              },
              {
                label: "Ref de promoter",
                status: "Ativo",
                detail: "Links com ?ref= podem ser rastreados.",
                tone: "emerald",
              },
              {
                label: "Comissão automática",
                status: "Ligada",
                detail: "Pedido pago pode gerar venda e comissão.",
                tone: "emerald",
              },
              {
                label: "Exportação fiscal",
                status: "Próximo",
                detail: "Ainda falta exportar CSV/PDF/Excel.",
                tone: "amber",
              },
            ].map((item) => (
              <div key={item.label} className="rounded-[26px] border border-slate-200 bg-white p-5 shadow-sm">
                <p className="text-[10px] font-black uppercase tracking-[0.22em] text-slate-400">{item.label}</p>
                <p
                  className={`mt-3 inline-flex rounded-full px-3 py-1 text-xs font-black ${
                    item.tone === "emerald"
                      ? "bg-emerald-50 text-emerald-700"
                      : "bg-amber-50 text-amber-700"
                  }`}
                >
                  {item.status}
                </p>
                <p className="mt-3 text-sm font-semibold leading-6 text-slate-600">{item.detail}</p>
              </div>
            ))}
          </section>

          <section className="grid gap-6 lg:grid-cols-[1fr_0.9fr]">
            <div className="rounded-[30px] border border-slate-200 bg-white p-6 shadow-sm">
              <p className="text-[11px] font-black uppercase tracking-[0.22em] text-orange-600">
                Regras que o sistema deve cumprir
              </p>
              <h3 className="mt-2 text-2xl font-black text-slate-950">Checklist comercial</h3>

              <div className="mt-6 grid gap-3">
                {[
                  {
                    title: "Comissão somente sobre pedido pago",
                    desc: "Venda pendente não entra no valor a pagar ao promoter.",
                    active: true,
                  },
                  {
                    title: "Cancelado ou estornado zera comissão",
                    desc: "A venda comercial pode ser sincronizada como CANCELED.",
                    active: true,
                  },
                  {
                    title: "Cupom não acumula com outro cupom",
                    desc: "Cada pedido deve carregar apenas um couponCode.",
                    active: true,
                  },
                  {
                    title: "Limite total e limite por CPF",
                    desc: "O cupom valida usedCount, usageLimit e perCpfLimit.",
                    active: true,
                  },
                  {
                    title: "Promoter com cupom e link",
                    desc: "Cupom tem prioridade sobre ref quando os dois existem.",
                    active: true,
                  },
                  {
                    title: "Pagamento manual com comprovante",
                    desc: "Admin paga por fora e anexa comprovante na aba Comissões.",
                    active: true,
                  },
                  {
                    title: "Exportação para conferência financeira",
                    desc: "Próxima melhoria: baixar CSV, Excel e PDF.",
                    active: false,
                  },
                ].map((rule) => (
                  <div
                    key={rule.title}
                    className="flex gap-4 rounded-2xl border border-slate-200 bg-slate-50 p-4"
                  >
                    <div
                      className={`mt-1 flex h-7 w-7 shrink-0 items-center justify-center rounded-full text-xs font-black ${
                        rule.active ? "bg-emerald-600 text-white" : "bg-amber-500 text-white"
                      }`}
                    >
                      {rule.active ? "✓" : "!"}
                    </div>
                    <div>
                      <p className="font-black text-slate-950">{rule.title}</p>
                      <p className="mt-1 text-sm font-semibold leading-6 text-slate-600">{rule.desc}</p>
                    </div>
                  </div>
                ))}
              </div>
            </div>

            <div className="space-y-6">
              <section className="rounded-[30px] border border-slate-200 bg-white p-6 shadow-sm">
                <p className="text-[11px] font-black uppercase tracking-[0.22em] text-orange-600">
                  Fluxo correto
                </p>
                <h3 className="mt-2 text-2xl font-black text-slate-950">Como testar do jeito certo</h3>

                <div className="mt-5 space-y-3">
                  {[
                    "Criar promoter.",
                    "Criar cupom vinculado ao promoter.",
                    "Gerar link/ref do promoter.",
                    "Entrar no checkout real do evento.",
                    "Aplicar o cupom no resumo da compra.",
                    "Criar pedido e confirmar pagamento.",
                    "Voltar em Vendas/Comissões e conferir comissão.",
                  ].map((step, index) => (
                    <div key={step} className="flex gap-3 rounded-2xl bg-slate-50 p-3">
                      <span className="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-slate-950 text-xs font-black text-white">
                        {index + 1}
                      </span>
                      <p className="text-sm font-bold leading-6 text-slate-700">{step}</p>
                    </div>
                  ))}
                </div>
              </section>

              <section className="rounded-[30px] border border-orange-200 bg-orange-50 p-6 shadow-sm">
                <p className="text-[11px] font-black uppercase tracking-[0.22em] text-orange-700">
                  Próxima melhoria recomendada
                </p>
                <h3 className="mt-2 text-2xl font-black text-slate-950">Exportação financeira</h3>
                <p className="mt-3 text-sm font-semibold leading-7 text-slate-700">
                  O próximo passo útil desta aba é criar botões para exportar relatórios de promoters, cupons,
                  vendas e comissões em CSV/Excel/PDF para conferência contábil.
                </p>
                <div className="mt-5 grid gap-3 sm:grid-cols-3">
                  {["CSV", "Excel", "PDF"].map((format) => (
                    <button
                      key={format}
                      type="button"
                      onClick={() => alert(`Exportação ${format} será ligada na próxima versão.`)}
                      className="rounded-2xl bg-white px-4 py-3 text-sm font-black text-slate-950 shadow-sm"
                    >
                      Exportar {format}
                    </button>
                  ))}
                </div>
              </section>
            </div>
          </section>
        </section>
      )}
    </main>
  );
}
