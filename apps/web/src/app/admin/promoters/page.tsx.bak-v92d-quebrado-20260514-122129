                </Select>
                <Field value={promoterForm.commissionValue} onChange={(e: any) => setPromoterForm({ ...promoterForm, commissionValue: e.target.value })} placeholder="Valor" />
                <Select value={promoterForm.commissionBase} onChange={(e: any) => setPromoterForm({ ...promoterForm, commissionBase: e.target.value })}>
