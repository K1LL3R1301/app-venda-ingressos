  const tabs = [
    ["promoters", "Promoters"],
    ["coupons", "Cupons"],
    ["links", "Links"],
    ["commissions", "Comissões"],
    ["sales", "Vendas"],
    ["reports", "Relatórios"],
    ["settings", "Configurações"],
