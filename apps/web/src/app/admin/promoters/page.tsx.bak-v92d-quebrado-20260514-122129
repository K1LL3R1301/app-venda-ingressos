            <h1 className="mt-4 max-w-4xl text-4xl font-black leading-tight md:text-5xl">Promoters, cupons, links e comissões.</h1>
            <p className="mt-4 max-w-3xl text-sm font-semibold leading-7 text-white/80">Crie divulgadores, cupons, links rastreáveis, acompanhe vendas e controle pagamento de comissão.</p>
          </div>
          <div className="grid gap-3 sm:grid-cols-2">
            <div className="rounded-3xl border border-white/10 bg-white/10 p-5"><p className="text-[10px] font-black uppercase tracking-[0.16em] text-white/55">Receita</p><p className="mt-3 text-3xl font-black">{money(overview.trackedRevenue || 0)}</p></div>
            <div className="rounded-3xl border border-white/10 bg-white/10 p-5"><p className="text-[10px] font-black uppercase tracking-[0.16em] text-white/55">Comissão pendente</p><p className="mt-3 text-3xl font-black">{money(overview.commissionPending || 0)}</p></div>
