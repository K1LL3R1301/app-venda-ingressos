          </form>
          <section className="grid gap-4">
            {links.map((link) => (
              <article key={link.id} className="rounded-[30px] border border-slate-200 bg-white p-6 shadow-sm">
                <div className="flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
                  <div>
                    <p className="text-[11px] font-black uppercase tracking-[0.22em] text-orange-600">{link.label || "Link rastreável"}</p>
                    <h3 className="mt-2 break-all text-xl font-black text-slate-950">{link.url}</h3>
                    <p className="mt-1 text-sm font-semibold text-slate-500">Promoter: {link.promoter?.name || "-"} • Slug: {link.slug}</p>
                  </div>
                  <button onClick={() => copy(link.url || link.slug)} className="rounded-2xl bg-slate-950 px-4 py-2 text-xs font-black text-white">Copiar</button>
                </div>
                <div className="mt-5 grid gap-3 md:grid-cols-5">
                  <Metric label="Cliques" value={link.clicks} />
                  <Metric label="Pedidos pagos" value={link.ordersPaid} />
                  <Metric label="Receita" value={money(link.revenue)} />
                  <Metric label="Comissão" value={money(link.commission)} />
                  <Metric label="Status" value={link.status} />
                </div>
