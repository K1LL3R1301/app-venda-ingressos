"use client";

import { useEffect, useState } from "react";
import { usePathname, useRouter } from "next/navigation";
import CustomerHeader, {
  type CustomerHeaderUser,
} from "../../components/customer/CustomerHeader";
import { getStoredAuthToken, getStoredAuthUser } from "../../lib/auth-client";

export default function CustomerLayout({
  children,
}: {
  children: React.ReactNode;
}) {
  const router = useRouter();
  const pathname = usePathname();
  const [user, setUser] = useState<CustomerHeaderUser | null>(null);
  const [checkingAuth, setCheckingAuth] = useState(true);

  useEffect(() => {
    const token = getStoredAuthToken();

    if (!token) {
      router.replace("/login");
      return;
    }

    setUser(getStoredAuthUser<CustomerHeaderUser>());
    setCheckingAuth(false);
  }, [pathname, router]);

  function getActiveNav(): "dashboard" | "orders" | "wallet" | "support" {
    if (pathname.startsWith("/orders")) return "orders";
    if (pathname.startsWith("/wallet")) return "wallet";
    if (pathname.startsWith("/support")) return "support";
    return "dashboard";
  }

  const isDashboard = pathname.startsWith("/dashboard");
  const shouldShowSearch = pathname.startsWith("/events") || isDashboard;

  if (checkingAuth) {
    return (
      <main className="min-h-screen bg-white px-4 py-10 text-neutral-900">
        <div className="mx-auto max-w-[1180px] rounded-[28px] border border-neutral-200 bg-white p-8 shadow-sm">
          <p className="text-sm font-bold text-neutral-600">
            Verificando acesso...
          </p>
        </div>
      </main>
    );
  }

  return (
    <div className="min-h-screen bg-white text-neutral-900">
      <CustomerHeader
        user={user}
        activeNav={getActiveNav()}
        showSearch={shouldShowSearch}
        searchPlaceholder="Buscar experiencias"
        searchAppearsOnScroll={isDashboard}
        showLocationButton={isDashboard}
      />
      {children}
    </div>
  );
}