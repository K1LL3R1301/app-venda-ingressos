// v82 support page with operator invitations.
"use client";

import Link from "next/link";
import { useEffect, useState } from "react";

type Invitation = {
  id: string;
  protocol: string;
  status: string;
  invitationMessage?: string | null;
  adminName?: string | null;
  adminEmail?: string | null;
  eventTitle?: string | null;
  eventDate?: string | null;
  invitedAt?: string | null;
  event?: {
    id: string;
    name: string;
    eventDate?: string | null;
  } | null;
};

const API_BASE_URL =
  process.env.NEXT_PUBLIC_API_URL?.replace(/\/$/, "") || "http://localhost:3001/v1";

function token() {
  return typeof window === "undefined" ? "" : localStorage.getItem("token") || "";
}

function formatDate(value?: string | null) {
  if (!value) return "-";
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return value;
  return date.toLocaleString("pt-BR", {
    day: "2-digit",
    month: "short",
    year: "numeric",
    hour: "2-digit",
    minute: "2-digit",
  });
}

function statusLabel(status: string) {
  const labels: Record<string, string> = {
    INVITED: "Aguardando sua resposta",
    ACCEPTED: "Você aceitou",
    ACTIVE: "Você já foi atribuído a um evento",
    DECLINED: "Você recusou",
  };

  return labels[status.toUpperCase()] || status;
}

async function parseApiError(response: Response) {
  const text = await response.text().catch(() => "");

  try {
    const json = JSON.parse(text);

    if (Array.isArray(json?.message)) return json.message.join("\n");
    if (typeof json?.message === "string") return json.message;
    if (typeof json?.error === "string") return json.error;
  } catch {}

  if (text && text.length < 300) return text;

  return `Erro ${response.status}: não foi possível responder.`;
}

export default function CustomerSupportPage() {
  const [items, setItems] = useState<Invitation[]>([]);
  const [loading, setLoading] = useState(true);
  const [savingId, setSavingId] = useState<string | null>(null);

  async function load() {
    const auth = token();

    if (!auth || auth === "undefined") {
      window.location.href = "/login";
      return;
    }

    setLoading(true);

    try {
      const response = await fetch(`${API_BASE_URL}/operator-assignments/me/invitations`, {
        headers: {
          Authorization: `Bearer ${auth}`,
        },
      });

      const result = await response.json().catch(() => []);

      setItems(Array.isArray(result) ? result : []);
    } finally {
      setLoading(false);
    }
  }

  useEffect(() => {
    load();
  }, []);

  async function respond(id: string, action: "accept" | "decline") {
    const auth = token();

    setSavingId(id);

    try {
      const response = await fetch(`${API_BASE_URL}/operator-assignments/${id}/${action}`, {
        method: "POST",
        headers: {
          Authorization: `Bearer ${auth}`,
        },
      });

      if (!response.ok) {
        alert(await parseApiError(response));
        return;
      }

      await load();
      alert(action === "accept" ? "Convite aceito." : "Convite recusado.");
    } finally {
      setSavingId(null);
    }
  }

  const pending = items.filter((item) => item.status === "INVITED");
  const answered = items.filter((item) => item.status !== "INVITED");

  return (
    <main className="mx-auto max-w-[1180px] space-y-6 px-4 py-6">
      <section
        className="relative overflow-hidden rounded-[34px] text-white shadow-sm"
        style={{
          background:
            "linear-gradient(135deg, #ff6900 0%, #7c2d12 18%, #111827 50%, #020617 100%)",
        }}
      >
        <div className="absolute inset-0 bg-black/25" />
        <div className="relative z-10 p-7 lg:p-9">
          <p className="text-[11px] font-black uppercase tracking-[0.34em] text-orange-200">
            Central de suporte
          </p>
          <h1 className="mt-4 max-w-4xl text-4xl font-black leading-tight md:text-5xl">
            Suporte e convites.
          </h1>
          <p className="mt-4 max-w-3xl text-sm font-semibold leading-7 text-white/80">
            Aqui ficam seus chamados e também convites operacionais enviados por administradores.
          </p>
        </div>
      </section>

      <section className="rounded-[30px] border border-slate-200 bg-white p-6 shadow-sm">
        <div className="flex flex-col gap-3 md:flex-row md:items-start md:justify-between">
          <div>
            <p className="text-[11px] font-black uppercase tracking-[0.22em] text-orange-600">
              Solicitações recebidas
            </p>
            <h2 className="mt-2 text-2xl font-black text-slate-950">
              Convites para virar operador
            </h2>
            <p className="mt-2 text-sm text-slate-500">
              Quando um administrador convidar você, responda aqui com Sim ou Não.
            </p>
          </div>

          <Link
            href="/dashboard"
            className="rounded-2xl border border-slate-200 bg-white px-5 py-3 text-sm font-black text-slate-700 transition hover:bg-slate-50"
          >
            Voltar
          </Link>
        </div>

        <div className="mt-6 grid gap-4">
          {loading ? (
            <div className="rounded-3xl bg-slate-50 p-6 text-sm font-bold text-slate-500">
              Carregando suporte...
            </div>
          ) : pending.length === 0 ? (
            <div className="rounded-3xl bg-slate-50 p-8 text-center">
              <p className="font-black text-slate-950">Nenhum convite pendente.</p>
              <p className="mt-2 text-sm text-slate-500">
                Quando um administrador enviar um convite, ele aparecerá aqui.
              </p>
            </div>
          ) : (
            pending.map((item) => (
              <article
                key={item.id}
                className="rounded-[26px] border border-orange-200 bg-orange-50 p-5 shadow-sm"
              >
                <div className="flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
                  <div>
                    <p className="text-[11px] font-black uppercase tracking-[0.18em] text-orange-700">
                      Convite operacional
                    </p>
                    <h3 className="mt-2 text-xl font-black text-slate-950">
                      Você aceita virar operador?
                    </h3>
                    <p className="mt-2 text-sm leading-6 text-slate-700">
                      {item.invitationMessage ||
                        "Você foi convidado para atuar como operador na plataforma Astro Ingressos."}
                    </p>
                    <p className="mt-2 text-xs font-bold text-slate-500">
                      Enviado por: {item.adminName || item.adminEmail || "Administrador"} •{" "}
                      {formatDate(item.invitedAt)}
                    </p>
                    <p className="mt-1 text-xs font-bold text-slate-500">
                      Protocolo: {item.protocol}
                    </p>
                  </div>

                  <div className="flex shrink-0 flex-col gap-2 sm:flex-row md:flex-col">
                    <button
                      type="button"
                      onClick={() => respond(item.id, "accept")}
                      disabled={savingId === item.id}
                      className="rounded-2xl bg-slate-950 px-6 py-3 text-sm font-black text-white transition hover:bg-slate-800 disabled:opacity-60"
                    >
                      Sim
                    </button>
                    <button
                      type="button"
                      onClick={() => respond(item.id, "decline")}
                      disabled={savingId === item.id}
                      className="rounded-2xl border border-slate-200 bg-white px-6 py-3 text-sm font-black text-slate-700 transition hover:bg-slate-50 disabled:opacity-60"
                    >
                      Não
                    </button>
                  </div>
                </div>
              </article>
            ))
          )}
        </div>
      </section>

      <section className="rounded-[30px] border border-slate-200 bg-white p-6 shadow-sm">
        <p className="text-[11px] font-black uppercase tracking-[0.22em] text-orange-600">
          Histórico
        </p>
        <h2 className="mt-2 text-2xl font-black text-slate-950">
          Convites respondidos
        </h2>

        <div className="mt-5 grid gap-3">
          {answered.length === 0 ? (
            <p className="rounded-2xl bg-slate-50 p-5 text-sm font-semibold text-slate-500">
              Nenhum convite respondido.
            </p>
          ) : (
            answered.map((item) => (
              <div
                key={item.id}
                className="flex flex-col gap-2 rounded-2xl border border-slate-200 bg-slate-50 p-4 md:flex-row md:items-center md:justify-between"
              >
                <div>
                  <p className="font-black text-slate-950">{statusLabel(item.status)}</p>
                  <p className="text-xs font-semibold text-slate-500">
                    {item.event?.name || item.eventTitle || "Evento ainda não atribuído"} •{" "}
                    {formatDate(item.event?.eventDate || item.eventDate)}
                  </p>
                </div>
                <div className="text-xs font-black text-slate-500">{item.protocol}</div>
              </div>
            ))
          )}
        </div>
      </section>

      <section className="rounded-[30px] border border-slate-200 bg-white p-6 shadow-sm">
        <p className="text-[11px] font-black uppercase tracking-[0.22em] text-orange-600">
          Chamados
        </p>
        <h2 className="mt-2 text-2xl font-black text-slate-950">Suporte normal</h2>
        <div className="mt-5 rounded-3xl bg-slate-50 p-8 text-center">
          <p className="font-black text-slate-950">Nenhum chat aberto.</p>
          <p className="mt-2 text-sm text-slate-500">
            Quando a API de chamados estiver conectada, seus atendimentos aparecem nesta área.
          </p>
        </div>
      </section>
    </main>
  );
}
