$ErrorActionPreference = "Stop"

$ProjectRoot = Split-Path -Parent $MyInvocation.MyCommand.Path
$WebRoot = Join-Path $ProjectRoot "apps\web"
$TestsDir = Join-Path $WebRoot "tests"
$ReportDir = Join-Path $WebRoot "test-results\reports"
$Stamp = Get-Date -Format "yyyyMMdd-HHmmss"
$ReportPath = Join-Path $ReportDir "site-visual-report-$Stamp.txt"
$SummaryPath = Join-Path $ReportDir "site-visual-summary-$Stamp.txt"

if (!(Test-Path -LiteralPath $ReportDir)) {
  New-Item -ItemType Directory -Force -Path $ReportDir | Out-Null
}

$TranscriptStarted = $false
$TestExitCode = 0
$VisualSpecs = @()

try {
  Start-Transcript -Path $ReportPath -Force | Out-Null
  $TranscriptStarted = $true

  Write-Host "[INFO] Projeto: $ProjectRoot"
  Write-Host "[INFO] Rodando testes visuais do site inteiro"
  Write-Host "[INFO] Relatorio completo sera salvo em:"
  Write-Host "       $ReportPath"
  Write-Host ""

  Set-Location $WebRoot

  $VisualSpecs = Get-ChildItem -Path $TestsDir -Filter "*.visual.spec.ts" -File -ErrorAction SilentlyContinue |
    Sort-Object FullName |
    ForEach-Object {
      $relative = $_.FullName.Substring($WebRoot.Length + 1)
      $relative.Replace("\", "/")
    }

  if (!$VisualSpecs -or $VisualSpecs.Count -eq 0) {
    Write-Host "[ERRO] Nenhum arquivo *.visual.spec.ts encontrado em:" -ForegroundColor Red
    Write-Host "       $TestsDir" -ForegroundColor Red
    Write-Host ""
    Write-Host "Rode novamente:"
    Write-Host "powershell -ExecutionPolicy Bypass -File .\create-site-wide-visual-tests.ps1"
    $TestExitCode = 1
    return
  }

  Write-Host "[INFO] Arquivos de teste visual encontrados:"
  foreach ($Spec in $VisualSpecs) {
    Write-Host " - $Spec"
  }

  if (!(Test-Path -LiteralPath (Join-Path $WebRoot "node_modules\@playwright\test"))) {
    Write-Host "[INFO] Instalando @playwright/test..."
    npm install -D @playwright/test
    if ($LASTEXITCODE -ne 0) {
      $TestExitCode = $LASTEXITCODE
      Write-Host "[ERRO] Falha ao instalar @playwright/test."
      return
    }
  } else {
    Write-Host "[OK] @playwright/test ja instalado."
  }

  Write-Host "[INFO] Conferindo navegador Chromium do Playwright..."
  npx playwright install chromium
  if ($LASTEXITCODE -ne 0) {
    $TestExitCode = $LASTEXITCODE
    Write-Host "[ERRO] Falha ao instalar/conferir navegador Chromium do Playwright."
    return
  }

  Write-Host "[INFO] Executando suite visual completa em modo headed..."
  npx playwright test $VisualSpecs --headed --project=chromium
  $TestExitCode = $LASTEXITCODE

  Write-Host ""
  if ($TestExitCode -eq 0) {
    Write-Host "[OK] Testes visuais do site finalizados sem falhas."
  } else {
    Write-Host "[ERRO] Testes visuais do site falharam com exit code $TestExitCode."
  }

  Write-Host ""
  Write-Host "Screenshots salvos em:"
  Write-Host "  $WebRoot\test-results"
  Write-Host ""
  Write-Host "Relatorio HTML:"
  Write-Host "  cd `"$WebRoot`""
  Write-Host "  npx playwright show-report"
} finally {
  if ($TranscriptStarted) {
    try {
      Stop-Transcript | Out-Null
    } catch {
      Write-Host "[AVISO] Nao consegui encerrar transcript: $($_.Exception.Message)" -ForegroundColor Yellow
    }
  }

  $Status = if ($TestExitCode -eq 0) { "PASSOU" } else { "FALHOU" }
  $SpecsText = if ($VisualSpecs -and $VisualSpecs.Count -gt 0) { ($VisualSpecs -join "`r`n - ") } else { "Nenhum spec encontrado" }

  $Summary = @"
RELATORIO RESUMIDO - TESTES VISUAIS DO SITE
===========================================

Status final: $Status
Exit code: $TestExitCode
Data/hora: $(Get-Date -Format "dd/MM/yyyy HH:mm:ss")

Projeto:
$ProjectRoot

Web:
$WebRoot

Arquivos testados:
 - $SpecsText

Relatorio completo do terminal:
$ReportPath

Prints, videos e traces:
$WebRoot\test-results

Relatorio HTML do Playwright:
cd "$WebRoot"
npx playwright show-report

Observacao:
O arquivo site-visual-report-*.txt contem o log completo que antes cortava no terminal.
"@

  Write-Utf8NoBom -Path $SummaryPath -Content $Summary

  Write-Host ""
  Write-Host "[INFO] Relatorio completo salvo em:"
  Write-Host "       $ReportPath"
  Write-Host "[INFO] Resumo salvo em:"
  Write-Host "       $SummaryPath"

  try {
    Start-Process notepad.exe $ReportPath
  } catch {
    Write-Host "[AVISO] Nao consegui abrir o bloco de notas automaticamente." -ForegroundColor Yellow
  }
}

if ($TestExitCode -ne 0) {
  throw "Testes visuais do site falharam. Relatorio completo: $ReportPath"
}